{
  // Comprobación de tipos de las capas de servicios y repositorios (npm run typecheck).
  // Se comprueban los archivos con // @ts-check; los tipos comunes están en src/services/types.d.ts.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/services/**/*.js", "src/services/**/*.d.ts", "src/repos/**/*.js"],
  "exclude": ["src/services/context.js"]
}
