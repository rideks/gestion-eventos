{
  "name": "gestion-eventos",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:demo": "wrangler d1 execute DB --local --file scripts/demo.sql",
    "invite": "node scripts/invite.mjs",
    "deploy": "astro build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm test && npm run typecheck"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^7.3.8",
    "pdf-lib": "1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.150.0"
  }
}
