{
  "name": "gestion-eventos",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:demo": "wrangler d1 execute DB --local --file scripts/demo.sql",
    "invite": "node scripts/invite.mjs",
    "deploy": "astro build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^7.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
