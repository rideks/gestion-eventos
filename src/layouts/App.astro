---
// Plantilla de la aplicación. Misma estructura que el panel de club-futsal:
// menú lateral en el ordenador y barra inferior para el pulgar en el móvil.
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '../styles/app.css';
import { env } from 'cloudflare:workers';
import Icon from '../components/Icon.astro';
import { navCounts } from '../lib/data.js';
import { today } from '../lib/dates.js';
import { can, FLASH } from '../lib/app.js';

// origin: las bandejas (Inicio, Pagos, Cobros, Expedientes, búsqueda) se recuerdan con este nombre para
// que dentro de un expediente salga «Volver a …» con la bandeja de la que se vino (y sus filtros)
// fieldErrors: los errores de cada campo ({ number: 'Nº de factura: es obligatorio' }): salen debajo del campo
const { title = 'Inicio', section = '', error = null, notice = null, wide = false, origin = null, fieldErrors = null } = Astro.props;
const fieldErrorsJson = fieldErrors && Object.keys(fieldErrors).length ? JSON.stringify(fieldErrors) : undefined;
const user = Astro.locals.user;
const company = env.COMPANY_NAME || 'Seven Worlds';
const work = can(user, 'expedientes');
// Ya pedidos en el middleware (en paralelo con la página); si no, aquí. Sin expedientes no hay contadores.
const counts = work ? ((await Astro.locals.counts) ?? await navCounts(env.DB, today())) : {};
const canOpen = can(user, 'expediente.open');
const reviewer = can(user, 'supplier.review');
const toReview = reviewer ? counts.to_review : 0;

const ok = FLASH[Astro.url.searchParams.get('ok') ?? ''];
const warn = Astro.url.searchParams.get('aviso') === 'permiso' ? 'No tienes permiso para eso. Si lo necesitas, pídeselo a quien gestiona los usuarios.' : null;

const nav = [
  ...(work ? [{ key: 'inicio', href: '/', label: 'Inicio', icon: 'house' }] : []),
  ...(work ? [{ key: 'expedientes', href: '/expedientes', label: 'Expedientes', icon: 'folder', badge: canOpen ? counts.requests : 0, tone: 'warn' }] : []),
  ...(can(user, 'pagos') ? [{ key: 'pagos', href: '/pagos', label: 'Pagos', icon: 'arrow-up-right', badge: counts.urgent, tone: 'danger' }] : []),
  ...(can(user, 'cobros') ? [{ key: 'cobros', href: '/cobros', label: 'Cobros', icon: 'arrow-down-left', badge: counts.to_issue, tone: 'warn' }] : []),
  ...(can(user, 'clientes') ? [{ key: 'clientes', href: '/clientes', label: 'Clientes', icon: 'building' }] : []),
  ...(can(user, 'viajes') ? [{ key: 'viajes', href: '/viajes', label: 'Business Travel', icon: 'plane' }] : []),
  ...(can(user, 'proveedores') ? [{ key: 'proveedores', href: '/proveedores', label: 'Proveedores', icon: 'briefcase', badge: can(user, 'contratos') ? counts.contracts_due : 0, tone: 'warn' }] : []),
  ...(work ? [{ key: 'nuevo', href: '/expedientes/nuevo', label: 'Nueva solicitud', icon: 'folder-plus', sep: true }] : []),
  ...(can(user, 'users') ? [{ key: 'usuarios', href: '/usuarios', label: 'Usuarios y permisos', icon: 'user-plus', sep: !work }] : []),
  ...(can(user, 'settings') ? [{ key: 'ajustes', href: '/ajustes', label: 'Ajustes', icon: 'settings' }] : []),
  { key: 'cuenta', href: '/cuenta', label: 'Mi cuenta', icon: 'user-round' },
];
const MAIN = ['inicio', 'expedientes', 'pagos', 'cobros'];
const tabs = nav.filter((n) => MAIN.includes(n.key));
const more = nav.filter((n) => !MAIN.includes(n.key));
const roleLabel = user?.role_name ?? '';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · {company}</title>
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body data-origin={origin ?? undefined} data-field-errors={fieldErrorsJson}>
    <header class="a-header">
      <a class="a-brand" href="/">
        <img src="/brand/logo.png" alt={`${company} · Events & Congresses`} width="105" height="50" />
        <span class="app-name">Gestión<br />de eventos</span>
      </a>
      <span class="spacer"></span>
      {work && (<>
        <form class="a-search" method="get" action="/buscar" role="search">
          <label class="visually-hidden" for="a-search-q">Buscar en todo</label>
          <Icon name="search" size={16} />
          <input id="a-search-q" name="q" type="search" placeholder="Buscar: nº, cliente, proveedor, factura…" autocomplete="off" />
        </form>
        <a class="a-search-btn" href="/buscar" aria-label="Buscar" title="Buscar"><Icon name="search" size={22} /></a>
      </>)}
      {user && <span class="a-user">{user.name} · {roleLabel}</span>}
      {reviewer && (
        <a class:list={['bell', { 'has-news': toReview > 0 }]} href="/pagos?ver=revisar"
          aria-label={toReview ? `${toReview} ${toReview === 1 ? 'factura nueva' : 'facturas nuevas'} por revisar` : 'Facturas por revisar'}
          title={toReview ? `${toReview} ${toReview === 1 ? 'factura nueva' : 'facturas nuevas'} por revisar` : 'No hay facturas por revisar'}>
          <Icon name="bell" size={22} />
          {toReview > 0 && <span class="bell-count">{toReview}</span>}
        </a>
      )}
    </header>

    <div class="a-shell">
      <nav class="a-side" aria-label="Secciones">
        {nav.map((n) => (
          <>
            {n.sep && <hr />}
            <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>
              <Icon name={n.icon} /> {n.label}
              {n.badge > 0 && <span class:list={['badge-count', `is-${n.tone}`]}>{n.badge}</span>}
            </a>
          </>
        ))}
        <form method="post" action="/salir">
          <button class="btn btn-ghost btn-sm btn-block" type="submit"><Icon name="log-out" size={16} /> Salir</button>
        </form>
      </nav>

      <main class:list={['a-main', { 'is-wide': wide }]}>
        {ok && <p class="flash flash-ok" role="status"><Icon name="check" /> {ok}</p>}
        {(warn || notice) && <p class="flash flash-warn" role="status"><Icon name="info" /> {warn || notice}</p>}
        {error && <p class="flash flash-error" role="alert"><Icon name="circle-alert" /> {error}</p>}
        <slot />
      </main>
    </div>

    <nav class="a-tabbar" aria-label="Secciones">
      {tabs.map((n) => (
        <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>
          <Icon name={n.icon} size={22} />{n.label}
          {n.badge > 0 && <span class="badge-dot" aria-label={`${n.badge} pendientes`}></span>}
        </a>
      ))}
      <button type="button" popovertarget="a-more" aria-current={more.some((n) => n.key === section) ? 'page' : undefined}>
        <Icon name="menu" size={22} />Más
      </button>
    </nav>
    <div id="a-more" popover class="a-more">
      {more.map((n) => <a href={n.href}><Icon name={n.icon} /> {n.label}</a>)}
      <form method="post" action="/salir">
        <button type="submit"><Icon name="log-out" /> Salir</button>
      </form>
    </div>

    <dialog id="confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-text">
      <form method="dialog">
        <span class="confirm-icon"><Icon name="triangle-alert" size={26} /></span>
        <p id="confirm-text" data-confirm-text>¿Seguro?</p>
        <div class="confirm-actions">
          <button class="btn btn-ghost" value="cancel" autofocus>Cancelar</button>
          <button class="btn btn-danger-solid" value="ok" data-confirm-ok>Sí, continuar</button>
        </div>
      </form>
    </dialog>

    <template id="field-error-tpl">
      <p class="field-error" role="alert"><Icon name="circle-alert" size={16} /><span data-field-error-text></span></p>
    </template>

    <dialog id="alert-dialog" class="confirm-dialog" aria-labelledby="alert-text">
      <form method="dialog">
        <span class="confirm-icon"><Icon name="triangle-alert" size={26} /></span>
        <p id="alert-text" data-alert-text></p>
        <div class="confirm-actions">
          <button class="btn btn-ghost" value="cancel" data-alert-close>Entendido</button>
          <a class="btn btn-primary" href="#" data-alert-link hidden>Subir justificante</a>
          <button class="btn btn-primary" type="button" data-alert-pick hidden>Elegir el justificante</button>
        </div>
      </form>
    </dialog>

    <script>
      import { needsReceipt, RECEIPT_MISSING } from '../lib/finance.js';

      // Confirmación antes de acciones delicadas: <button data-confirm="¿Borrar…?" data-confirm-ok="Borrar">
      // Ventana propia (no la del navegador, que algunos bloquean). Al confirmar se repite el clic.
      const dialog = document.getElementById('confirm-dialog');
      const text = dialog?.querySelector('[data-confirm-text]');
      const ok = dialog?.querySelector('[data-confirm-ok]');
      let confirmed = null;
      document.addEventListener('click', (e) => {
        const btn = e.target instanceof Element ? e.target.closest('[data-confirm]') : null;
        if (!(btn instanceof HTMLElement)) return;
        if (confirmed === btn) {
          confirmed = null;
          return;
        }
        e.preventDefault();
        const message = btn.dataset.confirm || '¿Seguro?';
        if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== 'function') {
          if (window.confirm(message)) {
            confirmed = btn;
            btn.click();
          }
          return;
        }
        text.textContent = message;
        ok.textContent = btn.dataset.confirmOk || 'Sí, continuar';
        ok.className = btn.classList.contains('btn-danger') ? 'btn btn-danger-solid' : 'btn btn-primary';
        dialog.returnValue = '';
        dialog.addEventListener('close', () => {
          if (dialog.returnValue === 'ok') {
            confirmed = btn;
            btn.click();
          }
        }, { once: true });
        dialog.showModal();
      });
      // «Pagado» por transferencia sin justificante: aviso antes de enviar (el servidor también lo comprueba).
      // <form data-has-receipt="0|1" data-receipt-href="ficha#justificante"> + <button data-receipt-check>;
      // data-receipt-check="status": sólo si el formulario pasa el pago a «Ya pagado».
      const alertBox = document.getElementById('alert-dialog');
      document.addEventListener('submit', (e) => {
        const form = e.target;
        const btn = e.submitter;
        if (!(form instanceof HTMLFormElement) || !(btn instanceof HTMLElement) || !btn.hasAttribute('data-receipt-check')) return;
        if (btn.dataset.receiptCheck === 'status') {
          const status = form.querySelector('input[name="status"]:checked');
          if (!(status instanceof HTMLInputElement) || status.value !== 'pagado' || form.dataset.wasPaid === '1') return;
        }
        const method = form.elements.namedItem('method');
        if (!(method instanceof HTMLSelectElement) || !needsReceipt(method.value) || form.dataset.hasReceipt === '1') return;
        const file = form.querySelector('input[type="file"][name="receipt"]');
        if (file instanceof HTMLInputElement && file.files?.length) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        if (!(alertBox instanceof HTMLDialogElement) || typeof alertBox.showModal !== 'function') {
          window.alert(RECEIPT_MISSING);
          return;
        }
        alertBox.querySelector('[data-alert-text]').textContent = RECEIPT_MISSING;
        const link = alertBox.querySelector('[data-alert-link]');
        const pick = alertBox.querySelector('[data-alert-pick]');
        const close = alertBox.querySelector('[data-alert-close]');
        // Si el formulario tiene dónde adjuntarlo: se elige el archivo y se marca pagado sin más pasos
        const canPick = file instanceof HTMLInputElement;
        const href = canPick ? null : form.dataset.receiptHref;
        pick.hidden = !canPick;
        link.hidden = !href;
        if (href) link.href = href;
        close.className = canPick || href ? 'btn btn-ghost' : 'btn btn-primary';
        pick.onclick = () => {
          alertBox.close();
          file.addEventListener('change', () => {
            if (file.files?.length) form.requestSubmit(btn);
          }, { once: true });
          file.click();
        };
        alertBox.showModal();
      }, true);

      // Botones de adjuntar (p. ej. el justificante en las listas): muestran el nombre del archivo elegido
      document.addEventListener('change', (e) => {
        const input = e.target;
        if (!(input instanceof HTMLInputElement) || input.type !== 'file') return;
        const label = input.closest('.file-btn')?.querySelector('[data-file-button]');
        if (!label) return;
        const name = input.files?.[0]?.name ?? '';
        label.textContent = name ? (name.length > 18 ? `${name.slice(0, 16)}…` : name) : 'Justificante';
        input.closest('.file-btn').classList.toggle('has-file', !!name);
      });

      // Desplegables: las sugerencias (proveedores, clientes…) salen al escribir, no nada más entrar en el
      // campo, y el navegador no propone lo escrito otras veces: así se ve el ejemplo del campo.
      const syncList = (input) => {
        if (input.hasAttribute('data-picker-input')) return; // el proveedor tiene su propio desplegable
        if (!input.dataset.list) {
          if (!input.hasAttribute('list')) return;
          input.dataset.list = input.getAttribute('list');
        }
        if (input.value.trim().length >= 2) input.setAttribute('list', input.dataset.list);
        else input.removeAttribute('list');
      };
      document.querySelectorAll('input[list]').forEach(syncList);
      document.addEventListener('input', (e) => {
        if (e.target instanceof HTMLInputElement) syncList(e.target);
      });
      document.querySelectorAll('.a-main input:not([type="hidden"]):not([autocomplete]), .a-main textarea:not([autocomplete])')
        .forEach((el) => el.setAttribute('autocomplete', 'off'));

      // Navegación: «Volver a …» lleva a la bandeja de la que se vino; si se vino de la lista de
      // expedientes, la miga «Expedientes» vuelve a ella con sus filtros y su búsqueda.
      const ORIGIN_KEY = 'ge:origen';
      const here = () => {
        const u = new URL(window.location.href);
        ['ok', 'aviso', 'aviso_doc'].forEach((k) => u.searchParams.delete(k));
        return u.pathname + u.search;
      };
      let origin = null;
      try {
        origin = JSON.parse(sessionStorage.getItem(ORIGIN_KEY) ?? 'null');
      } catch { /* sin almacenamiento: sólo las migas */ }
      if (origin?.href && origin.href !== here()) {
        const list = document.querySelector('[data-crumb-list]');
        const back = document.querySelector('[data-return]');
        if (list instanceof HTMLAnchorElement && origin.href.startsWith('/expedientes')) {
          list.href = origin.href;
        } else if (back instanceof HTMLAnchorElement) {
          back.href = origin.href;
          back.querySelector('[data-return-label]').textContent = origin.label;
          back.hidden = false;
        }
      }
      if (document.body.dataset.origin) {
        try {
          sessionStorage.setItem(ORIGIN_KEY, JSON.stringify({ href: here(), label: document.body.dataset.origin }));
        } catch { /* sin almacenamiento */ }
      }

      // ── Errores de los formularios: debajo del campo, y la página va hasta él ──────────────
      // Lo comprueba el navegador antes de enviar (campo vacío, opción sin elegir…) y el servidor
      // después; en los dos casos el aviso sale junto al campo, no arriba del todo.
      const errorTpl = document.getElementById('field-error-tpl');
      const fieldOf = (el) => el.closest('fieldset.field, .field') ?? el.parentElement;
      const showFieldError = (field, text) => {
        if (!field || !(errorTpl instanceof HTMLTemplateElement)) return;
        field.classList.add('has-error');
        let box = field.querySelector(':scope > .field-error');
        if (!box) {
          box = errorTpl.content.firstElementChild.cloneNode(true);
          field.append(box);
        }
        box.querySelector('[data-field-error-text]').textContent = text;
      };
      const goTo = (field, control) => {
        field.closest('details:not([open])')?.setAttribute('open', '');
        field.scrollIntoView({ block: 'center', behavior: 'smooth' });
        if (control instanceof HTMLElement) control.focus({ preventScroll: true });
      };
      // Al corregir el campo, el aviso se quita
      const clearFieldError = (e) => {
        const field = e.target instanceof Element ? e.target.closest('.has-error') : null;
        if (!field) return;
        field.classList.remove('has-error');
        field.querySelector(':scope > .field-error')?.remove();
      };
      document.addEventListener('input', clearFieldError);
      document.addEventListener('change', clearFieldError);

      // 1. Del navegador: en vez de su globo (que queda debajo de la cabecera), el aviso propio
      let jumped = false;
      document.addEventListener('invalid', (e) => {
        const control = e.target;
        if (!(control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement)) return;
        e.preventDefault();
        const field = fieldOf(control);
        showFieldError(field, control.dataset.invalid || control.validationMessage);
        if (!jumped) {
          jumped = true;
          goTo(field, control);
          setTimeout(() => { jumped = false; }, 0);
        }
      }, true);

      // Botones que necesitan campos que en otros casos son opcionales (p. ej. «Emitir» y el NIF del cliente):
      // <button data-requires="#a, #b" data-requires-msg="…">. Se avisa del primero vacío sin enviar el formulario.
      document.addEventListener('submit', (e) => {
        const btn = e.submitter;
        const selector = btn instanceof HTMLElement ? btn.dataset.requires : null;
        if (!selector || !(e.target instanceof HTMLFormElement)) return;
        const form = e.target;
        const control = selector.split(',').map((one) => form.querySelector(one.trim()))
          .find((c) => (c instanceof HTMLInputElement || c instanceof HTMLTextAreaElement) && !c.value.trim());
        if (!control) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        const field = fieldOf(control);
        showFieldError(field, btn.dataset.requiresMsg || 'Este campo es obligatorio.');
        goTo(field, control);
      }, true);

      // 2. Del servidor: los campos marcados reciben su mensaje y se va al primero
      const serverErrors = (() => {
        try {
          return JSON.parse(document.body.dataset.fieldErrors ?? '{}');
        } catch {
          return {};
        }
      })();
      const flash = document.querySelector('.flash-error');
      const marked = [...document.querySelectorAll('.a-main .has-error')];
      let firstMarked = null;
      for (const field of marked) {
        const inVat = field.closest('[data-vat-lines]');
        const names = [...field.querySelectorAll('[name]')].map((i) => i.getAttribute('name'));
        const key = inVat ? 'amount' : names.find((n) => serverErrors[n]);
        if (!key || !serverErrors[key]) continue;
        // El importe ya muestra su error en la línea de IVA
        if (!inVat) {
          const fieldText = serverErrors[key];
          const general = flash?.textContent.trim() ?? '';
          showFieldError(field, !firstMarked && general.includes(fieldText) ? general : fieldText);
        }
        firstMarked ??= field;
      }
      if (firstMarked) {
        // El aviso de arriba sobra: el mismo mensaje está junto al campo
        flash?.setAttribute('hidden', '');
        goTo(firstMarked, firstMarked.querySelector('input:not([type="hidden"]), select, textarea'));
      }

      // Evita el doble envío (y da feedback mientras se suben documentos)
      document.addEventListener('submit', (e) => {
        const form = e.target;
        if (!(form instanceof HTMLFormElement) || e.defaultPrevented) return;
        const btn = e.submitter;
        if (btn instanceof HTMLButtonElement && btn.dataset.busy) {
          setTimeout(() => {
            btn.disabled = true;
            btn.textContent = btn.dataset.busy;
          }, 0);
        }
      });
    </script>
  </body>
</html>
