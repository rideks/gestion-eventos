---
// Plantilla de la aplicación. Misma estructura que el panel de club-futsal:
// menú lateral en el ordenador y barra inferior para el pulgar en el móvil.
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '../styles/app.css';
import { env } from 'cloudflare:workers';
import Icon from '../components/Icon.astro';
import { navCounts } from '../lib/data.js';
import { today } from '../lib/dates.js';
import { can, FLASH } from '../lib/app.js';

const { title = 'Inicio', section = '', error = null, notice = null, wide = false } = Astro.props;
const user = Astro.locals.user;
const company = env.COMPANY_NAME || 'Seven Worlds';
const counts = await navCounts(env.DB, today());
const admin = can(user, 'expediente.open');
const reviewer = can(user, 'supplier.review');
const toReview = reviewer ? counts.to_review : 0;

const ok = FLASH[Astro.url.searchParams.get('ok') ?? ''];
const warn = Astro.url.searchParams.get('aviso') === 'permiso' ? 'Eso sólo lo puede hacer Administración.' : null;

const nav = [
  { key: 'inicio', href: '/', label: 'Inicio', icon: 'house' },
  { key: 'expedientes', href: '/expedientes', label: 'Expedientes', icon: 'folder', badge: admin ? counts.requests : 0, tone: 'warn' },
  { key: 'pagos', href: '/pagos', label: 'Pagos', icon: 'arrow-up-right', badge: counts.urgent, tone: 'danger' },
  { key: 'cobros', href: '/cobros', label: 'Cobros', icon: 'arrow-down-left', badge: admin ? counts.to_issue : 0, tone: 'warn' },
  { key: 'nuevo', href: '/expedientes/nuevo', label: 'Nueva solicitud', icon: 'folder-plus', sep: true },
  ...(admin ? [
    { key: 'usuarios', href: '/usuarios', label: 'Usuarios', icon: 'user-plus' },
    { key: 'ajustes', href: '/ajustes', label: 'Ajustes', icon: 'settings' },
  ] : []),
  { key: 'cuenta', href: '/cuenta', label: 'Mi cuenta', icon: 'user-round' },
];
const tabs = nav.slice(0, 4);
const more = nav.slice(4);
const roleLabel = admin ? 'Administración' : 'Eventos';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · {company}</title>
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <header class="a-header">
      <a class="a-brand" href="/">
        <img src="/brand/logo.png" alt={`${company} · Events & Congresses`} width="105" height="50" />
        <span class="app-name">Gestión<br />de eventos</span>
      </a>
      <span class="spacer"></span>
      {user && <span class="a-user">{user.name} · {roleLabel}</span>}
      {reviewer && (
        <a class:list={['bell', { 'has-news': toReview > 0 }]} href="/pagos?ver=revisar"
          aria-label={toReview ? `${toReview} ${toReview === 1 ? 'factura nueva' : 'facturas nuevas'} por revisar` : 'Facturas por revisar'}
          title={toReview ? `${toReview} ${toReview === 1 ? 'factura nueva' : 'facturas nuevas'} por revisar` : 'No hay facturas por revisar'}>
          <Icon name="bell" size={22} />
          {toReview > 0 && <span class="bell-count">{toReview}</span>}
        </a>
      )}
      <a class="btn btn-primary btn-sm" href="/expedientes/nuevo"><Icon name="plus" size={18} /><span class="btn-label">Nueva solicitud</span></a>
    </header>

    <div class="a-shell">
      <nav class="a-side" aria-label="Secciones">
        {nav.map((n) => (
          <>
            {n.sep && <hr />}
            <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>
              <Icon name={n.icon} /> {n.label}
              {n.badge > 0 && <span class:list={['badge-count', `is-${n.tone}`]}>{n.badge}</span>}
            </a>
          </>
        ))}
        <form method="post" action="/salir">
          <button class="btn btn-ghost btn-sm btn-block" type="submit"><Icon name="log-out" size={16} /> Salir</button>
        </form>
      </nav>

      <main class:list={['a-main', { 'is-wide': wide }]}>
        {ok && <p class="flash flash-ok" role="status"><Icon name="check" /> {ok}</p>}
        {(warn || notice) && <p class="flash flash-warn" role="status"><Icon name="info" /> {warn || notice}</p>}
        {error && <p class="flash flash-error" role="alert"><Icon name="circle-alert" /> {error}</p>}
        <slot />
      </main>
    </div>

    <nav class="a-tabbar" aria-label="Secciones">
      {tabs.map((n) => (
        <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>
          <Icon name={n.icon} size={22} />{n.label}
          {n.badge > 0 && <span class="badge-dot" aria-label={`${n.badge} pendientes`}></span>}
        </a>
      ))}
      <button type="button" popovertarget="a-more" aria-current={more.some((n) => n.key === section) ? 'page' : undefined}>
        <Icon name="menu" size={22} />Más
      </button>
    </nav>
    <div id="a-more" popover class="a-more">
      {more.map((n) => <a href={n.href}><Icon name={n.icon} /> {n.label}</a>)}
      <form method="post" action="/salir">
        <button type="submit"><Icon name="log-out" /> Salir</button>
      </form>
    </div>

    <dialog id="confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-text">
      <form method="dialog">
        <span class="confirm-icon"><Icon name="triangle-alert" size={26} /></span>
        <p id="confirm-text" data-confirm-text>¿Seguro?</p>
        <div class="confirm-actions">
          <button class="btn btn-ghost" value="cancel" autofocus>Cancelar</button>
          <button class="btn btn-danger-solid" value="ok" data-confirm-ok>Sí, continuar</button>
        </div>
      </form>
    </dialog>

    <dialog id="alert-dialog" class="confirm-dialog" aria-labelledby="alert-text">
      <form method="dialog">
        <span class="confirm-icon"><Icon name="triangle-alert" size={26} /></span>
        <p id="alert-text" data-alert-text></p>
        <div class="confirm-actions">
          <button class="btn btn-ghost" value="cancel" data-alert-close>Entendido</button>
          <a class="btn btn-primary" href="#" data-alert-link hidden>Subir justificante</a>
        </div>
      </form>
    </dialog>

    <script>
      import { needsReceipt, RECEIPT_MISSING } from '../lib/finance.js';

      // Confirmación antes de acciones delicadas: <button data-confirm="¿Borrar…?" data-confirm-ok="Borrar">
      // Ventana propia (no la del navegador, que algunos bloquean). Al confirmar se repite el clic.
      const dialog = document.getElementById('confirm-dialog');
      const text = dialog?.querySelector('[data-confirm-text]');
      const ok = dialog?.querySelector('[data-confirm-ok]');
      let confirmed = null;
      document.addEventListener('click', (e) => {
        const btn = e.target instanceof Element ? e.target.closest('[data-confirm]') : null;
        if (!(btn instanceof HTMLElement)) return;
        if (confirmed === btn) {
          confirmed = null;
          return;
        }
        e.preventDefault();
        const message = btn.dataset.confirm || '¿Seguro?';
        if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== 'function') {
          if (window.confirm(message)) {
            confirmed = btn;
            btn.click();
          }
          return;
        }
        text.textContent = message;
        ok.textContent = btn.dataset.confirmOk || 'Sí, continuar';
        ok.className = btn.classList.contains('btn-danger') ? 'btn btn-danger-solid' : 'btn btn-primary';
        dialog.returnValue = '';
        dialog.addEventListener('close', () => {
          if (dialog.returnValue === 'ok') {
            confirmed = btn;
            btn.click();
          }
        }, { once: true });
        dialog.showModal();
      });
      // «Pagado» por transferencia sin justificante: aviso antes de enviar (el servidor también lo comprueba).
      // <form data-has-receipt="0|1" data-receipt-href="ficha#justificante"> + <button data-receipt-check>;
      // data-receipt-check="status": sólo si el formulario pasa el pago a «Ya pagado».
      const alertBox = document.getElementById('alert-dialog');
      document.addEventListener('submit', (e) => {
        const form = e.target;
        const btn = e.submitter;
        if (!(form instanceof HTMLFormElement) || !(btn instanceof HTMLElement) || !btn.hasAttribute('data-receipt-check')) return;
        if (btn.dataset.receiptCheck === 'status') {
          const status = form.querySelector('input[name="status"]:checked');
          if (!(status instanceof HTMLInputElement) || status.value !== 'pagado' || form.dataset.wasPaid === '1') return;
        }
        const method = form.elements.namedItem('method');
        if (!(method instanceof HTMLSelectElement) || !needsReceipt(method.value) || form.dataset.hasReceipt === '1') return;
        const file = form.querySelector('input[type="file"][name="receipt"]');
        if (file instanceof HTMLInputElement && file.files?.length) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        if (!(alertBox instanceof HTMLDialogElement) || typeof alertBox.showModal !== 'function') {
          window.alert(RECEIPT_MISSING);
          return;
        }
        alertBox.querySelector('[data-alert-text]').textContent = RECEIPT_MISSING;
        const link = alertBox.querySelector('[data-alert-link]');
        const close = alertBox.querySelector('[data-alert-close]');
        const href = form.dataset.receiptHref;
        link.hidden = !href;
        if (href) link.href = href;
        close.className = href ? 'btn btn-ghost' : 'btn btn-primary';
        alertBox.addEventListener('close', () => {
          // En la ficha: lleva al campo del justificante
          if (!href && file instanceof HTMLInputElement) {
            file.closest('[data-file-field]')?.scrollIntoView({ block: 'center' });
            file.focus();
          }
        }, { once: true });
        alertBox.showModal();
      }, true);

      // Desplegables: las sugerencias (proveedores, clientes…) salen al escribir, no nada más entrar en el
      // campo, y el navegador no propone lo escrito otras veces: así se ve el ejemplo del campo.
      const syncList = (input) => {
        if (!input.dataset.list) {
          if (!input.hasAttribute('list')) return;
          input.dataset.list = input.getAttribute('list');
        }
        if (input.value.trim().length >= 2) input.setAttribute('list', input.dataset.list);
        else input.removeAttribute('list');
      };
      document.querySelectorAll('input[list]').forEach(syncList);
      document.addEventListener('input', (e) => {
        if (e.target instanceof HTMLInputElement) syncList(e.target);
      });
      document.querySelectorAll('.a-main input:not([type="hidden"]):not([autocomplete]), .a-main textarea:not([autocomplete])')
        .forEach((el) => el.setAttribute('autocomplete', 'off'));

      // Evita el doble envío (y da feedback mientras se suben documentos)
      document.addEventListener('submit', (e) => {
        const form = e.target;
        if (!(form instanceof HTMLFormElement) || e.defaultPrevented) return;
        const btn = e.submitter;
        if (btn instanceof HTMLButtonElement && btn.dataset.busy) {
          setTimeout(() => {
            btn.disabled = true;
            btn.textContent = btn.dataset.busy;
          }, 0);
        }
      });
    </script>
  </body>
</html>
