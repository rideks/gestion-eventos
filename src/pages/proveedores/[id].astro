---
// Ficha de un proveedor: datos y condiciones, volumen de negocio (con quién, cuánto y cuándo) y el
// historial de expedientes en los que ha trabajado. Cómo se calcula cada importe: src/lib/suppliers.js.
// Los importes y las condiciones económicas sólo con permiso de gasto; editar y fusionar, con el de edición.
// Los contratos (con su caducidad bien a la vista) y el contrato aplicado en cada expediente, con el de contratos.
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import SupplierFields from '../../components/SupplierFields.astro';
import { parseId, readForm, can } from '../../lib/app.js';
import { SUPPLIER_STATUS, formToObject } from '../../lib/validate.js';
import { contractOn, RENEWAL } from '../../lib/contracts.js';
import { expLabel } from '../../lib/finance.js';
import { eur } from '../../lib/money.js';
import { formatDate, formatDateLong, formatRange } from '../../lib/dates.js';
import { serviceContext, failure } from '../../services/context.js';
import * as suppliers from '../../services/suppliers.js';
import * as contractsService from '../../services/contracts.js';

const ctx = serviceContext(Astro);
const id = parseId(Astro.params.id);
const me = Astro.locals.user;
const seesContracts = can(me, 'contratos');
const editsContracts = can(me, 'contratos.edit');
const self = `/proveedores/${id}`;
let error = null;
let errors = {};
let input = null;
let openEdit = Astro.url.searchParams.has('editar');

if (id && Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  input = form ? formToObject(form) : {};
  const r = input.intent === 'save' ? await suppliers.update(ctx, id, input)
    : input.intent === 'merge' ? await suppliers.merge(ctx, id, parseId(input.into))
      : input.intent === 'delete' ? await suppliers.remove(ctx, id)
        : { ok: false, code: 'forbidden' };
  if (r.ok) {
    if (input.intent === 'merge') return Astro.redirect(`/proveedores/${r.value.into.id}?ok=guardado&fusionado=${encodeURIComponent(r.value.from.name)}`, 303);
    return Astro.redirect(input.intent === 'delete' ? '/proveedores?ok=borrado' : `${self}?ok=guardado`, 303);
  }
  const back = failure(Astro, r, self);
  if (back) return back;
  error = r.message;
  errors = r.fields;
  openEdit = input.intent === 'save';
}

const f = id ? await suppliers.ficha(ctx, id) : { ok: false, code: 'not_found' };
if (!f.ok) return failure(Astro, f, '/proveedores');
const ficha = f.value;
const { money, editable, types, others } = ficha;
const vol = ficha.volume;
const s = ficha.supplier;
const v = openEdit && input ? { ...s, ...input } : s;
const contractsResult = seesContracts ? await contractsService.forSupplier(ctx, id) : null;
const contracts = contractsResult?.ok ? contractsResult.value : [];
// En la ficha, arriba: los que están en vigor, los que empiezan más adelante y los caducados sin renovar
const HISTORY = ['renovado', 'finalizado'];
const current = contracts.filter((c) => !HISTORY.includes(c.state.key));
const past = contracts.filter((c) => HISTORY.includes(c.state.key));
const contractHref = (c) => `/proveedores/${id}/contratos/${c.id}`;
const firstLine = (text) => (text ?? '').split('\n').find((l) => l.trim()) ?? '';
const year = Number(ctx.now.slice(0, 4));
const merged = Astro.url.searchParams.get('fusionado');
const pct = (x) => `${x > 0 ? '+' : ''}${Math.round(x * 100)} %`;
const phoneHref = s.phone ? `tel:${s.phone.replace(/[^\d+]/g, '')}` : null;
---
<App title={s.name} section="proveedores" error={error} fieldErrors={errors} notice={merged ? `Fusionado: los pagos de «${merged}» ya están en esta ficha y su nombre queda como nombre anterior.` : null}>
  <div class="crumbs">
    <nav aria-label="Estás en">
      <ol>
        <li class="is-parent"><a href="/proveedores" data-crumb-list><Icon name="arrow-left" size={16} class="crumb-arrow" />Proveedores</a></li>
        <li><span aria-current="page">{s.name}</span></li>
      </ol>
    </nav>
    <a class="btn btn-ghost btn-sm return-link" href="/" data-return hidden><Icon name="corner-up-left" size={16} /> Volver a <span data-return-label></span></a>
  </div>

  <div class="page-top">
    <div>
      <h1>{s.name}</h1>
      <p class="exp-meta">
        {s.type && <span class="pill pill-accent">{s.type}</span>}
        {s.status !== 'activo' && <span class:list={['pill', s.status === 'bloqueado' ? 'pill-danger' : 'pill-muted']}>{SUPPLIER_STATUS[s.status]}</span>}
        {s.city && <span><Icon name="map-pin" size={16} />{s.city}</span>}
        <span><Icon name="folder" size={16} />{vol.exps} {vol.exps === 1 ? 'expediente' : 'expedientes'}{vol.last && ` · el último, ${formatDate(vol.last)}`}</span>
      </p>
    </div>
    {editable && <a class="btn btn-ghost btn-sm" href={`/proveedores/${id}?editar#editar`}><Icon name="pencil" size={16} /> Editar ficha</a>}
  </div>

  {seesContracts && (
    <section class="contracts-block" id="contratos">
      <div class="sec-head">
        <h2 class="section-title"><Icon name="file-text" /> Contratos</h2>
        {editsContracts && <a class="btn btn-ghost btn-sm" href={`/proveedores/${id}/contratos/nuevo`}><Icon name="plus" size={16} /> Nuevo contrato</a>}
      </div>
      {current.length ? (
        <div class="contract-cards">
          {current.map((c) => (
            <article class:list={['contract-card', `is-${c.state.tone}`]}>
              <div class="cc-expiry">
                <span class="ce-label">{c.ends_on ? (c.state.days !== null && c.state.days < 0 ? 'Caducó el' : 'Caduca el') : 'Vigencia'}</span>
                <b class="ce-date">{c.ends_on ? formatDateLong(c.ends_on) : 'Indefinido'}</b>
                <span class="ce-days">{c.state.text}</span>
              </div>
              <div class="cc-body">
                <h3><a href={contractHref(c)}>{c.title}</a> <Pill state={c.state} />{c.renewal === 'no' && <span class="pill pill-muted">{RENEWAL.no}</span>}</h3>
                <p class="muted small">{formatDate(c.starts_on)} – {c.ends_on ? formatDate(c.ends_on) : 'sin fin'}{c.alert_days ? ` · aviso ${c.alert_days} días antes` : ' · sin aviso'}</p>
                <dl class="kv compact">
                  {c.rates && <><dt>Tarifas</dt><dd>{firstLine(c.rates)}</dd></>}
                  {c.discounts && <><dt>Descuentos</dt><dd>{firstLine(c.discounts)}</dd></>}
                  {c.payment_terms && <><dt>Pago</dt><dd>{firstLine(c.payment_terms)}</dd></>}
                  {c.credit_terms && <><dt>Crédito</dt><dd>{firstLine(c.credit_terms)}</dd></>}
                </dl>
                <div class="actions-inline">
                  <a class="btn btn-ghost btn-sm" href={contractHref(c)}>Ver contrato</a>
                  {editsContracts && c.state.attention && <a class="btn btn-primary btn-sm" href={`/proveedores/${id}/contratos/nuevo?renueva=${c.id}`}><Icon name="rotate-ccw" size={16} /> Renovar</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : <p class="muted">{contracts.length ? 'Ningún contrato en vigor.' : 'Sin contratos registrados.'}</p>}
      {past.length > 0 && (
        <details class="past-contracts">
          <summary>Contratos anteriores ({past.length})</summary>
          <ul class="list">
            {past.map((c) => (
              <li><a class="item" href={contractHref(c)}>
                <div class="item-body">
                  <span class="item-title">{c.title} <Pill state={c.state} /></span>
                  <span class="item-meta"><span>{formatDate(c.starts_on)} – {c.ends_on ? formatDate(c.ends_on) : 'sin fin'}</span>{c.rates && <span>{firstLine(c.rates)}</span>}</span>
                </div>
                <Icon name="chevron-right" class="chev" />
              </a></li>
            ))}
          </ul>
        </details>
      )}
    </section>
  )}

  {money && (
    <>
      <h2 class="section-title">Volumen de negocio</h2>
      <div class="kpis">
        <div class="kpi is-gold"><span>Contratado</span><b class="money">{eur(vol.contracted)}</b><small>sin IVA · {vol.exps} {vol.exps === 1 ? 'expediente' : 'expedientes'}{vol.exps > 1 && ` · media ${eur(vol.average)}`}</small></div>
        <div class="kpi"><span>En {year}</span><b class="money">{eur(vol.thisYear)}</b><small>eventos de {year}</small></div>
        <div class="kpi is-ok"><span>Pagado</span><b class="money">{eur(vol.paid)}</b><small>con factura del proveedor: {eur(vol.invoiced)}</small></div>
        <div class:list={['kpi', { 'is-danger': vol.pending > 0 }]}><span>Pendiente de pago</span><b class="money">{eur(vol.pending)}</b><small>{vol.credits ? `abonos y comisiones: ${eur(vol.credits)}` : 'sin abonos ni comisiones'}</small></div>
      </div>
      <p class="muted small">Importes sin IVA de los pagos a este proveedor en expedientes no cancelados. «Contratado» incluye los pagos previstos; los abonos y comisiones (líneas en negativo) van aparte.</p>
    </>
  )}

  <div class="two-col mt">
    <section class="card">
      <h2>Datos</h2>
      <dl class="kv">
        <dt>Contacto</dt><dd>{s.contact_name ?? '—'}</dd>
        <dt>Teléfono</dt><dd>{phoneHref ? <a href={phoneHref}>{s.phone}</a> : '—'}</dd>
        <dt>Email</dt><dd>{s.email ? <a href={`mailto:${s.email}`}>{s.email}</a> : '—'}</dd>
        <dt>Dirección</dt><dd>{[s.address, s.city].filter(Boolean).join(' · ') || '—'}</dd>
        <dt>Capacidad</dt><dd>{s.max_capacity ? `${s.max_capacity} personas` : '—'}</dd>
        <dt>Relación desde</dt><dd>{s.since_on ? formatDate(s.since_on) : vol.first ? `${formatDate(vol.first)} (primer evento registrado)` : '—'}</dd>
        {ficha.aliases.length > 0 && <><dt>Nombres anteriores</dt><dd>{ficha.aliases.join(' · ')}</dd></>}
        <dt>Alta</dt><dd>{formatDate(s.created_at.slice(0, 10))}{s.created_by_name && ` · ${s.created_by_name}`}</dd>
      </dl>
    </section>
    <section class="card">
      <h2>Condiciones y comentarios</h2>
      <dl class="kv">
        {money && <><dt>Condiciones económicas</dt><dd class="pre">{s.economic_terms ?? '—'}</dd></>}
        {money && <><dt>Crédito y pago</dt><dd class="pre">{s.payment_terms ?? '—'}</dd></>}
        <dt>Comentarios internos</dt><dd class="pre">{s.notes ?? '—'}</dd>
      </dl>
    </section>
  </div>

  <h2 class="section-title">Expedientes en los que ha trabajado ({ficha.expedientes.length})</h2>
  {ficha.expedientes.length ? (
    <div class="table-scroll">
      <table class="dtable">
        <thead>
          <tr>
            <th scope="col">Expediente</th><th scope="col">Cliente</th><th scope="col">Ciudad</th><th scope="col">Fechas</th><th scope="col">Servicios</th>
            {seesContracts && <th scope="col">Contrato aplicado</th>}
            {money && <><th scope="col" class="num">Contratado</th><th scope="col" class="num">Pagado</th><th scope="col" class="num">Pendiente</th></>}
          </tr>
        </thead>
        <tbody>
          {ficha.expedientes.map((e) => (
            <tr class:list={{ 'is-planned': e.status === 'cancelado' }}>
              <td><a href={`/expedientes/${e.id}/pagos`}><strong>{expLabel(e)}</strong> · {e.name}</a>{e.status === 'cancelado' && <span class="pill pill-muted">Cancelado · no cuenta</span>}</td>
              <td>{e.company}</td>
              <td>{e.destination ?? '—'}</td>
              <td>{e.start_date ? formatRange(e.start_date, e.end_date) : '—'}</td>
              <td>{e.concepts ? e.concepts.split(',').join(' · ') : '—'}</td>
              {seesContracts && <td>{(() => { const k = contractOn(contracts, e.start_date); return k ? <a href={contractHref(k)}>{k.title}</a> : <span class="muted">—</span>; })()}</td>}
              {money && <><td class="num">{eur(e.contracted)}</td><td class="num">{eur(e.paid)}</td><td class:list={['num', { neg: e.pending > 0 }]}>{eur(e.pending)}</td></>}
            </tr>
          ))}
        </tbody>
        {money && vol.exps > 0 && (
          <tfoot><tr><td colspan={seesContracts ? 6 : 5}>Total (sin cancelados)</td><td class="num">{eur(vol.contracted)}</td><td class="num">{eur(vol.paid)}</td><td class="num">{eur(vol.pending)}</td></tr></tfoot>
        )}
      </table>
    </div>
  ) : <p class="muted">Todavía no aparece en ningún expediente.</p>}

  {money && vol.exps > 0 && (
    <div class="two-col mt">
      <section class="card">
        <h2>Por año</h2>
        <table class="dtable compact">
          <thead><tr><th scope="col">Año</th><th scope="col" class="num">Exp.</th><th scope="col" class="num">Contratado</th><th scope="col" class="num">vs año anterior</th></tr></thead>
          <tbody>
            {vol.byYear.map((y) => (
              <tr><td>{y.key}</td><td class="num">{y.exps}</td><td class="num">{eur(y.contracted)}</td><td class="num">{y.change === null ? '—' : pct(y.change)}</td></tr>
            ))}
          </tbody>
        </table>
      </section>
      <section class="card">
        <h2>Por cliente</h2>
        <table class="dtable compact">
          <thead><tr><th scope="col">Cliente</th><th scope="col" class="num">Exp.</th><th scope="col" class="num">Contratado</th></tr></thead>
          <tbody>
            {vol.byClient.map((c) => <tr><td>{c.key}</td><td class="num">{c.exps}</td><td class="num">{eur(c.contracted)}</td></tr>)}
          </tbody>
        </table>
        {vol.byCity.length > 1 && (
          <>
            <h2 class="mt">Por ciudad</h2>
            <table class="dtable compact">
              <thead><tr><th scope="col">Ciudad</th><th scope="col" class="num">Exp.</th><th scope="col" class="num">Contratado</th></tr></thead>
              <tbody>{vol.byCity.map((c) => <tr><td>{c.key}</td><td class="num">{c.exps}</td><td class="num">{eur(c.contracted)}</td></tr>)}</tbody>
            </table>
          </>
        )}
      </section>
    </div>
  )}

  {editable && (
    <>
      <details class="add mt" id="editar" open={openEdit}>
        <summary class="btn btn-primary"><Icon name="pencil" size={18} /> <span class="when-closed">Editar ficha</span><span class="when-open">Cerrar formulario</span></summary>
        <form method="post" class="form-section">
          <h2><Icon name="briefcase" /> Ficha de {s.name}</h2>
          <SupplierFields v={v} errors={errors} types={types} full money={money} />
          <p class="muted small">Si cambias el nombre, el anterior se guarda: si alguien lo vuelve a escribir en un pago, irá a este proveedor.</p>
          <div><button class="btn btn-primary" type="submit" name="intent" value="save" data-busy="Guardando…"><Icon name="check" size={18} /> Guardar ficha</button></div>
        </form>
      </details>

      {others.length > 0 && (
        <section class="card mt">
          <h2>¿Está repetido?</h2>
          <p class="muted small">Fusionarlo pasa sus pagos, documentos y contratos al otro proveedor, completa los datos que le falten y guarda «{s.name}» como nombre anterior. No se puede deshacer.</p>
          <form method="post" class="quick-form mt">
            <label class="visually-hidden" for="into">Fusionar con</label>
            <select id="into" name="into" required>
              <option value="">Fusionar con…</option>
              {others.map((o) => <option value={o.id}>{o.name}</option>)}
            </select>
            <button class="btn btn-danger btn-sm" type="submit" name="intent" value="merge" data-confirm={`¿Fusionar «${s.name}» con el proveedor elegido? Sus pagos pasarán a esa ficha y esta desaparecerá.`}>Fusionar</button>
          </form>
        </section>
      )}

      {!ficha.expedientes.length && !contracts.length && (
        <form method="post" class="mt">
          <button class="btn btn-danger btn-sm" type="submit" name="intent" value="delete" data-confirm={`¿Borrar al proveedor ${s.name}?`}><Icon name="trash-2" size={16} /> Borrar proveedor</button>
        </form>
      )}
    </>
  )}
</App>
