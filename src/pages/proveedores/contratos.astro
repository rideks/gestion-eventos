---
// Caducidades: todos los contratos de proveedores con su estado, primero lo que requiere atención
// (próximos a caducar según el aviso de cada uno, pendientes de renovación y caducados sin renovar).
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import TableTools from '../../components/TableTools.astro';
import SortTh from '../../components/SortTh.astro';
import Pager from '../../components/Pager.astro';
import { formatDate } from '../../lib/dates.js';
import { plural } from '../../lib/finance.js';
import { can } from '../../lib/app.js';
import { CONTRACT_VIEWS } from '../../lib/contracts.js';
import { TABLES } from '../../lib/tables.js';
import { tableState, pageInfo, shows, isFiltered, hrefWith } from '../../lib/table.js';
import { fileUrl } from '../../lib/files.js';
import { serviceContext, failure } from '../../services/context.js';
import * as contracts from '../../services/contracts.js';
import * as prefs from '../../services/prefs.js';

const ctx = serviceContext(Astro);
const def = TABLES.contratos;
const state = tableState(def, Astro.url.searchParams, { prefs: await prefs.forTable(ctx, 'contratos'), can: (p) => can(Astro.locals.user, p) });
const r = await contracts.table(ctx, {
  q: state.q, view: Astro.url.searchParams.get('ver') ?? '', type: state.filters.tipo ?? '',
  sort: state.sort, dir: state.dir, limit: state.per, offset: state.offset,
});
if (!r.ok) return failure(Astro, r, '/proveedores');
const { rows, total, view, counts, all, due, types } = r.value;
const info = pageInfo(total, state);
if (state.page > info.last) return Astro.redirect(hrefWith(Astro.url, { pagina: info.last }), 303);
const has = (k) => shows(state, k);
const filters = [{ ...def.filters[0], options: types.map((t) => [t, t]) }];
const q = state.q;
---
<App title="Contratos de proveedores" section="proveedores" origin="Contratos">
  <div class="crumbs">
    <nav aria-label="Estás en">
      <ol>
        <li class="is-parent"><a href="/proveedores"><Icon name="arrow-left" size={16} class="crumb-arrow" />Proveedores</a></li>
        <li><span aria-current="page">Contratos</span></li>
      </ol>
    </nav>
  </div>

  <div class="page-top">
    <div>
      <h1>Contratos</h1>
      <p>Cuándo caduca cada contrato con los proveedores y qué hay que renovar. Cada contrato avisa con los días que tenga configurados.</p>
    </div>
  </div>

  <div class="kpis">
    <a class:list={['kpi', { 'is-danger': due.caducado > 0 }]} href="?ver=atencion"><span>Caducados sin renovar</span><b>{due.caducado}</b><small>{due.caducado ? 'hay que renovarlos o marcar que no' : 'ninguno'}</small></a>
    <a class:list={['kpi', { 'is-gold': due.por_caducar > 0 }]} href="?ver=atencion"><span>Próximos a caducar</span><b>{due.por_caducar}</b><small>dentro de su aviso</small></a>
    <a class="kpi" href="?ver=atencion"><span>Pendientes de renovación</span><b>{due.pendiente}</b><small>marcados para negociar</small></a>
    <a class="kpi" href="?ver=vigentes"><span>En vigor</span><b>{counts.vigentes}</b><small>{plural(all, 'contrato', 'contratos')} en total</small></a>
  </div>

  <TableTools def={def} state={state} filters={filters} url={Astro.url} keep={['ver']} />

  <nav class="x-tabs mt" aria-label="Ver contratos">
    {Object.entries(CONTRACT_VIEWS).map(([k, x]) => (
      <a href={hrefWith(Astro.url, { ver: k })} aria-current={k === view ? 'page' : undefined}>
        {x.label}{counts[k] > 0 && <small class:list={{ 'is-alert': k === 'atencion' }}>{counts[k]}</small>}
      </a>
    ))}
  </nav>

  {rows.length ? (
    <div class="table-scroll mt">
      <table class="dtable contracts">
        <thead>
          <tr>
            {state.columns.filter((c) => has(c.key)).map((c) => <SortTh col={c} state={state} url={Astro.url} />)}
          </tr>
        </thead>
        <tbody>
          {rows.map((c) => (
            <tr class:list={{ 'is-planned': !c.state.attention && c.state.key !== 'vigente' }}>
              <td><a href={`/proveedores/${c.supplier_id}#contratos`}><strong>{c.supplier_name}</strong></a>{!has('tipo') && !has('ciudad') && (c.supplier_type || c.supplier_city) && <div class="muted small">{[c.supplier_type, c.supplier_city].filter(Boolean).join(' · ')}</div>}</td>
              {has('contrato') && <td><a href={`/proveedores/${c.supplier_id}/contratos/${c.id}`}>{c.title}</a></td>}
              {has('tipo') && <td>{c.supplier_type ?? '—'}</td>}
              {has('ciudad') && <td>{c.supplier_city ?? '—'}</td>}
              {has('firma') && <td>{c.signed_on ? formatDate(c.signed_on) : '—'}</td>}
              {has('inicio') && <td>{formatDate(c.starts_on)}</td>}
              {has('fin') && <td>{c.ends_on ? formatDate(c.ends_on) : 'Indefinido'}</td>}
              {has('estado') && <td><Pill state={c.state} /><div class:list={["small", { neg: c.state.key === "caducado" }]}>{c.state.text}</div></td>}
              {has('aviso') && <td>{c.alert_days ? `${c.alert_days} días` : '—'}</td>}
              {has('documento') && <td>{c.file_id ? <a href={fileUrl({ file_id: c.file_id, file_name: c.file_name })} target="_blank" rel="noopener">{c.file_name ?? 'Documento'}</a> : '—'}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="empty mt"><p>{isFiltered(state) ? 'Ningún contrato con esos filtros.' : view === 'atencion' ? 'Ningún contrato requiere atención.' : 'No hay contratos aquí.'}</p></div>
  )}
  <Pager info={info} url={Astro.url} noun={def.noun} />
  <p class="muted small mt">Los contratos se dan de alta desde la ficha de cada proveedor.</p>
</App>
