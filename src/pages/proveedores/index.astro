---
// Proveedores: directorio con búsqueda, filtros y orden. Lo contratado (sin IVA, eventos no
// cancelados; ver src/lib/suppliers.js) sólo lo ve quien tiene permiso de gasto: el servicio ni lo devuelve.
// Aquí se dan de alta proveedores (también desde el selector de un pago) y se gestionan los tipos.
// Antes de crear uno se avisa de los que tienen un nombre parecido: hay que confirmar que es otro.
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import SupplierFields from '../../components/SupplierFields.astro';
import TableTools from '../../components/TableTools.astro';
import SortTh from '../../components/SortTh.astro';
import Pager from '../../components/Pager.astro';
import { TABLES } from '../../lib/tables.js';
import { tableState, pageInfo, shows, isFiltered, hrefWith } from '../../lib/table.js';
import { readForm, can, parseId } from '../../lib/app.js';
import { SUPPLIER_STATUS, formToObject } from '../../lib/validate.js';
import { cleanName } from '../../lib/suppliers.js';
import { eur } from '../../lib/money.js';
import { plural } from '../../lib/finance.js';
import { formatDate } from '../../lib/dates.js';
import { serviceContext, failure } from '../../services/context.js';
import * as suppliers from '../../services/suppliers.js';
import * as contracts from '../../services/contracts.js';
import * as prefs from '../../services/prefs.js';

const ctx = serviceContext(Astro);
const me = Astro.locals.user;
const creatable = can(me, 'proveedores.create');
const editable = can(me, 'proveedores.edit');
const seesContracts = can(me, 'contratos');
let error = null;
let errors = {};
let v = { status: 'activo' };
let openNew = Astro.url.searchParams.has('nuevo');
let similar = [];

if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};
  const r = input.intent === 'create' ? await suppliers.create(ctx, input)
    : input.intent === 'add_type' ? await suppliers.addType(ctx, input)
      : input.intent === 'delete_type' ? await suppliers.removeType(ctx, parseId(input.type_id))
        : { ok: false, code: 'forbidden' };
  if (r.ok) {
    if (input.intent === 'create') return Astro.redirect(`/proveedores/${r.value.id}?ok=creado`, 303);
    return Astro.redirect(`/proveedores?ok=${input.intent === 'add_type' ? 'creado' : 'borrado'}#tipos`, 303);
  }
  const back = failure(Astro, r, '/proveedores');
  if (back) return back;
  error = r.message;
  errors = r.fields;
  if (input.intent === 'create') {
    openNew = true;
    v = input;
    // Si se parece a alguno, se enseñan y hay que confirmar que es otro (con el mismo nombre escrito)
    similar = r.similar ?? [];
  }
}

// La tabla: buscador, filtros, orden, página y las columnas que ha elegido cada persona
const def = TABLES.proveedores;
const state = tableState(def, Astro.url.searchParams, { prefs: await prefs.forTable(ctx, 'proveedores'), can: (p) => can(me, p) });
const dir = await suppliers.directory(ctx, {
  q: state.q, typeId: parseId(state.filters.tipo), status: state.filters.estado ?? '', city: state.filters.ciudad ?? '',
  order: state.sort, dir: state.dir, limit: state.per, offset: state.offset,
});
if (!dir.ok) return failure(Astro, dir, '/');
const { rows, total, sums, types, cities, year, money } = dir.value;
const info = pageInfo(total, state);
if (state.page > info.last) return Astro.redirect(hrefWith(Astro.url, { pagina: info.last }), 303);
const has = (k) => shows(state, k);
const L = Object.fromEntries(def.columns.map((c) => [c.key, c.label])); // la etiqueta de cada dato en el móvil
const contractList = seesContracts && has('contrato') ? await contracts.list(ctx) : seesContracts ? await contracts.due(ctx) : null;
const allContracts = contractList?.ok ? contractList.value : [];
// El contrato que más importa de cada proveedor (vienen ordenados: primero lo que requiere atención, luego lo vigente)
const contractOf = new Map();
for (const c of allContracts) if (!contractOf.has(c.supplier_id)) contractOf.set(c.supplier_id, c);
const due = allContracts.filter((c) => c.state.attention).length;
const filtered = isFiltered(state);
const filters = [
  { ...def.filters[0], options: types.map((t) => [t.id, t.name]) },
  { ...def.filters[1], options: Object.entries(SUPPLIER_STATUS) },
  { ...def.filters[2], options: cities.map((c) => [c, c]) },
];
---
<App title="Proveedores" section="proveedores" error={error} fieldErrors={errors} origin="Proveedores">
  <div class="page-top">
    <div>
      <h1>Proveedores</h1>
      <p>Hoteles, venues, restaurantes y el resto: con quién trabajamos{money && ' y cuánto contratamos'}</p>
    </div>
    {seesContracts && <a class="btn btn-ghost" href="/proveedores/contratos"><Icon name="file-text" size={18} /> Contratos</a>}
  </div>

  {seesContracts && due > 0 && (
    <a class="banner-link" href="/proveedores/contratos?ver=atencion">
      <Icon name="triangle-alert" />
      <span><strong>{due} {due === 1 ? 'contrato requiere' : 'contratos requieren'} atención</strong> · próximos a caducar, pendientes de renovación o caducados sin renovar</span>
      <Icon name="chevron-right" class="chev" />
    </a>
  )}

  {creatable && (
    <details class="add" open={openNew}>
      <summary class="btn btn-primary"><Icon name="plus" size={18} /> <span class="when-closed">Nuevo proveedor</span><span class="when-open">Cerrar formulario</span></summary>
      <form method="post" class="form-section">
        <h2><Icon name="briefcase" /> Nuevo proveedor</h2>
        <p class="muted">Lo básico; el resto se completa en su ficha. Antes, búscalo en la lista: si ya está, no lo des de alta otra vez.</p>
        <SupplierFields v={v} errors={errors} types={types} />
        {similar.length > 0 && (
          <div class="picker-similar">
            <p><Icon name="triangle-alert" size={18} /> Ya hay proveedores con un nombre parecido. ¿Es alguno de estos?</p>
            <ul>
              {similar.map((x) => (
                <li>
                  <span><a href={`/proveedores/${x.id}`}><strong>{x.name}</strong></a> <span class="picker-meta">{[x.type, x.city, x.via && `antes «${x.via}»`].filter(Boolean).join(' · ')}</span></span>
                  {x.status !== 'activo' && <span class:list={['pill', x.status === 'bloqueado' ? 'pill-danger' : 'pill-muted']}>{SUPPLIER_STATUS[x.status]}</span>}
                </li>
              ))}
            </ul>
            <label class="check"><input type="checkbox" name="confirm_similar" value={cleanName(v.name)} /> No es ninguno de estos: es un proveedor distinto</label>
          </div>
        )}
        <div><button class="btn btn-primary" type="submit" name="intent" value="create" data-busy="Guardando…"><Icon name="check" size={18} /> Dar de alta</button></div>
      </form>
    </details>
  )}

  <TableTools def={def} state={state} filters={filters} url={Astro.url}>
    {plural(total, 'proveedor', 'proveedores')}{filtered && ' con esos filtros'}
    {money && total > 0 && <> · contratado en {year}: <b class="money">{eur(sums.this_year)}</b> · en total: <b class="money">{eur(sums.contracted)}</b> <span class="small">(sin IVA, eventos no cancelados)</span></>}
  </TableTools>

  {!rows.length ? (
    <div class="empty mt">
      <p>{filtered ? 'Ningún proveedor con esos filtros.' : 'Todavía no hay proveedores. Se dan de alta con «Nuevo proveedor» o al elegir el proveedor de un pago.'}</p>
    </div>
  ) : state.view === 'tarjetas' ? (
    <ul class="list mt suppliers-list">
      {rows.map((r) => {
        const c = contractOf.get(r.id);
        return (
          <li>
            <a class="item is-row" href={`/proveedores/${r.id}`}>
              <div class="item-body">
                <span class="item-title">{r.name}</span>
                <span class="item-meta">
                  {r.type && <span><strong>{r.type}</strong></span>}
                  {r.city && <span>{r.city}</span>}
                  {r.contact_name && <span>{r.contact_name}</span>}
                  {r.phone && <span>{r.phone}</span>}
                </span>
                <span class="item-flags">
                  {r.status !== 'activo' && <span class:list={['pill', r.status === 'bloqueado' ? 'pill-danger' : 'pill-muted']}>{SUPPLIER_STATUS[r.status]}</span>}
                  <span class="pill pill-muted">{r.exps ? plural(r.exps, 'expediente', 'expedientes') : 'Sin expedientes'}</span>
                  {r.last_date && <span class="pill pill-muted">Último: {formatDate(r.last_date)}</span>}
                  {c && <Pill state={{ ...c.state, label: `Contrato · ${c.state.label}` }} />}
                </span>
              </div>
              {money && (
                <div class="item-amount">
                  <span class="big-money money">{eur(r.contracted)}</span>
                  <small>contratado · {eur(r.this_year)} en {year}</small>
                </div>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  ) : (
    <div class="table-scroll mt">
      <table class="dtable suppliers is-listing">
        <thead>
          <tr>
            {state.columns.filter((c) => has(c.key)).map((c) => <SortTh col={c} state={state} url={Astro.url} />)}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class:list={{ 'is-planned': r.status !== 'activo' }} data-href={`/proveedores/${r.id}`}>
              <td>
                <a href={`/proveedores/${r.id}`}><strong>{r.name}</strong></a>
                {r.status !== 'activo' && <span class:list={['pill', r.status === 'bloqueado' ? 'pill-danger' : 'pill-muted']}>{SUPPLIER_STATUS[r.status]}</span>}
              </td>
              {has('tipo') && <td data-label={L.tipo}>{r.type ?? '—'}</td>}
              {has('ciudad') && <td data-label={L.ciudad}>{r.city ?? '—'}</td>}
              {has('contacto') && <td data-label={L.contacto}>{r.contact_name ?? '—'}</td>}
              {has('telefono') && <td data-label={L.telefono}>{r.phone ?? '—'}</td>}
              {has('email') && <td data-label={L.email}>{r.email ? <a href={`mailto:${r.email}`}>{r.email}</a> : '—'}</td>}
              {has('expedientes') && <td data-label={L.expedientes} class="num">{r.exps}</td>}
              {has('uso') && <td data-label={L.uso}>{r.last_date ? formatDate(r.last_date) : '—'}</td>}
              {has('contrato') && <td data-label={L.contrato}>{(() => { const c = contractOf.get(r.id); return c ? <a class="contract-cell" href={`/proveedores/${r.id}/contratos/${c.id}`}><Pill state={c.state} /><span class="small muted">{c.state.text}</span></a> : <span class="muted">—</span>; })()}</td>}
              {has('altas') && <td data-label={L.altas}>{formatDate(r.created_at.slice(0, 10))}</td>}
              {has('year') && <td data-label={L.year} class="num money">{eur(r.this_year)}</td>}
              {has('gasto') && <td data-label={L.gasto} class="num money">{eur(r.contracted)}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <Pager info={info} url={Astro.url} noun={def.noun} />

  {editable && (
    <section class="card mt" id="tipos">
      <h2>Tipos de proveedor</h2>
      <p class="muted small">Se pueden añadir los que hagan falta. Un tipo sólo se puede quitar si ningún proveedor lo tiene.</p>
      <ul class="type-list">
        {types.map((t) => (
          <li>
            <span>{t.name} <span class="muted small">({t.n})</span></span>
            {t.n === 0 && (
              <form method="post">
                <input type="hidden" name="type_id" value={t.id} />
                <button class="btn btn-ghost btn-sm" type="submit" name="intent" value="delete_type" aria-label={`Quitar el tipo ${t.name}`}><Icon name="x" size={14} /></button>
              </form>
            )}
          </li>
        ))}
      </ul>
      <form method="post" class="quick-form mt">
        <label class="visually-hidden" for="type_name">Tipo nuevo</label>
        <input id="type_name" name="type_name" type="text" maxlength="40" placeholder="Tipo nuevo (p. ej. Guías)" required />
        <button class="btn btn-ghost btn-sm" type="submit" name="intent" value="add_type"><Icon name="plus" size={16} /> Añadir tipo</button>
      </form>
    </section>
  )}
</App>
