---
// Usuarios y permisos · Un rol: nombre, descripción y permisos (por áreas), quién lo tiene y borrarlo.
// Los permisos se guardan normalizados (sin los que necesitan otro que no está marcado) y el cambio
// queda en el registro. Vale al momento: los permisos se leen en cada petición.
import { env } from 'cloudflare:workers';
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import { deny, parseId, readForm, actor, logActivity } from '../../../lib/app.js';
import { RoleSchema, validate, formToObject } from '../../../lib/validate.js';
import { AREAS, REQUIRES, normalizePermissions, permissionDiff, permissionLabel } from '../../../lib/permissions.js';
import { loadRoles, keepsAManager, LAST_MANAGER } from '../../../lib/users.js';

const denied = deny(Astro, 'users');
if (denied) return denied;

const db = env.DB;
const id = parseId(Astro.params.id);
const roles = id ? await loadRoles(db) : [];
const role = roles.find((r) => r.id === id);
if (!role) return Astro.rewrite('/404');

let error = null;
let errors = {};
let notice = null;
let v = { name: role.name, description: role.description ?? '' };
let checked = new Set(role.permissions);

if (Astro.request.method === 'POST') {
  const who = actor(Astro);
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};

  if (input.intent === 'delete') {
    if (role.system) error = 'Los roles iniciales no se pueden borrar (sí se pueden cambiar sus permisos).';
    else if (role.users) error = `Este rol lo tienen ${role.users} ${role.users === 1 ? 'persona' : 'personas'}: cámbiales el rol antes de borrarlo.`;
    else if (role.invites) error = 'Hay invitaciones sin usar con este rol: anúlalas antes de borrarlo.';
    else {
      await db.batch([
        db.prepare('DELETE FROM invites WHERE role_id = ?').bind(id), // usadas, anuladas o caducadas
        db.prepare('DELETE FROM roles WHERE id = ?').bind(id),
      ]);
      await logActivity(db, who, null, 'role.delete', `borró el rol ${role.name}`);
      return Astro.redirect('/usuarios/roles?ok=borrado', 303);
    }
  } else if (input.intent === 'save') {
    const parsed = validate(RoleSchema, input);
    const wanted = form ? form.getAll('permissions').map(String) : [];
    const { permissions, dropped } = normalizePermissions(wanted);
    v = input;
    checked = new Set(permissions);
    if (!parsed.ok) {
      error = parsed.message;
      errors = parsed.errors;
    } else if (roles.some((r) => r.id !== id && r.name.toLowerCase() === parsed.data.name.toLowerCase())) {
      error = 'Ya hay otro rol con ese nombre.';
      errors = { name: error };
    } else if (role.permissions.includes('users') && !permissions.includes('users')
      && !(await keepsAManager(db, { roleId: id, hasUsersPerm: false }))) {
      error = LAST_MANAGER;
    } else {
      const { added, removed } = permissionDiff(role.permissions, permissions);
      await db.batch([
        db.prepare("UPDATE roles SET name = ?, description = ?, updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') WHERE id = ?")
          .bind(parsed.data.name, parsed.data.description, id),
        db.prepare('DELETE FROM role_permissions WHERE role_id = ?').bind(id),
        ...permissions.map((p) => db.prepare('INSERT INTO role_permissions (role_id, permission) VALUES (?, ?)').bind(id, p)),
      ]);
      const changes = [
        parsed.data.name !== role.name && `le cambió el nombre a ${parsed.data.name}`,
        added.length && `le dio ${added.map((k) => `«${permissionLabel(k)}»`).join(', ')}`,
        removed.length && `le quitó ${removed.map((k) => `«${permissionLabel(k)}»`).join(', ')}`,
      ].filter(Boolean);
      if (changes.length) await logActivity(db, who, null, 'role.update', `cambió el rol ${role.name}: ${changes.join('; ')}`);
      const qs = dropped.length ? `&sin=${encodeURIComponent(dropped.join(','))}` : '';
      return Astro.redirect(`/usuarios/roles/${id}?ok=guardado${qs}`, 303);
    }
  }
  if (error) Astro.response.status = 400;
}

// Al guardar se quitan los permisos que necesitan otro que no estaba marcado: se avisa de cuáles
const droppedNow = (Astro.url.searchParams.get('sin') ?? '').split(',').filter(Boolean);
if (droppedNow.length) {
  notice = `No se han guardado ${droppedNow.map((k) => `«${permissionLabel(k)}»`).join(', ')}: necesitan otro permiso que no estaba marcado.`;
}
const { results: people } = await db.prepare('SELECT id, name, active FROM users WHERE role_id = ? ORDER BY active DESC, name').bind(id).all();
---
<App title={`Rol · ${role.name}`} section="usuarios" error={error} notice={notice} fieldErrors={errors}>
  <div class="crumbs">
    <nav aria-label="Estás en">
      <ol>
        <li><a href="/usuarios"><Icon name="arrow-left" size={16} class="crumb-arrow" />Usuarios y permisos</a></li>
        <li class="is-parent"><a href="/usuarios/roles"><Icon name="arrow-left" size={16} class="crumb-arrow" />Roles y permisos</a></li>
        <li><span aria-current="page">{role.name}</span></li>
      </ol>
    </nav>
  </div>
  <div class="page-top">
    <div>
      <h1>{role.name}</h1>
      <p>{role.description ?? 'Rol sin descripción'} · {people.length} {people.length === 1 ? 'persona' : 'personas'}</p>
    </div>
  </div>

  <form method="post" class="form">
    <section class="form-section">
      <h2><Icon name="key-round" /> Datos del rol</h2>
      <div class="row row-2">
        <div class="field">
          <label for="name">Nombre</label>
          <input id="name" name="name" type="text" maxlength="40" required value={v.name} />
        </div>
        <div class="field">
          <label for="description">Para qué sirve <span class="opt">(opcional)</span></label>
          <input id="description" name="description" type="text" maxlength="160" value={v.description ?? ''} />
        </div>
      </div>
    </section>

    {AREAS.map((area) => (
      <section class="form-section perm-area" role="group" aria-labelledby={`area-${area.key}`}>
        <h2 id={`area-${area.key}`}>{area.label}</h2>
        {area.permissions.map((p) => (
          <label class="check">
            <input type="checkbox" name="permissions" value={p.key} checked={checked.has(p.key)} data-requires={REQUIRES[p.key]} />
            <span>
              <strong>{p.label}</strong>
              {p.help && <span>{p.help}</span>}
              {REQUIRES[p.key] && <span class="small">Necesita «{permissionLabel(REQUIRES[p.key])}».</span>}
            </span>
          </label>
        ))}
      </section>
    ))}

    <div class="actions">
      <button class="btn btn-primary" type="submit" name="intent" value="save" data-busy="Guardando…"><Icon name="check" size={18} /> Guardar el rol</button>
      <a class="btn btn-ghost" href="/usuarios/roles">Cancelar</a>
    </div>
  </form>

  <h2 class="section-title">Personas con este rol</h2>
  {people.length ? (
    <ul class="list">
      {people.map((u) => (
        <li><a class:list={['item is-row', { 'is-muted': !u.active }]} href={`/usuarios#u${u.id}`}>
          <div class="item-body"><span class="item-title">{u.name}{!u.active && <span class="pill pill-danger">Desactivada</span>}</span></div>
          <Icon name="chevron-right" size={20} class="chev" />
        </a></li>
      ))}
    </ul>
  ) : <p class="muted">Nadie tiene este rol todavía. Se asigna desde <a href="/usuarios">Personas</a>.</p>}

  {!role.system && (
    <form method="post" class="mt">
      <button class="btn btn-danger btn-sm" type="submit" name="intent" value="delete"
        data-confirm={`¿Borrar el rol ${role.name}? Sólo se puede si nadie lo tiene.`}><Icon name="trash-2" size={16} /> Borrar el rol</button>
    </form>
  )}
</App>

<script>
  // Al desmarcar un permiso, se desmarcan los que dependen de él; al marcar uno, se marca su base
  const boxes = [...document.querySelectorAll('input[name="permissions"]')];
  const byKey = new Map(boxes.map((b) => [b.value, b]));
  for (const box of boxes) {
    box.addEventListener('change', () => {
      if (box.checked) {
        for (let base = byKey.get(box.dataset.requires ?? ''); base; base = byKey.get(base.dataset.requires ?? '')) base.checked = true;
      } else {
        const off = new Set([box.value]);
        let grew = true;
        while (grew) {
          grew = false;
          for (const b of boxes) {
            if (b.checked && off.has(b.dataset.requires ?? '')) { b.checked = false; off.add(b.value); grew = true; }
          }
        }
      }
    });
  }
</script>
