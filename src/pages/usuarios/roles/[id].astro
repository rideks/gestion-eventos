---
// Usuarios y permisos · Un rol: nombre, descripción y permisos (por áreas), quién lo tiene y borrarlo.
// Al guardar sólo cambia lo que se ha cambiado en la pantalla (src/services/roles.js): se envían los permisos que
// había al abrirla (original) y los marcados, y el servicio aplica la diferencia sobre lo guardado. Nada se quita
// a escondidas: si un permiso se queda sin el suyo de base, no se guarda y se explica; en la pantalla, desmarcar
// uno del que dependen otros pide confirmación. «Guardar» sólo se activa si hay cambios sin guardar.
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import { parseId, readForm } from '../../../lib/app.js';
import { formToObject } from '../../../lib/validate.js';
import { AREAS, REQUIRES, permissionLabel } from '../../../lib/permissions.js';
import { serviceContext, failure } from '../../../services/context.js';
import * as roles from '../../../services/roles.js';

const ctx = serviceContext(Astro);
const id = parseId(Astro.params.id);
const r = id ? await roles.detail(ctx, id) : { ok: false, code: 'not_found' };
if (!r.ok) return failure(Astro, r, '/');
const { role, people } = r.value;

let error = null;
let errors = {};
let v = { name: role.name, description: role.description ?? '' };
let checked = new Set(role.permissions);
let original = role.permissions;

if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};
  let res;
  if (input.intent === 'delete') {
    res = await roles.remove(ctx, id);
    if (res.ok) return Astro.redirect('/usuarios/roles?ok=borrado', 303);
  } else if (input.intent === 'save') {
    const wanted = form ? form.getAll('permissions').map(String) : [];
    original = typeof input.original === 'string' ? input.original.split(',').filter(Boolean) : null;
    res = await roles.save(ctx, id, input, { wanted, original });
    if (res.ok) return Astro.redirect(`/usuarios/roles/${id}?ok=guardado`, 303);
    // Lo que se había cambiado sigue en la pantalla (y «Guardar» sigue activo)
    v = input;
    checked = new Set(wanted);
    original ??= role.permissions;
  } else {
    res = { ok: false, code: 'invalid', message: 'Acción no válida.', fields: {} };
  }
  const back = failure(Astro, res, `/usuarios/roles/${id}`);
  if (back) return back;
  error = res.message;
  errors = res.fields ?? {};
}
// Lo guardado, para saber en la pantalla si hay cambios sin guardar
const saved = JSON.stringify({ name: role.name, description: role.description ?? '', permissions: [...role.permissions].sort() });
---
<App title={`Rol · ${role.name}`} section="usuarios" error={error} fieldErrors={errors}>
  <div class="crumbs">
    <nav aria-label="Estás en">
      <ol>
        <li><a href="/usuarios"><Icon name="arrow-left" size={16} class="crumb-arrow" />Usuarios y permisos</a></li>
        <li class="is-parent"><a href="/usuarios/roles"><Icon name="arrow-left" size={16} class="crumb-arrow" />Roles y permisos</a></li>
        <li><span aria-current="page">{role.name}</span></li>
      </ol>
    </nav>
  </div>
  <div class="page-top">
    <div>
      <h1>{role.name}</h1>
      <p>{role.description ?? 'Rol sin descripción'} · {people.length} {people.length === 1 ? 'persona' : 'personas'}</p>
    </div>
  </div>

  <form method="post" class="form" autocomplete="off" data-role-form data-saved={saved}>
    <input type="hidden" name="original" value={original.join(',')} />
    <section class="form-section">
      <h2><Icon name="key-round" /> Datos del rol</h2>
      <div class="row row-2">
        <div class="field">
          <label for="name">Nombre</label>
          <input id="name" name="name" type="text" maxlength="40" required value={v.name} />
        </div>
        <div class="field">
          <label for="description">Para qué sirve <span class="opt">(opcional)</span></label>
          <input id="description" name="description" type="text" maxlength="160" value={v.description ?? ''} />
        </div>
      </div>
    </section>

    {AREAS.map((area) => (
      <section class="form-section perm-area" role="group" aria-labelledby={`area-${area.key}`}>
        <h2 id={`area-${area.key}`}>{area.label}</h2>
        {area.permissions.map((p) => (
          <label class="check">
            <input type="checkbox" name="permissions" value={p.key} checked={checked.has(p.key)} data-requires={REQUIRES[p.key]} />
            <span>
              <strong>{p.label}</strong>
              {p.help && <span>{p.help}</span>}
              {REQUIRES[p.key] && <span class="small">Necesita «{permissionLabel(REQUIRES[p.key])}».</span>}
            </span>
          </label>
        ))}
      </section>
    ))}

    <div class="actions save-bar" data-save-bar>
      <button class="btn btn-primary" type="submit" name="intent" value="save" data-busy="Guardando…" data-save><Icon name="check" size={18} /> Guardar el rol</button>
      <a class="btn btn-ghost" href={`/usuarios/roles/${id}`} data-discard hidden>Descartar los cambios</a>
      <a class="btn btn-ghost" href="/usuarios/roles">Volver a los roles</a>
      <span class="save-state" data-save-state role="status" aria-live="polite"></span>
    </div>
  </form>

  <h2 class="section-title">Personas con este rol</h2>
  {people.length ? (
    <ul class="list">
      {people.map((u) => (
        <li><a class:list={['item is-row', { 'is-muted': !u.active }]} href={`/usuarios#u${u.id}`}>
          <div class="item-body"><span class="item-title">{u.name}{!u.active && <span class="pill pill-danger">Desactivada</span>}</span></div>
          <Icon name="chevron-right" size={20} class="chev" />
        </a></li>
      ))}
    </ul>
  ) : <p class="muted">Nadie tiene este rol todavía. Se asigna desde <a href="/usuarios">Personas</a>.</p>}

  {!role.system && (
    <form method="post" class="mt">
      <button class="btn btn-danger btn-sm" type="submit" name="intent" value="delete"
        data-confirm={`¿Borrar el rol ${role.name}? Sólo se puede si nadie lo tiene.`}><Icon name="trash-2" size={16} /> Borrar el rol</button>
    </form>
  )}
</App>

<script>
  const form = document.querySelector('form[data-role-form]');
  if (form instanceof HTMLFormElement) {
    const boxes = [...form.querySelectorAll('input[name="permissions"]')].filter((b) => b instanceof HTMLInputElement);
    const byKey = new Map(boxes.map((b) => [b.value, b]));
    const label = (b) => b.closest('label')?.querySelector('strong')?.textContent ?? b.value;
    // Los que dependen (directa o indirectamente) de un permiso y están marcados
    const dependents = (box) => {
      const off = new Set([box.value]);
      const out = [];
      let grew = true;
      while (grew) {
        grew = false;
        for (const b of boxes) {
          if (b.checked && !off.has(b.value) && off.has(b.dataset.requires ?? '')) { off.add(b.value); out.push(b); grew = true; }
        }
      }
      return out;
    };
    // Desmarcar uno del que dependen otros pide confirmación (la ventana común de data-confirm)
    const syncConfirms = () => {
      for (const b of boxes) {
        const deps = b.checked ? dependents(b) : [];
        if (deps.length) {
          b.dataset.confirm = `Al quitar «${label(b)}» también se quitan los que lo necesitan: ${deps.map((d) => `«${label(d)}»`).join(', ')}. ¿Quitarlos?`;
          b.dataset.confirmOk = deps.length === 1 ? 'Quitar los dos' : `Quitar los ${deps.length + 1}`;
        } else {
          delete b.dataset.confirm;
          delete b.dataset.confirmOk;
        }
      }
    };
    for (const box of boxes) {
      box.addEventListener('change', () => {
        if (box.checked) {
          // Marcar uno marca también el que necesita
          for (let base = byKey.get(box.dataset.requires ?? ''); base; base = byKey.get(base.dataset.requires ?? '')) base.checked = true;
        } else {
          for (const d of dependents(box)) d.checked = false;
        }
        syncConfirms();
        update();
      });
    }

    // ¿Hay cambios sin guardar? Se compara con lo guardado: «Guardar» sólo se activa si los hay
    const saved = JSON.parse(form.dataset.saved ?? '{}');
    const save = form.querySelector('[data-save]');
    const discard = form.querySelector('[data-discard]');
    const state = form.querySelector('[data-save-state]');
    const justSaved = new URLSearchParams(location.search).get('ok') === 'guardado';
    const current = () => ({
      name: String(form.elements.namedItem('name')?.value ?? '').trim(),
      description: String(form.elements.namedItem('description')?.value ?? '').trim(),
      permissions: boxes.filter((b) => b.checked).map((b) => b.value).sort(),
    });
    let dirty = false;
    function update() {
      dirty = JSON.stringify(current()) !== JSON.stringify(saved);
      if (save instanceof HTMLButtonElement) save.disabled = !dirty;
      if (discard instanceof HTMLElement) discard.hidden = !dirty;
      if (state) {
        state.textContent = dirty ? 'Hay cambios sin guardar' : justSaved ? 'Guardado: no hay cambios pendientes' : 'Sin cambios';
        state.className = `save-state ${dirty ? 'is-dirty' : justSaved ? 'is-saved' : ''}`;
      }
    }
    form.addEventListener('input', update);
    form.addEventListener('submit', () => { dirty = false; });
    window.addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });
    // Al volver con «Atrás», la página guardada en memoria puede no estar al día: se vuelve a pedir
    window.addEventListener('pageshow', (e) => { if (e.persisted) location.reload(); });
    syncConfirms();
    update();
  }
</script>
