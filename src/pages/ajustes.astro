---
// Ajustes (sólo Administración): los tipos de IVA que salen en todos los desplegables,
// el primer número de expediente y la facturación al cliente (formato y próximo nº de factura,
// datos de la empresa que salen en las facturas).
import { env } from 'cloudflare:workers';
import App from '../layouts/App.astro';
import Icon from '../components/Icon.astro';
import { deny, readForm, actor, logActivity } from '../lib/app.js';
import { VatRateSchema, FirstNumberSchema, InvoiceSettingsSchema, validate, formToObject } from '../lib/validate.js';
import { invoiceSettings, peekInvoiceNumber, patternProblem, counterKey, nextSeq, formatInvoiceNumber, yearly } from '../lib/invoicing.js';
import { today } from '../lib/dates.js';
import { loadRates, pctText } from '../lib/vat.js';
import { suggestNumber } from '../lib/data.js';

const denied = deny(Astro, 'settings');
if (denied) return denied;

const db = env.DB;
const year = Number(today().slice(0, 4));
let error = null;
let errors = {};
let v = {};

if (Astro.request.method === 'POST') {
  const who = actor(Astro);
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};
  const id = Number(input.id);

  if (input.intent === 'add_rate') {
    v = input;
    const parsed = validate(VatRateSchema, input);
    if (!parsed.ok) {
      error = parsed.message;
      errors = parsed.errors;
    } else if (await db.prepare('SELECT 1 FROM vat_rates WHERE label = ? COLLATE NOCASE').bind(parsed.data.label).first()) {
      error = `Ya hay un tipo que se llama «${parsed.data.label}».`;
      errors = { label: error };
    } else {
      await db.prepare('INSERT INTO vat_rates (label, rate_bp) VALUES (?, ?)').bind(parsed.data.label, parsed.data.rate).run();
      await logActivity(db, who, null, 'settings.vat', `añadió el tipo de IVA ${parsed.data.label}`);
      return Astro.redirect('/ajustes?ok=creado', 303);
    }
  } else if (input.intent === 'default' && Number.isInteger(id)) {
    await db.batch([
      db.prepare('UPDATE vat_rates SET is_default = 0'),
      db.prepare('UPDATE vat_rates SET is_default = 1 WHERE id = ?').bind(id),
    ]);
    return Astro.redirect('/ajustes?ok=guardado', 303);
  } else if (input.intent === 'delete' && Number.isInteger(id)) {
    const rate = await db.prepare('SELECT id, label, is_default FROM vat_rates WHERE id = ?').bind(id).first();
    const { n } = await db.prepare('SELECT COUNT(*) AS n FROM vat_rates').first();
    if (!rate) {
      error = 'Ese tipo ya no existe.';
    } else if (n <= 1) {
      error = 'Tiene que quedar al menos un tipo de IVA.';
    } else {
      await db.batch([
        db.prepare('DELETE FROM vat_rates WHERE id = ?').bind(id),
        // Si era el de por defecto, pasa a serlo el más alto que quede
        ...(rate.is_default ? [db.prepare('UPDATE vat_rates SET is_default = 1 WHERE id = (SELECT id FROM vat_rates ORDER BY rate_bp DESC LIMIT 1)')] : []),
      ]);
      await logActivity(db, who, null, 'settings.vat', `quitó el tipo de IVA ${rate.label}`);
      return Astro.redirect('/ajustes?ok=borrado', 303);
    }
  } else if (input.intent === 'invoicing') {
    v = input;
    const parsed = validate(InvoiceSettingsSchema, input);
    const bad = parsed.ok ? patternProblem(parsed.data.invoice_pattern) : null;
    if (!parsed.ok) {
      error = parsed.message;
      errors = parsed.errors;
    } else if (bad) {
      error = bad;
      errors = { invoice_pattern: bad };
    } else {
      const d = parsed.data;
      // No se puede volver a un número ya usado: la numeración tiene que ser correlativa y sin repetir
      const { results } = await db.prepare('SELECT number FROM invoices WHERE number IS NOT NULL').all();
      const lowest = nextSeq({ pattern: d.invoice_pattern, year, numbers: results.map((r) => r.number) });
      if (d.invoice_next < lowest) {
        error = `Próximo número: ya hay facturas hasta la ${formatInvoiceNumber(d.invoice_pattern, lowest - 1, year)}; tiene que ser ${lowest} o más.`;
        errors = { invoice_next: error };
      } else {
        const upsert = (key, value) => db.prepare(
          "INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT (key) DO UPDATE SET value = excluded.value, updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now')",
        ).bind(key, String(value ?? ''));
        await db.batch([
          upsert('invoice_pattern', d.invoice_pattern),
          upsert(counterKey(d.invoice_pattern, year), d.invoice_next),
          upsert('company_legal_name', d.company_legal_name),
          upsert('company_tax_id', d.company_tax_id),
          upsert('company_address', d.company_address),
          upsert('company_iban', d.company_iban),
          upsert('company_email', d.company_email),
        ]);
        await logActivity(db, who, null, 'settings.invoicing', `cambió la facturación: próxima factura ${formatInvoiceNumber(d.invoice_pattern, d.invoice_next, year)}`);
        return Astro.redirect('/ajustes?ok=guardado#facturacion', 303);
      }
    }
  } else if (input.intent === 'first_number') {
    const parsed = validate(FirstNumberSchema, input);
    if (!parsed.ok) {
      error = parsed.message;
      errors = parsed.errors;
    } else {
      await db.prepare(
        "INSERT INTO settings (key, value) VALUES ('first_number', ?) ON CONFLICT (key) DO UPDATE SET value = excluded.value, updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now')",
      ).bind(String(parsed.data.first_number)).run();
      return Astro.redirect('/ajustes?ok=guardado', 303);
    }
  }
  if (error) Astro.response.status = 400;
}

const [rates, first, next, billing, nextInvoice] = await Promise.all([
  loadRates(db),
  db.prepare("SELECT value FROM settings WHERE key = 'first_number'").first().then((r) => r?.value ?? '1001'),
  suggestNumber(db),
  invoiceSettings(db),
  peekInvoiceNumber(db, year),
]);
---
<App title="Ajustes" section="ajustes" error={error} fieldErrors={errors}>
  <div class="page-top">
    <div>
      <h1>Ajustes</h1>
      <p>Lo que comparte toda la aplicación</p>
    </div>
  </div>

  <section class="form-section">
    <h2><Icon name="receipt" /> Tipos de IVA</h2>
    <p class="muted">Salen en todos los importes (presupuestos, pagos a proveedores, facturas) y en los pagos previstos.
      El de <strong>por defecto</strong> es el que aparece marcado al empezar. Quitar un tipo no cambia lo que ya está guardado con él.</p>
    <ul class="list">
      {rates.map((r) => (
        <li class="item">
          <div class="item-body">
            <span class="item-title">{r.label}</span>
            <span class="item-meta"><span>{pctText(r.rate_bp)} %</span></span>
          </div>
          <div class="item-actions">
            {r.is_default
              ? <span class="pill pill-gold">Por defecto</span>
              : (
                <form method="post">
                  <input type="hidden" name="id" value={r.id} />
                  <button class="btn btn-ghost btn-sm" type="submit" name="intent" value="default">Por defecto</button>
                </form>
              )}
            <form method="post">
              <input type="hidden" name="id" value={r.id} />
              <button class="btn btn-danger btn-sm" type="submit" name="intent" value="delete" data-confirm={`¿Quitar «${r.label}» de la lista?`} data-confirm-ok="Quitar" aria-label={`Quitar ${r.label}`}><Icon name="trash-2" size={16} /></button>
            </form>
          </div>
        </li>
      ))}
    </ul>
    <form method="post" class="form">
      <div class="row row-3">
        <div class:list={['field', { 'has-error': errors.label }]}>
          <label for="label">Nombre</label>
          <input id="label" name="label" type="text" required maxlength="40" value={v.label ?? ''} placeholder="IGIC 3 %" />
        </div>
        <div class:list={['field', { 'has-error': errors.rate }]}>
          <label for="rate">Porcentaje</label>
          <input id="rate" name="rate" type="text" inputmode="decimal" required value={v.rate ?? ''} placeholder="3 o 9,5" />
        </div>
        <div class="field">
          <span class="label" aria-hidden="true">&nbsp;</span>
          <button class="btn btn-primary" type="submit" name="intent" value="add_rate"><Icon name="plus" size={18} /> Añadir tipo</button>
        </div>
      </div>
    </form>
  </section>

  <form method="post" class="form-section mt" id="facturacion">
    <h2><Icon name="receipt" /> Facturas al cliente</h2>
    <p class="muted">El número se asigna solo al emitir cada factura, correlativo y sin repetir. La próxima será la <strong>{nextInvoice.number}</strong>.{yearly(billing.pattern) && ' Como el formato lleva el año, cada año vuelve a empezar en 1.'}</p>
    <div class="row row-2">
      <div class:list={['field', { 'has-error': errors.invoice_pattern }]}>
        <label for="invoice_pattern">Formato del número</label>
        <input id="invoice_pattern" name="invoice_pattern" type="text" required maxlength="40" value={v.invoice_pattern ?? billing.pattern} />
        <p class="hint">{'{n}'} el número (6 cifras) · {'{yy}'} el año con 2 cifras · {'{yyyy}'} con 4. Ej.: G/{'{n}'}/{'{yy}'}/01 → G/000904/26/01.</p>
      </div>
      <div class:list={['field', { 'has-error': errors.invoice_next }]}>
        <label for="invoice_next">Próximo número ({year})</label>
        <input id="invoice_next" name="invoice_next" type="number" min="1" inputmode="numeric" required value={v.invoice_next ?? nextInvoice.seq} />
        <p class="hint">Para seguir la numeración que ya lleváis. No puede ser uno ya usado.</p>
      </div>
    </div>
    <h3 class="form-sub"><Icon name="building" size={18} /> Datos de la empresa en las facturas</h3>
    <div class="row row-2">
      <div class:list={['field', { 'has-error': errors.company_legal_name }]}>
        <label for="company_legal_name">Razón social</label>
        <input id="company_legal_name" name="company_legal_name" type="text" maxlength="120" value={v.company_legal_name ?? billing.company.name} placeholder="Seven Worlds Events & Congresses, S.L." />
      </div>
      <div class:list={['field', { 'has-error': errors.company_tax_id }]}>
        <label for="company_tax_id">CIF</label>
        <input id="company_tax_id" name="company_tax_id" type="text" maxlength="20" value={v.company_tax_id ?? billing.company.taxId} placeholder="B12345678" />
      </div>
    </div>
    <div class:list={['field', { 'has-error': errors.company_address }]}>
      <label for="company_address">Dirección fiscal</label>
      <input id="company_address" name="company_address" type="text" maxlength="300" value={v.company_address ?? billing.company.address} placeholder="Calle…, 28001 Madrid" />
    </div>
    <div class="row row-2">
      <div class:list={['field', { 'has-error': errors.company_iban }]}>
        <label for="company_iban">IBAN para los cobros</label>
        <input id="company_iban" name="company_iban" type="text" maxlength="40" value={v.company_iban ?? billing.company.iban} placeholder="ES00 0000 0000 0000 0000 0000" />
      </div>
      <div class:list={['field', { 'has-error': errors.company_email }]}>
        <label for="company_email">Email de facturación</label>
        <input id="company_email" name="company_email" type="email" maxlength="200" value={v.company_email ?? billing.company.email} placeholder="administracion@sevenworlds.es" />
      </div>
    </div>
    <p class="hint muted small">Mientras falten, en la factura sale «pendiente».</p>
    <div><button class="btn btn-primary" type="submit" name="intent" value="invoicing">Guardar</button></div>
  </form>

  <form method="post" class="form-section mt">
    <h2><Icon name="folder" /> Numeración de expedientes</h2>
    <p class="muted">Al abrir una solicitud se propone el número siguiente al mayor que exista (ahora: <strong>{next}</strong>).
      Si todavía no hay ninguno, se empieza por este.</p>
    <div class="row row-2">
      <div class:list={['field', { 'has-error': errors.first_number }]}>
        <label for="first_number">Primer número</label>
        <input id="first_number" name="first_number" type="number" min="1" inputmode="numeric" required value={first} />
      </div>
    </div>
    <div><button class="btn btn-primary" type="submit" name="intent" value="first_number">Guardar</button></div>
  </form>
</App>
