---
// Paso 1-2 del proceso: el presupuesto está aprobado → se crea el expediente, ya en curso y con su número (el
// siguiente, sin que nadie tenga que abrirlo; Administración puede cambiarlo en «Editar»). Todo va en un único
// formulario: datos, presupuesto aprobado y previsión de pagos.
import { env } from 'cloudflare:workers';
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
import ExpedienteFields from '../../components/ExpedienteFields.astro';
import VatLines from '../../components/VatLines.astro';
import FileField from '../../components/FileField.astro';
import ForecastRows from '../../components/ForecastRows.astro';
import EntityPickerKit from '../../components/EntityPickerKit.astro';
import { readForm, actor, activityStmt } from '../../lib/app.js';
import { ExpedienteSchema, forecastRowSchema, parseRows, validate, formToObject } from '../../lib/validate.js';
import { loadRates, parseVatLines, rawVatLines } from '../../lib/vat.js';
import { activeUsers } from '../../lib/data.js';
import { nextNumberStmt, NUMBER } from '../../repos/expedientes.js';
import { getFile, UploadError } from '../../lib/files.js';
import { storeFile, fileProblem } from '../../services/files.js';
import { eur } from '../../lib/money.js';
import { nowIso } from '../../lib/dates.js';
import { serviceContext } from '../../services/context.js';
import * as suppliers from '../../services/suppliers.js';
import * as clients from '../../services/clients.js';

const db = env.DB;
const me = Astro.locals.user;
let error = null;
let errors = {};
let v = { manager_id: me.id };
let forecast = [];
let budgetLines = [];
const rates = await loadRates(db);

if (Astro.request.method === 'POST') {
  const who = actor(Astro);
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};
  v = { ...input };
  const e = validate(ExpedienteSchema, input);
  // El cliente tiene que estar dado de alta (se elige de la lista); su fee vigente se copia al expediente
  const cl = e.ok ? await clients.resolveForExpediente(serviceContext(Astro), { id: input.company_id, name: input.company }) : null;
  const b = parseVatLines(form, rates);
  const fc = form ? parseRows(form, 'fc', ['supplier', 'supplier_id', 'concept', 'due_date', 'total', 'rate'], forecastRowSchema(rates), { ignore: ['rate', 'supplier_id'] }) : { ok: true, rows: [] };
  // Los proveedores de la previsión tienen que estar dados de alta (se eligen de la lista)
  const sups = fc.ok && fc.rows.length ? await suppliers.resolveRowsForPayment(serviceContext(Astro), fc.rows) : { ok: true, value: null };
  // El presupuesto se comprueba antes de crear nada: un archivo que no vale no gasta un número de expediente
  const file = form ? getFile(form, 'file') : null;
  const badFile = await fileProblem(file);
  if (form) {
    // Para volver a pintar el formulario tal cual si hay un error
    budgetLines = rawVatLines(form);
    const col = (f) => form.getAll(`fc_${f}`).map(String);
    forecast = col('supplier').map((supplier, i) => ({ supplier, supplier_id: col('supplier_id')[i], concept: col('concept')[i], due_date: col('due_date')[i], total: col('total')[i], rate: col('rate')[i] }))
      .filter((r) => r.supplier || r.total);
  }

  if (!e.ok) {
    error = e.message;
    errors = e.errors;
  } else if (!cl.ok) {
    error = cl.message;
    errors = cl.fields;
  } else if (!b.ok) {
    error = `Presupuesto · ${b.message}`;
    errors = { amount: b.message };
  } else if (!fc.ok) {
    error = `Previsión de pagos · ${fc.message}`;
  } else if (!sups.ok) {
    error = `Previsión de pagos · ${sups.message}`;
  } else if (badFile) {
    error = badFile;
  } else {
    const d = e.data;
    const at = nowIso();
    // El número y el alta en la misma transacción: el siguiente del contador, sin repetir aunque se creen dos a la vez
    const [, created] = await db.batch([
      nextNumberStmt(db),
      db.prepare(
        `INSERT INTO expedientes (number, name, company, client_id, fee_bp, contact_name, contact_email, contact_phone, destination, start_date, end_date,
                                  attendees, notes, status, manager_id, requested_by, requested_at, opened_by, opened_at, updated_at)
         VALUES (${NUMBER}, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'abierto', ?, ?, ?, ?, ?, ?) RETURNING id, number`,
      ).bind(d.name, cl.value.name, cl.value.id, cl.value.fee_bp, d.contact_name, d.contact_email, d.contact_phone, d.destination, d.start_date, d.end_date,
        d.attendees, d.notes, d.manager_id, me.id, at, me.id, at, at),
    ]);
    const exp = created.results[0];

    try {
      const fileId = file ? await storeFile({ db, bucket: env.DOCS, file, expedienteId: exp.id, userId: me.id }) : null;
      const supOf = sups.value?.of;
      await db.batch([
        db.prepare('INSERT INTO budgets (expediente_id, version, base_cents, total_cents, vat_lines, note, file_id, created_by) VALUES (?, 1, ?, ?, ?, ?, ?, ?)')
          .bind(exp.id, b.base, b.total, JSON.stringify(b.lines), 'Presupuesto aprobado por el cliente', fileId, me.id),
        ...fc.rows.map((r) => db.prepare(
          `INSERT INTO payments (expediente_id, supplier, supplier_id, concept, base_cents, total_cents, vat, vat_lines, due_date, planned, created_by)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?)`,
        ).bind(exp.id, supOf(r).name, supOf(r).id, r.concept, r.base, r.total, r.vat, JSON.stringify(r.lines), r.due_date, me.id)),
        activityStmt(db, who, exp.id, 'expediente.create',
          `creó el expediente ${exp.number} con un presupuesto de ${eur(b.base)} sin IVA${fc.rows.length ? ` y ${fc.rows.length} pagos previstos` : ''}`),
      ]);
    } catch (err) {
      // Si no se ha podido guardar el documento, no se crea nada: se borra el expediente (su número no se vuelve a dar)
      await db.prepare('DELETE FROM expedientes WHERE id = ?').bind(exp.id).run();
      if (!(err instanceof UploadError)) throw err;
      error = err.message;
    }
    if (!error) return Astro.redirect(`/expedientes/${exp.id}?ok=creado`, 303);
  }
  Astro.response.status = 400;
}

const [users, picker, clientPicker] = await Promise.all([
  activeUsers(db), suppliers.pickerData(serviceContext(Astro)), clients.pickerData(serviceContext(Astro)),
]);
const { options = [], types = [] } = picker.ok ? picker.value : {};
---
<App title="Nuevo expediente" section="nuevo" error={error} fieldErrors={errors}>
  <div class="page-top">
    <div>
      <h1>Nuevo expediente</h1>
      <p>El cliente ha aprobado el presupuesto: crea aquí el expediente. Queda en curso con el número siguiente.</p>
    </div>
  </div>

  <form method="post" enctype="multipart/form-data" class="form">
    <ExpedienteFields v={v} errors={errors} users={users} />

    <section class="form-section">
      <h2><Icon name="file-spreadsheet" /> Presupuesto aprobado</h2>
      <p class="muted">El Excel o PDF que ha aceptado el cliente y su total. Si cambia más adelante, se sube una versión nueva desde el expediente.</p>
      <FileField label="Presupuesto aprobado" hint="Cada presupuesto es distinto: se guarda el archivo tal cual." />
      <VatLines id="budget" lines={budgetLines} rates={rates} error={errors.amount} labelBase="Total sin IVA" labelTotal="Total con IVA"
        hint="Una línea por tipo de IVA, como en el presupuesto: p. ej. alojamiento al 10 % y servicios al 21 %. En cada línea basta con escribir un importe." />
    </section>

    <section class="form-section">
      <h2><Icon name="wallet" /> Previsión de pagos a proveedores</h2>
      <p class="muted">Lo que realmente cuesta el evento (sin hinchar precios): los pagos grandes y cuándo los exigen.
        Ej.: el hotel exige 21.400 € antes del 29/01 y un 2º pago de 28.600 € el 28/02. Cada fila pasa a la lista de pagos del expediente.</p>
      <ForecastRows rows={forecast} rates={rates} />
    </section>

    <div class="actions">
      <button class="btn btn-primary" type="submit" data-busy="Creando…"><Icon name="folder-plus" size={18} /> Crear expediente</button>
      <a class="btn btn-ghost" href="/expedientes">Cancelar</a>
    </div>
  </form>
  <EntityPickerKit kind="supplier" options={options} types={types} />
  <EntityPickerKit kind="client" options={clientPicker.ok ? clientPicker.value.options : []} />
</App>
