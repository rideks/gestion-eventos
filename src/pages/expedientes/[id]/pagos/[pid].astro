---
// Ficha de un pago a proveedor: de qué era, su desglose de IVA, el pago con su JUSTIFICANTE bancario
// y sus DOCUMENTOS: facturas y proformas. Un pago puede tener varios (la proforma, la factura, otra
// factura que sustituye a la anterior…) y un documento puede cubrir varios pagos (dos anticipos y una
// única factura). Una factura conforme ya no se puede borrar.
// El orden: ① justificante → ② pagado → ③ factura conforme. Un pago hecho ya no se modifica
// (Administración puede «Deshacer pagado» para corregirlo) y la factura se conforma después del pago.
// Una liquidación de gastos (lo que alguien adelantó, sin factura) tiene dos pasos: ① su hoja → ② el reembolso.
import App from '../../../../layouts/App.astro';
import Icon from '../../../../components/Icon.astro';
import ExpHeader from '../../../../components/ExpHeader.astro';
import PaymentForm from '../../../../components/PaymentForm.astro';
import SupplierDocFields from '../../../../components/SupplierDocFields.astro';
import FileField from '../../../../components/FileField.astro';
import Pill from '../../../../components/Pill.astro';
import EntityPickerKit from '../../../../components/EntityPickerKit.astro';
import { parseId, readForm, can } from '../../../../lib/app.js';
import { formToObject } from '../../../../lib/validate.js';
import { rawVatLines, linesOf } from '../../../../lib/vat.js';
import { docName, isConforme, hasConformeInvoice, canRemoveDocument } from '../../../../lib/supplier.js';
import { getFile, fileUrl } from '../../../../lib/files.js';
import { paymentState, supplierInvoiceState, documentState, needsReceipt, conformBlocker, isLiquidation, PAYMENT_METHODS, DOC_KINDS } from '../../../../lib/finance.js';
import { eur } from '../../../../lib/money.js';
import { formatDate, formatStamp, dueText } from '../../../../lib/dates.js';
import { isLocked } from '../../../../lib/actions.js';
import { serviceContext, failure } from '../../../../services/context.js';
import * as payments from '../../../../services/payments.js';
import { keepUploads } from '../../../../services/files.js';

const ctx = serviceContext(Astro);
const id = parseId(Astro.params.id);
const pid = parseId(Astro.params.pid);
const me = Astro.locals.user;
const now = ctx.now;
const back = `/expedientes/${id}/pagos`;
const self = `/expedientes/${id}/pagos/${pid}`;
const docWarning = Astro.url.searchParams.get('aviso_doc');
let error = docWarning ? `El pago se ha guardado, pero no el documento: ${docWarning.slice(0, 300)}` : null;
let errors = {};
let input = null;
let lines = null;
let openEdit = Astro.url.searchParams.has('editar');
let openUpload = false;
// Los documentos elegidos en un intento con error (vuelven ya puestos): { file, receipt }
let kept = {};

if (id && pid && Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  input = form ? formToObject(form) : {};
  const documentId = Number(input.document_id);
  // Cada acción, a dónde vuelve si sale bien
  const ACTIONS = {
    // Se puede subir el justificante y marcarlo pagado de una vez
    pay: [() => payments.markPaid(ctx, input, { expedienteId: id, receipt: getFile(form, 'receipt') }), (v) => `${self}?ok=${v.kind === 'liquidacion' ? 'reembolsada' : 'pagado'}`],
    receipt: [() => payments.saveReceipt(ctx, id, pid, getFile(form, 'receipt')), `${self}?ok=justificante#justificante`],
    receipt_remove: [() => payments.removeReceipt(ctx, id, pid), `${self}?ok=guardado#justificante`],
    unpay: [() => payments.unpay(ctx, id, pid), (v) => `${self}?ok=${v.kind === 'liquidacion' ? 'reembolso_deshecho' : 'deshecho'}#justificante`],
    // La hoja de una liquidación de gastos
    sheet: [() => payments.replaceSheet(ctx, id, pid, getFile(form, 'sheet')), `${self}?ok=hoja#hoja`],
    delete: [() => payments.remove(ctx, id, pid), `${back}?ok=borrado`],
    doc_new: [() => payments.addDocument(ctx, id, pid, input, getFile(form, 'file')), (v) => `${self}?ok=${v.kind === 'factura' ? 'subida' : 'proforma'}#factura`],
    doc_link: [() => payments.linkDocument(ctx, id, pid, documentId), `${self}?ok=guardado#factura`],
    doc_remove: [() => payments.removeDocument(ctx, id, pid, documentId), `${self}?ok=quitada#factura`],
    doc_conform: [() => payments.conform(ctx, documentId, input), `${self}?ok=revisada#factura`],
    // Sólo los datos del pago (proveedor, importe, fecha límite…); se paga en su paso, no aquí
    save: [() => payments.update(ctx, id, pid, form ?? new FormData()), `${self}?ok=guardado`],
  };
  const action = Object.hasOwn(ACTIONS, input.intent) ? ACTIONS[input.intent] : null;
  const up = await keepUploads(ctx, form, ['file', 'receipt', 'sheet']);
  const r = action ? await action[0]() : { ok: false, code: 'invalid', message: 'Esa acción no está permitida.', fields: {} };
  if (r.ok) {
    await up.done();
    return Astro.redirect(typeof action[1] === 'function' ? action[1](r.value) : action[1], 303);
  }
  const bounce = failure(Astro, r, self);
  if (bounce) return bounce;
  kept = await up.keep();
  error = r.message;
  errors = r.fields ?? {};
  openEdit = input.intent === 'save';
  openUpload = input.intent === 'doc_new';
  if (openEdit && form) lines = rawVatLines(form);
}

const f = id && pid ? await payments.ficha(ctx, id, pid) : { ok: false, code: 'not_found' };
if (!f.ok) return failure(Astro, f, back);
const { exp, payment: p, docs, choices, coverage: shared, rates, editable, options, types, people } = f.value;
const liq = isLiquidation(p);
// «el pago» / «la liquidación» en los textos
const name = liq ? `Gastos de ${p.supplier}` : p.supplier;
const locked = isLocked(exp);
const admin = can(me, 'supplier.review');
const withConforme = hasConformeInvoice(docs);
const paid = p.status === 'pagado';
// Un pago hecho no se modifica ni se borra; uno con una factura conforme tampoco se borra (se borraría con ella)
const canDelete = !locked && !paid && !withConforme && (can(me, 'delete') || p.created_by === me.id);
const canUnpay = !locked && paid && can(me, 'payment.unpay');
// Eventos sólo marca pagados los pagos con tarjeta (las transferencias las marca Administración); un reembolso no
// se hace con tarjeta, así que lo marca Administración
const cardOnly = !can(me, 'payment.any_method');
const canPay = !locked && !paid && can(me, 'pagos') && !(liq && cardOnly);
// El justificante bancario lo sube (o lo quita) sólo Administración
const canReceipt = can(me, 'payment.receipt');
// Al justificante de un pago hecho por transferencia no se le puede quitar
const receiptLocked = paid && needsReceipt(p.method);
const v = openEdit && input ? { ...p, ...input } : { ...p };
const docValues = openUpload && input ? { ...input, kept } : {};
lines ??= linesOf(p);
const state = paymentState(p, now);
const invState = supplierInvoiceState(p);
const saved = linesOf(p);
const receiptHref = fileUrl({ file_id: p.receipt_file_id, file_name: p.receipt_name });
const sameSupplier = `/expedientes/${id}/pagos?nuevo${p.supplier_id ? `&proveedor=${p.supplier_id}` : ''}`;
const showUpload = openUpload || !docs.length;
// ¿Están hechos todos los pagos que cubre el documento? (para conformar la factura)
const docPaid = (d) => !conformBlocker(d.payment_count > 1 ? shared.get(d.id) ?? [] : [p]);
const needed = needsReceipt(p.method);
const sheetHref = liq ? fileUrl({ file_id: p.sheet_file_id, file_name: p.sheet_name }) : null;
// ① factura o proforma del proveedor → ② justificante y pago → ③ factura conforme (después del pago)
// Liquidación de gastos: ① hoja de liquidación → ② reembolso
const flow = liq ? [
  { n: 1, href: '#hoja', title: 'Hoja de liquidación', ...(sheetHref ? { state: 'is-done', text: 'Subida' } : { state: 'is-warn', text: 'Falta la hoja' }) },
  {
    n: 2, href: '#justificante', title: 'Reembolso',
    ...(paid && needed && !p.receipt_file_id ? { state: 'is-warn', text: 'Reembolsada · falta el justificante' }
      : paid ? { state: 'is-done', text: `El ${formatDate(p.paid_on)}${p.method ? ` · ${PAYMENT_METHODS[p.method]}` : ''}` }
      : { state: 'is-current', text: `Por reembolsar a ${p.supplier}` }),
  },
] : [
  {
    n: 1, href: '#factura', title: 'Factura o proforma',
    ...(p.invoice_count ? { state: 'is-done', text: p.invoice_count > 1 ? 'Facturas recibidas' : 'Factura recibida' }
      : p.proforma_count ? { state: 'is-done', text: 'Proforma recibida · la factura, después' }
      : paid ? { state: 'is-warn', text: 'Falta la factura del proveedor' }
      : { state: 'is-current', text: 'Súbela cuando llegue' }),
  },
  {
    n: 2, href: '#justificante', title: canReceipt ? 'Justificante y pago' : 'Pago',
    ...(paid && needed && !p.receipt_file_id ? { state: 'is-warn', text: 'Pagado · falta el justificante' }
      : paid ? { state: 'is-done', text: `El ${formatDate(p.paid_on)}${p.method ? ` · ${PAYMENT_METHODS[p.method]}` : ''}` }
      : { state: 'is-current', text: [p.receipt_file_id && 'Justificante subido', p.due_date ? `Límite ${formatDate(p.due_date)}` : 'Sin fecha límite'].filter(Boolean).join(' · ') }),
  },
  {
    n: 3, href: '#factura', title: 'Conforme',
    ...(p.invoice_count && !p.invoice_pending ? { state: 'is-done', text: 'Factura conforme' }
      : p.invoice_pending ? (paid ? { state: 'is-current', text: 'Lista para conformar' } : { state: 'is-waiting', text: 'Cuando el pago esté hecho' })
      : { state: 'is-waiting', text: paid ? 'Cuando llegue la factura' : 'Cuando haya factura y pago' }),
  },
];
---
<App title={`${name} · ${exp.number ? `EXP ${exp.number}` : exp.name}`} section="expedientes" error={error} fieldErrors={errors}>
  <ExpHeader exp={exp} tab="pagos" current={p.concept ? `${name} · ${p.concept}` : name} />

  <section class="card">
    <div class="sec-head">
      {liq
        ? <h2><Icon name="hand-coins" /> {name} <Pill state={state} /> <span class="pill pill-accent">Liquidación de gastos</span></h2>
        : <h2><Icon name="wallet" /> {p.supplier_id && can(me, 'proveedores') ? <a href={`/proveedores/${p.supplier_id}`} title="Ficha del proveedor">{p.supplier}</a> : p.supplier} <Pill state={state} /></h2>}
      <span class:list={['big-money money', { neg: p.total_cents < 0 }]}>{eur(p.total_cents)}</span>
    </div>
    <dl class="kv">
      {liq && <><dt>Adelantado por</dt><dd>{p.supplier} <span class="muted">· se le reembolsa</span></dd></>}
      {liq && p.spent_on && <><dt>Fecha de los gastos</dt><dd>{formatDate(p.spent_on)}</dd></>}
      {p.concept && <><dt>Concepto</dt><dd>{p.concept}</dd></>}
      <dt>Importe</dt>
      <dd>
        {saved.map((l) => <span class="vat-line money">{l.label}: {eur(l.total)} con IVA → {eur(l.base)} sin IVA</span>)}
        {saved.length > 1 && <span class="vat-line money">Total: {eur(p.total_cents)} con IVA → {eur(p.base_cents)} sin IVA</span>}
      </dd>
      {!liq && p.status !== 'pagado' && <><dt>Fecha límite</dt><dd>{p.due_date ? `${formatDate(p.due_date)} · ${dueText(p.due_date, now)}` : 'Sin fecha límite'}</dd></>}
      <dt>Alta</dt>
      <dd>{p.planned ? 'Previsión de la solicitud · ' : ''}{p.created_by_name ?? '—'} · {formatStamp(p.created_at)}</dd>
      {p.notes && <><dt>Notas</dt><dd class="msg-body">{p.notes}</dd></>}
    </dl>

    {!locked && (
      <div class="actions-inline mt no-print">
        {!paid && (
          <details class="add edit-inline" id="editar" open={openEdit}>
            <summary class="btn btn-sm"><Icon name="pencil" size={16} /> <span class="when-closed">{liq ? 'Modificar liquidación' : 'Modificar pago'}</span><span class="when-open">Cerrar sin guardar</span></summary>
            <form method="post" class="form edit-form">
              <PaymentForm v={v} errors={errors} rates={rates} lines={lines} withStatus={false} keepId={p.supplier_id} liquidation={liq} people={people} id="edit" />
              <div class="actions-inline">
                <button class="btn btn-primary" type="submit" name="intent" value="save" data-busy="Guardando…"><Icon name="check" size={18} /> Guardar cambios</button>
              </div>
            </form>
          </details>
        )}
        {liq
          ? <a class="btn btn-ghost btn-sm" href={`${back}?nuevo=liquidacion#liquidacion`}><Icon name="plus" size={16} /> Otra liquidación de gastos</a>
          : <a class="btn btn-ghost btn-sm" href={sameSupplier}><Icon name="plus" size={16} /> Otro pago a {p.supplier}</a>}
        {canDelete && (
          <form method="post">
            <button class="btn btn-danger btn-sm" type="submit" name="intent" value="delete"
              data-confirm={liq ? `¿Borrar la liquidación de gastos de ${p.supplier} de ${eur(p.total_cents)}? También se borra su hoja.`
                : `¿Borrar el pago a ${p.supplier} de ${eur(p.total_cents)}?${docs.some((d) => d.payment_count === 1) ? ' También se borran sus documentos.' : ''}`}
              data-confirm-ok={liq ? 'Borrar liquidación' : 'Borrar pago'}><Icon name="trash-2" size={16} /> {liq ? 'Borrar liquidación' : 'Borrar pago'}</button>
          </form>
        )}
      </div>
    )}
    {!locked && paid && <p class="muted small mt"><Icon name="lock" size={14} /> {liq ? 'La liquidación está reembolsada' : 'El pago está hecho'}: no se puede modificar ni borrar.{!canUnpay && ' Si hay un error, avisa a Administración.'}</p>}
    {!locked && !paid && withConforme && <p class="muted small mt">Tiene una factura conforme: el pago no se puede borrar.</p>}
    {!locked && !paid && !withConforme && !canDelete && <p class="muted small mt">Sólo Administración o quien {liq ? 'añadió la liquidación' : 'añadió el pago'} puede borrarlo.</p>}
  </section>

  <ol class:list={['flow-steps no-print', { 'is-two': liq }]} aria-label={liq ? 'Pasos de la liquidación' : 'Pasos del pago'}>
    {flow.map((f) => (
      <li class={f.state}>
        <a href={f.href}>
          <span class="flow-n" aria-hidden="true">{f.state === 'is-done' ? <Icon name="check" size={16} /> : f.n}</span>
          <span class="flow-text"><strong>{f.n}. {f.title}</strong><small>{f.text}</small></span>
        </a>
      </li>
    ))}
  </ol>


  {liq && (
  <section class="card mt" id="hoja">
    <div class="sec-head">
      <h2><Icon name="file-text" /> 1. Hoja de liquidación</h2>
      <p>La hoja con el detalle de los gastos y los tiques. Una liquidación no lleva factura de proveedor.</p>
    </div>
    {sheetHref
      ? <div class="doc-current"><Icon name="paperclip" size={16} /><a href={sheetHref} target="_blank" rel="noopener">{p.sheet_name}</a></div>
      : <p class="warn-text">Falta la hoja de liquidación: súbela aquí.</p>}
    {!locked && !(paid && sheetHref) && (
      <details class="add mt" open={!sheetHref || input?.intent === 'sheet'}>
        <summary class="btn btn-ghost btn-sm"><Icon name="upload" size={16} /> {sheetHref ? 'Sustituir la hoja' : 'Subir la hoja'}</summary>
        <form method="post" enctype="multipart/form-data" class="form-section">
          <FileField id="liq-sheet" name="sheet" label="Hoja de liquidación (PDF o foto)" optional={false} required
            error={input?.intent === 'sheet' ? errors.sheet : null} kept={input?.intent === 'sheet' ? kept.sheet : null} />
          <div><button class="btn btn-primary btn-sm" type="submit" name="intent" value="sheet" data-busy="Subiendo…"><Icon name="upload" size={16} /> Subir hoja</button></div>
        </form>
      </details>
    )}
  </section>
  )}

  {!liq && (
  <section class="card mt" id="factura">
    <div class="sec-head">
      <h2><Icon name="paperclip" /> 1. Facturas y proformas {invState && <Pill state={invState} />}</h2>
      <p>La factura se da por conforme cuando el pago está hecho. Las proformas no avisan a nadie. Una factura conforme no se puede borrar.</p>
    </div>

    {docs.length ? (
      <ul class="doc-list">
        {docs.map((d) => {
          const href = fileUrl({ file_id: d.file_id, file_name: d.file_name });
          const covered = d.payment_count > 1 ? shared.get(d.id) ?? [] : [];
          const coveredTotal = covered.length ? covered.reduce((a, x) => a + x.total_cents, 0) : p.total_cents;
          return (
            <li class="doc">
              <div class="doc-head">
                <Pill state={documentState(d, docPaid(d))} />
                <strong>{d.number ? `${DOC_KINDS[d.kind]} ${d.number}` : `${DOC_KINDS[d.kind]} sin número`}</strong>
                {d.issued_on && <span class="muted">· {formatDate(d.issued_on)}</span>}
                {d.total_cents != null && <span class="money">· {eur(d.total_cents)}</span>}
              </div>
              {href ? <a class="doc-link" href={href} target="_blank" rel="noopener"><Icon name="file-text" size={15} />{d.file_name}</a> : <span class="muted small">Sin archivo</span>}
              <p class="muted small">
                Subido por {d.uploaded_by_name ?? '—'} · {formatStamp(d.uploaded_at)}
                {d.kind === 'factura' && (d.review === 'conforme'
                  ? <> · Conforme ({d.reviewed_by_name ?? '—'}{d.reviewed_at && `, ${formatStamp(d.reviewed_at)}`})</>
                  : docPaid(d) ? <> · <span class="warn-text">pendiente de que Administración la revise</span></>
                  : <> · se revisa cuando el pago esté hecho</>)}
              </p>
              {d.notes && <p class="doc-note"><Icon name="message-square" size={15} /> {d.notes}</p>}
              {covered.length > 1 && (
                <p class="small">Cubre {covered.length} pagos:{' '}
                  {covered.map((c, i) => <>{i > 0 && ' · '}{c.id === p.id ? <strong>este</strong> : <a href={`/expedientes/${id}/pagos/${c.id}`}>{c.supplier}{c.concept && ` (${c.concept})`}</a>} {eur(c.total_cents)}</>)}
                </p>
              )}
              {d.kind === 'factura' && d.total_cents != null && (d.total_cents === coveredTotal
                ? <span class="pill pill-ok">Cuadra con {covered.length > 1 ? 'los pagos' : 'el pago'}</span>
                : <span class="pill pill-danger">No cuadra: {covered.length > 1 ? 'los pagos suman' : 'el pago es de'} {eur(coveredTotal)}</span>)}

              {!locked && (
                <div class="actions-inline doc-actions no-print">
                  {admin && d.kind === 'factura' && d.review !== 'conforme' && !docPaid(d) && (
                    <span class="muted small"><Icon name="lock" size={14} /> Se conforma cuando {d.payment_count > 1 ? 'todos los pagos que cubre estén hechos' : 'el pago esté hecho'}</span>
                  )}
                  {admin && d.kind === 'factura' && d.review !== 'conforme' && docPaid(d) && (
                    <form method="post" class="quick-form">
                      <input type="hidden" name="intent" value="doc_conform" />
                      <input type="hidden" name="document_id" value={d.id} />
                      <label class="visually-hidden" for={`conf-number-${d.id}`}>Nº de factura</label>
                      <input id={`conf-number-${d.id}`} name="invoice_number" type="text" required maxlength="60" value={d.number ?? ''} placeholder="Nº de factura" />
                      <label class="visually-hidden" for={`conf-date-${d.id}`}>Fecha de la factura</label>
                      <input id={`conf-date-${d.id}`} name="invoice_date" type="date" value={d.issued_on ?? ''} />
                      <button class="btn btn-primary btn-sm" type="submit" data-busy="Guardando…"><Icon name="check" size={16} /> Conforme</button>
                    </form>
                  )}
                  {canRemoveDocument(me, d) && (
                    <form method="post">
                      <input type="hidden" name="document_id" value={d.id} />
                      <button class="btn btn-danger btn-sm" type="submit" name="intent" value="doc_remove"
                        data-confirm={d.payment_count > 1
                          ? `¿Quitar la ${docName(d)} de este pago? Seguirá en los otros ${d.payment_count - 1} pagos que cubre.`
                          : `¿Borrar la ${docName(d)}? Se borra también su archivo.`}
                        data-confirm-ok={d.payment_count > 1 ? 'Quitar de este pago' : 'Borrar'}><Icon name="trash-2" size={16} /> {d.payment_count > 1 ? 'Quitar de este pago' : 'Borrar'}</button>
                    </form>
                  )}
                  {isConforme(d) && <span class="muted small"><Icon name="lock" size={14} /> Conforme: no se puede borrar</span>}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="muted">{p.status === 'pagado' ? 'Este pago ya está hecho y falta la factura del proveedor: reclámala y súbela aquí.' : 'Todavía no tiene factura ni proforma.'}</p>
    )}

    {!locked && (
      <>
        <details class="add mt" open={showUpload}>
          <summary class="btn btn-primary btn-sm"><Icon name="upload" size={16} /> <span class="when-closed">Subir factura o proforma</span><span class="when-open">Cerrar</span></summary>
          <form method="post" enctype="multipart/form-data" class="form-section">
            {withConforme && (
              <p class="warn-text small">Este pago ya tiene una factura conforme, que no se puede borrar. Si subes otra factura,
                explica en el comentario por qué: Administración tendrá que revisarla.</p>
            )}
            <SupplierDocFields v={docValues} errors={openUpload ? errors : {}} id="doc" fileRequired comment={withConforme ? 'required' : 'optional'} />
            <div><button class="btn btn-primary" type="submit" name="intent" value="doc_new" data-busy="Subiendo…"><Icon name="upload" size={18} /> Subir documento</button></div>
          </form>
        </details>
        {choices.length > 0 && (
          <details class="add">
            <summary class="btn btn-ghost btn-sm"><Icon name="link" size={16} /> ¿Es un documento que ya está subido?</summary>
            <form method="post" class="form-section">
              <p class="muted small">Cuando el proveedor manda una única factura para varios pagos (p. ej. dos anticipos), súbela en uno y elígela aquí en los demás.</p>
              <div class="field">
                <label for="document_id">Documento</label>
                <select id="document_id" name="document_id" required>
                  {choices.map((c) => <option value={c.id}>{DOC_KINDS[c.kind]} {c.number ?? 'sin nº'} · {c.supplier}</option>)}
                </select>
              </div>
              <div><button class="btn btn-ghost" type="submit" name="intent" value="doc_link"><Icon name="link" size={18} /> Usar este documento</button></div>
            </form>
          </details>
        )}
      </>
    )}
  </section>
  )}

  <section class="card mt" id="justificante">
    <div class="sec-head">
      <h2><Icon name="banknote" /> 2. {liq ? 'Reembolso' : canReceipt ? 'Justificante y pago' : 'Pago'}</h2>
      {receiptHref ? <span class="pill pill-ok">Con justificante</span>
        : receiptLocked ? <span class="pill pill-danger">Falta el justificante</span> : null}
      {liq && !paid && !locked && <p>Se le devuelve a {p.supplier} lo que adelantó{cardOnly ? ': el reembolso lo marca Administración.' : '. Si es por transferencia, con su justificante.'}</p>}
      {!liq && !canReceipt && !paid && !locked && <p>Las transferencias las paga Administración: sube el justificante y lo marca pagado. Si lo has pagado tú con la tarjeta, márcalo aquí.</p>}
    </div>
    {paid && (
      <dl class="kv">
        <dt>{liq ? 'Reembolsada' : 'Pagado'}</dt><dd>{formatDate(p.paid_on)}{p.method && ` · ${PAYMENT_METHODS[p.method]}`}</dd>
      </dl>
    )}
    {receiptHref && (
      <div class="doc-current mt">
        <Icon name="paperclip" size={16} />
        <a href={receiptHref} target="_blank" rel="noopener">{p.receipt_name}</a>
        {!locked && !paid && canReceipt && (
          <form method="post">
            <button class="btn btn-danger btn-sm" type="submit" name="intent" value="receipt_remove"
              data-confirm="¿Quitar el justificante? Se borra del expediente." data-confirm-ok="Quitar justificante"><Icon name="trash-2" size={14} /> Quitar</button>
          </form>
        )}
      </div>
    )}
    {canPay && (
      <form method="post" enctype="multipart/form-data" class="form mt" data-has-receipt={p.receipt_file_id ? '1' : '0'}>
        <input type="hidden" name="payment_id" value={p.id} />
        {canReceipt && (
          <FileField id="pay-receipt" name="receipt" optional={false} label={p.receipt_file_id ? 'Cambiar el justificante' : 'Justificante bancario (PDF o foto)'}
            hint={liq ? 'Obligatorio para marcarla reembolsada si es por transferencia.' : 'Obligatorio para marcar como pagado un pago por transferencia.'} kept={input?.intent === 'pay' ? kept.receipt : null} />
        )}
        <>
            <div class="row row-2">
              <div class="field">
                <label for="paid_on_quick">{liq ? 'Fecha del reembolso' : 'Fecha de pago'}</label>
                <input id="paid_on_quick" type="date" name="paid_on" value={now} />
              </div>
              {cardOnly ? (
                <div class="field">
                  <span class="label">Forma de pago</span>
                  <input type="hidden" name="method" value="tarjeta" />
                  <p class="muted">{PAYMENT_METHODS.tarjeta}: desde Eventos sólo se marcan los pagos hechos con tarjeta.</p>
                </div>
              ) : (
                <div class="field">
                  <label for="method_quick">{liq ? 'Forma de reembolso' : 'Forma de pago'}</label>
                  <select id="method_quick" name="method">
                    {Object.entries(PAYMENT_METHODS).map(([k, l]) => <option value={k}>{l}</option>)}
                  </select>
                </div>
              )}
            </div>
            <div class="actions-inline">
              {cardOnly
                ? <button class="btn btn-primary" type="submit" name="intent" value="pay" data-busy="Guardando…"><Icon name="credit-card" size={18} /> Pagado con tarjeta</button>
                : <button class="btn btn-primary" type="submit" name="intent" value="pay" data-receipt-check data-busy="Guardando…"><Icon name="check" size={18} /> {liq ? 'Reembolsada' : 'Pagado'}</button>}
              {canReceipt && <button class="btn btn-ghost" type="submit" name="intent" value="receipt" data-busy="Subiendo…"><Icon name="upload" size={18} /> Sólo subir el justificante</button>}
            </div>
        </>
      </form>
    )}
    {!locked && paid && !p.receipt_file_id && canReceipt && (
      <details class="add mt" open={needed}>
        <summary class="btn btn-ghost btn-sm"><Icon name="upload" size={16} /> {needed ? 'Añadir el justificante que falta' : 'Añadir justificante (opcional)'}</summary>
        <form method="post" enctype="multipart/form-data" class="form-section">
          <FileField id="pay-receipt" name="receipt" optional={false} label="Justificante (PDF o foto)" required kept={input?.intent === 'receipt' ? kept.receipt : null} />
          <div><button class="btn btn-primary btn-sm" type="submit" name="intent" value="receipt" data-busy="Subiendo…"><Icon name="upload" size={16} /> Subir justificante</button></div>
        </form>
      </details>
    )}
    {canUnpay && (
      <form method="post" class="actions-inline mt">
        <button class="btn btn-ghost btn-sm" type="submit" name="intent" value="unpay"
          data-confirm={liq ? '¿Deshacer el reembolso? Vuelve a quedar por reembolsar para corregir lo que esté mal y se apunta en la actividad.'
            : '¿Deshacer el pago? Vuelve a quedar por pagar para corregir lo que esté mal (importe, fecha, justificante) y se apunta en la actividad.'}
          data-confirm-ok={liq ? 'Deshacer reembolso' : 'Deshacer pagado'}><Icon name="rotate-ccw" size={16} /> {liq ? 'Deshacer reembolso' : 'Deshacer pagado'}</button>
        <span class="muted small">Sólo para corregir un error: {liq ? 'vuelve a «Por reembolsar»' : 'el pago vuelve a «Por pagar»'}.</span>
      </form>
    )}
  </section>

  {editable && !liq && <EntityPickerKit kind="supplier" options={options} types={types} />}
</App>
