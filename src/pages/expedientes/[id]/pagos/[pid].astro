---
// Ficha de un pago a proveedor: de qué era, su desglose de IVA, el pago con su JUSTIFICANTE bancario
// y sus DOCUMENTOS: facturas y proformas. Un pago puede tener varios (la proforma, la factura, otra
// factura que sustituye a la anterior…) y un documento puede cubrir varios pagos (dos anticipos y una
// única factura). Una factura conforme ya no se puede borrar.
// El orden: ① justificante → ② pagado → ③ factura conforme. Un pago hecho ya no se modifica
// (Administración puede «Deshacer pagado» para corregirlo) y la factura se conforma después del pago.
import { env } from 'cloudflare:workers';
import App from '../../../../layouts/App.astro';
import Icon from '../../../../components/Icon.astro';
import ExpHeader from '../../../../components/ExpHeader.astro';
import PaymentForm from '../../../../components/PaymentForm.astro';
import SupplierDocFields from '../../../../components/SupplierDocFields.astro';
import FileField from '../../../../components/FileField.astro';
import Pill from '../../../../components/Pill.astro';
import { parseId, readForm, actor, can, activityStmt } from '../../../../lib/app.js';
import { getExpediente, suggestions, PAYMENT_SELECT, PAYMENT_JOINS } from '../../../../lib/data.js';
import { PaymentSchema, SupplierDocSchema, ConformSchema, validate, formToObject } from '../../../../lib/validate.js';
import { loadRates, parseVatLines, rawVatLines, linesOf } from '../../../../lib/vat.js';
import {
  paymentDocuments, documentsCoverage, expedienteDocuments, docName, isConforme, hasConformeInvoice, canRemoveDocument,
  attachDocument, linkDocument, removeDocument, conformInvoice, dropIfOrphan, saveReceipt, removeReceipt,
} from '../../../../lib/supplier.js';
import { getFile, fileUrl, deleteFiles, UploadError } from '../../../../lib/files.js';
import { paymentState, supplierInvoiceState, documentState, needsReceipt, conformBlocker, PAYMENT_METHODS, DOC_KINDS, PAID_LOCKED } from '../../../../lib/finance.js';
import { eur } from '../../../../lib/money.js';
import { today, nowIso, formatDate, formatStamp, dueText } from '../../../../lib/dates.js';
import { isLocked, LOCKED_MSG, markPaid } from '../../../../lib/actions.js';

const db = env.DB;
const id = parseId(Astro.params.id);
const pid = parseId(Astro.params.pid);
// Todo a la vez (una sola espera a la base de datos)
const [exp, p, docs, rates] = id && pid ? await Promise.all([
  getExpediente(db, id),
  db.prepare(
    `SELECT ${PAYMENT_SELECT}, u.name AS created_by_name FROM payments p ${PAYMENT_JOINS} LEFT JOIN users u ON u.id = p.created_by
      WHERE p.id = ? AND p.expediente_id = ?`,
  ).bind(pid, id).first(),
  paymentDocuments(db, pid),
  loadRates(db),
]) : [];
if (!exp || !p) return Astro.rewrite('/404');

const me = Astro.locals.user;
const now = today();
const locked = isLocked(exp);
const admin = can(me, 'supplier.review');
const withConforme = hasConformeInvoice(docs);
const paid = p.status === 'pagado';
// Un pago hecho no se modifica ni se borra; uno con una factura conforme tampoco se borra (se borraría con ella)
const canDelete = !locked && !paid && !withConforme && (can(me, 'delete') || p.created_by === me.id);
const canUnpay = !locked && paid && can(me, 'payment.unpay');
// Eventos sólo marca pagados los pagos con tarjeta (las transferencias las marca Administración)
const cardOnly = !can(me, 'payment.any_method');
// Al justificante de un pago hecho por transferencia no se le puede quitar
const receiptLocked = paid && needsReceipt(p.method);
const back = `/expedientes/${id}/pagos`;
const self = `/expedientes/${id}/pagos/${pid}`;
const docWarning = Astro.url.searchParams.get('aviso_doc');
let error = docWarning ? `El pago se ha guardado, pero no el documento: ${docWarning.slice(0, 300)}` : null;
let errors = {};
let v = { ...p };
let docValues = {};
let lines = linesOf(p);
let openEdit = Astro.url.searchParams.has('editar');
let openUpload = false;

if (Astro.request.method === 'POST') {
  const who = actor(Astro);
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};
  const doc = docs.find((d) => d.id === Number(input.document_id));
  error = null;

  try {
    if (locked) {
      error = LOCKED_MSG;
    } else if (input.intent === 'pay') {
      // Se puede subir el justificante y marcarlo pagado de una vez
      const r = await markPaid(db, who, input, id, { bucket: env.DOCS, file: getFile(form, 'receipt') });
      if (r.ok) return Astro.redirect(`${self}?ok=pagado`, 303);
      error = r.message;
    } else if (input.intent === 'receipt') {
      const receipt = getFile(form, 'receipt');
      // En un pago hecho se puede añadir el justificante que falte, pero no cambiarlo
      if (paid && p.receipt_file_id) {
        error = PAID_LOCKED;
      } else if (!receipt) {
        error = 'Elige el justificante (PDF o foto).';
        errors = { receipt: error };
      } else {
        await saveReceipt({ db, bucket: env.DOCS, who, payment: p, file: receipt });
        return Astro.redirect(`${self}?ok=justificante#justificante`, 303);
      }
    } else if (input.intent === 'receipt_remove' && p.receipt_file_id) {
      if (paid) {
        error = PAID_LOCKED;
      } else {
        await removeReceipt({ db, bucket: env.DOCS, who, payment: p });
        return Astro.redirect(`${self}?ok=guardado#justificante`, 303);
      }
    } else if (input.intent === 'unpay') {
      if (!canUnpay) {
        error = 'Sólo Administración puede deshacer un pago hecho.';
      } else {
        await db.batch([
          db.prepare("UPDATE payments SET status = 'pendiente', paid_on = NULL, method = NULL, updated_at = ? WHERE id = ?").bind(nowIso(), pid),
          activityStmt(db, who, id, 'payment.unpaid',
            `deshizo el pago a ${p.supplier} (${eur(p.total_cents)}) del ${formatDate(p.paid_on)}: vuelve a estar por pagar`),
        ]);
        return Astro.redirect(`${self}?ok=deshecho#justificante`, 303);
      }
    } else if (input.intent === 'delete') {
      if (paid) {
        error = PAID_LOCKED;
      } else if (withConforme) {
        error = 'Este pago tiene una factura conforme: no se puede borrar.';
      } else if (canDelete) {
        await db.batch([
          db.prepare('DELETE FROM payment_documents WHERE payment_id = ?').bind(pid),
          db.prepare('DELETE FROM payments WHERE id = ?').bind(pid),
          activityStmt(db, who, id, 'payment.delete', `borró el pago a ${p.supplier} (${eur(p.total_cents)})`),
        ]);
        // Los documentos que no cubrían otros pagos se borran también (con su archivo)
        for (const d of docs) await dropIfOrphan(db, env.DOCS, d.id);
        if (p.receipt_file_id) await deleteFiles(db, env.DOCS, [p.receipt_file_id]);
        return Astro.redirect(`${back}?ok=borrado`, 303);
      } else {
        error = 'Sólo Administración o quien añadió el pago puede borrarlo.';
      }
    } else if (input.intent === 'doc_new') {
      openUpload = true;
      docValues = input;
      const parsed = validate(SupplierDocSchema, input);
      const file = getFile(form, 'file');
      if (!parsed.ok) {
        error = parsed.message;
        errors = parsed.errors;
      } else if (!parsed.data.kind) {
        error = 'Indica si el documento es una factura o una proforma.';
        errors = { doc_kind: error };
      } else if (!file && !parsed.data.number) {
        error = 'Adjunta el documento (o escribe al menos su número).';
      } else if (parsed.data.kind === 'factura' && withConforme && !parsed.data.comment) {
        error = 'Este pago ya tiene una factura conforme: explica en el comentario por qué se sube otra.';
        errors = { doc_comment: error };
      } else {
        await attachDocument({ db, bucket: env.DOCS, who, payment: p, file, data: parsed.data });
        return Astro.redirect(`${self}?ok=${parsed.data.kind === 'factura' ? 'subida' : 'proforma'}#factura`, 303);
      }
    } else if (input.intent === 'doc_link') {
      const r = await linkDocument({ db, who, payment: p, documentId: Number(input.document_id) });
      if (r.ok) return Astro.redirect(`${self}?ok=guardado#factura`, 303);
      error = r.message;
    } else if (input.intent === 'doc_remove' && doc) {
      const r = await removeDocument({ db, bucket: env.DOCS, who, payment: p, document: doc });
      if (r.ok) return Astro.redirect(`${self}?ok=quitada#factura`, 303);
      error = r.message;
    } else if (input.intent === 'doc_conform' && doc) {
      const parsed = validate(ConformSchema, input);
      if (!parsed.ok) {
        error = parsed.message;
      } else {
        const r = await conformInvoice({ db, who, invoiceId: doc.id, data: parsed.data });
        if (r.ok) return Astro.redirect(`${self}?ok=revisada#factura`, 303);
        error = r.message;
      }
    } else if (input.intent === 'save') {
      // Sólo los datos del pago (proveedor, importe, fecha límite…); se paga en su paso, no aquí
      openEdit = true;
      v = { ...p, ...input };
      lines = rawVatLines(form);
      const parsed = validate(PaymentSchema, { ...input, status: 'pendiente' });
      const amounts = parseVatLines(form, rates);
      if (paid) {
        error = PAID_LOCKED;
      } else if (!parsed.ok) {
        error = parsed.message;
        errors = parsed.errors;
      } else if (!amounts.ok) {
        error = amounts.message;
        errors = { amount: amounts.message };
      } else {
        const d = parsed.data;
        await db.batch([
          db.prepare(
            `UPDATE payments SET supplier = ?, concept = ?, base_cents = ?, total_cents = ?, vat = ?, vat_lines = ?,
                    due_date = ?, notes = ?, updated_at = ? WHERE id = ?`,
          ).bind(d.supplier, d.concept, amounts.base, amounts.total, amounts.vat, JSON.stringify(amounts.lines),
            d.due_date, d.notes, nowIso(), pid),
          activityStmt(db, who, id, 'payment.update',
            `${amounts.total !== p.total_cents ? `importe ${eur(p.total_cents)} → ${eur(amounts.total)}` : 'editó el pago'} · ${d.supplier}`),
        ]);
        return Astro.redirect(`${self}?ok=guardado`, 303);
      }
    } else {
      error = 'Esa acción no está permitida.';
    }
  } catch (err) {
    if (!(err instanceof UploadError)) throw err;
    error = err.message;
  }
  Astro.response.status = 400;
}

// Pagos que cubre cada documento (para los compartidos con otros pagos)
const [{ suppliers }, all, shared] = await Promise.all([suggestions(db), expedienteDocuments(db, id), documentsCoverage(db, pid)]);
const state = paymentState(p, now);
const invState = supplierInvoiceState(p);
const saved = linesOf(p);
const receiptHref = fileUrl({ file_id: p.receipt_file_id, file_name: p.receipt_name });
// Documentos ya subidos en el expediente que no están en este pago (los del mismo proveedor, primero)
const linked = new Set(docs.map((d) => d.id));
const choices = all.filter((d) => !linked.has(d.id)).sort((a, b) => (b.supplier === p.supplier) - (a.supplier === p.supplier));
const sameSupplier = `/expedientes/${id}/pagos?nuevo&proveedor=${encodeURIComponent(p.supplier)}`;
const showUpload = openUpload || !docs.length;
// ¿Están hechos todos los pagos que cubre el documento? (para conformar la factura)
const docPaid = (d) => !conformBlocker(d.payment_count > 1 ? shared.get(d.id) ?? [] : [p]);
const needed = needsReceipt(p.method);
// ① justificante → ② pagado → ③ factura conforme
const flow = [
  {
    n: 1, href: '#justificante', title: 'Justificante',
    ...(p.receipt_file_id ? { state: 'is-done', text: 'Subido' }
      : paid && needed ? { state: 'is-warn', text: 'Falta (pago por transferencia)' }
      : paid ? { state: 'is-done', text: `No hace falta · ${PAYMENT_METHODS[p.method] ?? 'sin transferencia'}` }
      : cardOnly ? { state: 'is-waiting', text: 'Si es por transferencia, lo sube Administración' }
      : { state: 'is-current', text: 'Súbelo antes de pagar (si es por transferencia)' }),
  },
  {
    n: 2, href: '#justificante', title: 'Pagado',
    ...(paid ? { state: 'is-done', text: `El ${formatDate(p.paid_on)}${p.method ? ` · ${PAYMENT_METHODS[p.method]}` : ''}` }
      : { state: p.receipt_file_id || cardOnly ? 'is-current' : 'is-waiting', text: p.due_date ? `Límite ${formatDate(p.due_date)}` : 'Sin fecha límite' }),
  },
  {
    n: 3, href: '#factura', title: 'Factura conforme',
    ...(p.invoice_count && !p.invoice_pending ? { state: 'is-done', text: 'Conforme' }
      : p.invoice_pending ? (paid ? { state: 'is-current', text: 'Lista para conformar' } : { state: 'is-waiting', text: 'Recibida: se conforma después del pago' })
      : paid ? { state: 'is-warn', text: 'Falta la factura del proveedor' }
      : { state: 'is-waiting', text: p.proforma_count ? 'Hay proforma; falta la factura' : 'Cuando llegue la factura' }),
  },
];
---
<App title={`${p.supplier} · ${exp.number ? `EXP ${exp.number}` : exp.name}`} section="expedientes" error={error} fieldErrors={errors}>
  <ExpHeader exp={exp} tab="pagos" current={p.concept ? `${p.supplier} · ${p.concept}` : p.supplier} />

  <section class="card">
    <div class="sec-head">
      <h2><Icon name="wallet" /> {p.supplier} <Pill state={state} /></h2>
      <span class:list={['big-money money', { neg: p.total_cents < 0 }]}>{eur(p.total_cents)}</span>
    </div>
    <dl class="kv">
      {p.concept && <><dt>Concepto</dt><dd>{p.concept}</dd></>}
      <dt>Importe</dt>
      <dd>
        {saved.map((l) => <span class="vat-line money">{l.label}: {eur(l.total)} con IVA → {eur(l.base)} sin IVA</span>)}
        {saved.length > 1 && <span class="vat-line money">Total: {eur(p.total_cents)} con IVA → {eur(p.base_cents)} sin IVA</span>}
      </dd>
      {p.status !== 'pagado' && <><dt>Fecha límite</dt><dd>{p.due_date ? `${formatDate(p.due_date)} · ${dueText(p.due_date, now)}` : 'Sin fecha límite'}</dd></>}
      <dt>Alta</dt>
      <dd>{p.planned ? 'Previsión de la solicitud · ' : ''}{p.created_by_name ?? '—'} · {formatStamp(p.created_at)}</dd>
      {p.notes && <><dt>Notas</dt><dd class="msg-body">{p.notes}</dd></>}
    </dl>

    {!locked && (
      <div class="actions-inline mt no-print">
        <a class="btn btn-ghost btn-sm" href={sameSupplier}><Icon name="plus" size={16} /> Otro pago a {p.supplier}</a>
        {canDelete && (
          <form method="post">
            <button class="btn btn-danger btn-sm" type="submit" name="intent" value="delete"
              data-confirm={`¿Borrar el pago a ${p.supplier} de ${eur(p.total_cents)}?${docs.some((d) => d.payment_count === 1) ? ' También se borran sus documentos.' : ''}`}
              data-confirm-ok="Borrar pago"><Icon name="trash-2" size={16} /> Borrar pago</button>
          </form>
        )}
      </div>
    )}
    {!locked && paid && <p class="muted small mt"><Icon name="lock" size={14} /> El pago está hecho: no se puede modificar ni borrar.{!canUnpay && ' Si hay un error, avisa a Administración.'}</p>}
    {!locked && !paid && withConforme && <p class="muted small mt">Tiene una factura conforme: el pago no se puede borrar.</p>}
    {!locked && !paid && !withConforme && !canDelete && <p class="muted small mt">Sólo Administración o quien añadió el pago puede borrarlo.</p>}
  </section>

  <ol class="flow-steps no-print" aria-label="Pasos del pago">
    {flow.map((f) => (
      <li class={f.state}>
        <a href={f.href}>
          <span class="flow-n" aria-hidden="true">{f.state === 'is-done' ? <Icon name="check" size={16} /> : f.n}</span>
          <span class="flow-text"><strong>{f.n}. {f.title}</strong><small>{f.text}</small></span>
        </a>
      </li>
    ))}
  </ol>

  <section class="card mt" id="justificante">
    <div class="sec-head">
      <h2><Icon name="banknote" /> 1. Justificante · 2. Pago</h2>
      {receiptHref ? <span class="pill pill-ok">Con justificante</span>
        : receiptLocked ? <span class="pill pill-danger">Falta el justificante</span> : null}
    </div>
    {paid && (
      <dl class="kv">
        <dt>Pagado</dt><dd>{formatDate(p.paid_on)}{p.method && ` · ${PAYMENT_METHODS[p.method]}`}</dd>
      </dl>
    )}
    {receiptHref && (
      <div class="doc-current mt">
        <Icon name="paperclip" size={16} />
        <a href={receiptHref} target="_blank" rel="noopener">{p.receipt_name}</a>
        {!locked && !paid && (
          <form method="post">
            <button class="btn btn-danger btn-sm" type="submit" name="intent" value="receipt_remove"
              data-confirm="¿Quitar el justificante? Se borra del expediente." data-confirm-ok="Quitar justificante"><Icon name="trash-2" size={14} /> Quitar</button>
          </form>
        )}
      </div>
    )}
    {!locked && !paid && (
      <form method="post" enctype="multipart/form-data" class="form mt" data-has-receipt={p.receipt_file_id ? '1' : '0'}>
        <input type="hidden" name="payment_id" value={p.id} />
        {cardOnly ? (
          <FileField id="pay-receipt" name="receipt" label={p.receipt_file_id ? 'Cambiar el recibo' : 'Recibo o justificante (PDF o foto)'}
            hint="El ticket de la tarjeta, si lo tienes. Las transferencias las paga y las marca Administración con su justificante." />
        ) : (
          <FileField id="pay-receipt" name="receipt" optional={false} label={p.receipt_file_id ? 'Cambiar el justificante' : 'Justificante bancario (PDF o foto)'}
            hint="Obligatorio para marcar como pagado un pago por transferencia." />
        )}
        <>
            <div class="row row-2">
              <div class="field">
                <label for="paid_on_quick">Fecha de pago</label>
                <input id="paid_on_quick" type="date" name="paid_on" value={now} />
              </div>
              {cardOnly ? (
                <div class="field">
                  <span class="label">Forma de pago</span>
                  <input type="hidden" name="method" value="tarjeta" />
                  <p class="muted">{PAYMENT_METHODS.tarjeta}: desde Eventos sólo se marcan los pagos hechos con tarjeta.</p>
                </div>
              ) : (
                <div class="field">
                  <label for="method_quick">Forma de pago</label>
                  <select id="method_quick" name="method">
                    {Object.entries(PAYMENT_METHODS).map(([k, l]) => <option value={k}>{l}</option>)}
                  </select>
                </div>
              )}
            </div>
            <div class="actions-inline">
              {cardOnly
                ? <button class="btn btn-primary" type="submit" name="intent" value="pay" data-busy="Guardando…"><Icon name="credit-card" size={18} /> Pagado con tarjeta</button>
                : <button class="btn btn-primary" type="submit" name="intent" value="pay" data-receipt-check data-busy="Guardando…"><Icon name="check" size={18} /> Pagado</button>}
              <button class="btn btn-ghost" type="submit" name="intent" value="receipt" data-busy="Subiendo…"><Icon name="upload" size={18} /> {cardOnly ? 'Sólo subir el recibo' : 'Sólo subir el justificante'}</button>
            </div>
        </>
      </form>
    )}
    {!locked && paid && !p.receipt_file_id && (
      <details class="add mt" open={needed}>
        <summary class="btn btn-ghost btn-sm"><Icon name="upload" size={16} /> {needed ? 'Añadir el justificante que falta' : 'Añadir justificante (opcional)'}</summary>
        <form method="post" enctype="multipart/form-data" class="form-section">
          <FileField id="pay-receipt" name="receipt" optional={false} label="Justificante (PDF o foto)" required />
          <div><button class="btn btn-primary btn-sm" type="submit" name="intent" value="receipt" data-busy="Subiendo…"><Icon name="upload" size={16} /> Subir justificante</button></div>
        </form>
      </details>
    )}
    {canUnpay && (
      <form method="post" class="actions-inline mt">
        <button class="btn btn-ghost btn-sm" type="submit" name="intent" value="unpay"
          data-confirm="¿Deshacer el pago? Vuelve a quedar por pagar para corregir lo que esté mal (importe, fecha, justificante) y se apunta en la actividad."
          data-confirm-ok="Deshacer pagado"><Icon name="rotate-ccw" size={16} /> Deshacer pagado</button>
        <span class="muted small">Sólo para corregir un error: el pago vuelve a «Por pagar».</span>
      </form>
    )}
  </section>

  <section class="card mt" id="factura">
    <div class="sec-head">
      <h2><Icon name="paperclip" /> 3. Facturas y proformas {invState && <Pill state={invState} />}</h2>
      <p>La factura se da por conforme cuando el pago está hecho. Las proformas no avisan a nadie. Una factura conforme no se puede borrar.</p>
    </div>

    {docs.length ? (
      <ul class="doc-list">
        {docs.map((d) => {
          const href = fileUrl({ file_id: d.file_id, file_name: d.file_name });
          const covered = d.payment_count > 1 ? shared.get(d.id) ?? [] : [];
          const coveredTotal = covered.length ? covered.reduce((a, x) => a + x.total_cents, 0) : p.total_cents;
          return (
            <li class="doc">
              <div class="doc-head">
                <Pill state={documentState(d, docPaid(d))} />
                <strong>{d.number ? `${DOC_KINDS[d.kind]} ${d.number}` : `${DOC_KINDS[d.kind]} sin número`}</strong>
                {d.issued_on && <span class="muted">· {formatDate(d.issued_on)}</span>}
                {d.total_cents != null && <span class="money">· {eur(d.total_cents)}</span>}
              </div>
              {href ? <a class="doc-link" href={href} target="_blank" rel="noopener"><Icon name="file-text" size={15} />{d.file_name}</a> : <span class="muted small">Sin archivo</span>}
              <p class="muted small">
                Subido por {d.uploaded_by_name ?? '—'} · {formatStamp(d.uploaded_at)}
                {d.kind === 'factura' && (d.review === 'conforme'
                  ? <> · Conforme ({d.reviewed_by_name ?? '—'}{d.reviewed_at && `, ${formatStamp(d.reviewed_at)}`})</>
                  : docPaid(d) ? <> · <span class="warn-text">pendiente de que Administración la revise</span></>
                  : <> · se revisa cuando el pago esté hecho</>)}
              </p>
              {d.notes && <p class="doc-note"><Icon name="message-square" size={15} /> {d.notes}</p>}
              {covered.length > 1 && (
                <p class="small">Cubre {covered.length} pagos:{' '}
                  {covered.map((c, i) => <>{i > 0 && ' · '}{c.id === p.id ? <strong>este</strong> : <a href={`/expedientes/${id}/pagos/${c.id}`}>{c.supplier}{c.concept && ` (${c.concept})`}</a>} {eur(c.total_cents)}</>)}
                </p>
              )}
              {d.kind === 'factura' && d.total_cents != null && (d.total_cents === coveredTotal
                ? <span class="pill pill-ok">Cuadra con {covered.length > 1 ? 'los pagos' : 'el pago'}</span>
                : <span class="pill pill-danger">No cuadra: {covered.length > 1 ? 'los pagos suman' : 'el pago es de'} {eur(coveredTotal)}</span>)}

              {!locked && (
                <div class="actions-inline doc-actions no-print">
                  {admin && d.kind === 'factura' && d.review !== 'conforme' && !docPaid(d) && (
                    <span class="muted small"><Icon name="lock" size={14} /> Se conforma cuando {d.payment_count > 1 ? 'todos los pagos que cubre estén hechos' : 'el pago esté hecho'}</span>
                  )}
                  {admin && d.kind === 'factura' && d.review !== 'conforme' && docPaid(d) && (
                    <form method="post" class="quick-form">
                      <input type="hidden" name="intent" value="doc_conform" />
                      <input type="hidden" name="document_id" value={d.id} />
                      <label class="visually-hidden" for={`conf-number-${d.id}`}>Nº de factura</label>
                      <input id={`conf-number-${d.id}`} name="invoice_number" type="text" required maxlength="60" value={d.number ?? ''} placeholder="Nº de factura" />
                      <label class="visually-hidden" for={`conf-date-${d.id}`}>Fecha de la factura</label>
                      <input id={`conf-date-${d.id}`} name="invoice_date" type="date" value={d.issued_on ?? ''} />
                      <button class="btn btn-primary btn-sm" type="submit" data-busy="Guardando…"><Icon name="check" size={16} /> Conforme</button>
                    </form>
                  )}
                  {canRemoveDocument(me, d) && (
                    <form method="post">
                      <input type="hidden" name="document_id" value={d.id} />
                      <button class="btn btn-danger btn-sm" type="submit" name="intent" value="doc_remove"
                        data-confirm={d.payment_count > 1
                          ? `¿Quitar la ${docName(d)} de este pago? Seguirá en los otros ${d.payment_count - 1} pagos que cubre.`
                          : `¿Borrar la ${docName(d)}? Se borra también su archivo.`}
                        data-confirm-ok={d.payment_count > 1 ? 'Quitar de este pago' : 'Borrar'}><Icon name="trash-2" size={16} /> {d.payment_count > 1 ? 'Quitar de este pago' : 'Borrar'}</button>
                    </form>
                  )}
                  {isConforme(d) && <span class="muted small"><Icon name="lock" size={14} /> Conforme: no se puede borrar</span>}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="muted">{p.status === 'pagado' ? 'Este pago ya está hecho y falta la factura del proveedor: reclámala y súbela aquí.' : 'Todavía no tiene factura ni proforma.'}</p>
    )}

    {!locked && (
      <>
        <details class="add mt" open={showUpload}>
          <summary class="btn btn-primary btn-sm"><Icon name="upload" size={16} /> <span class="when-closed">Subir factura o proforma</span><span class="when-open">Cerrar</span></summary>
          <form method="post" enctype="multipart/form-data" class="form-section">
            {withConforme && (
              <p class="warn-text small">Este pago ya tiene una factura conforme, que no se puede borrar. Si subes otra factura,
                explica en el comentario por qué: Administración tendrá que revisarla.</p>
            )}
            <SupplierDocFields v={docValues} errors={openUpload ? errors : {}} id="doc" fileRequired comment={withConforme ? 'required' : 'optional'} />
            <div><button class="btn btn-primary" type="submit" name="intent" value="doc_new" data-busy="Subiendo…"><Icon name="upload" size={18} /> Subir documento</button></div>
          </form>
        </details>
        {choices.length > 0 && (
          <details class="add">
            <summary class="btn btn-ghost btn-sm"><Icon name="link" size={16} /> ¿Es un documento que ya está subido?</summary>
            <form method="post" class="form-section">
              <p class="muted small">Cuando el proveedor manda una única factura para varios pagos (p. ej. dos anticipos), súbela en uno y elígela aquí en los demás.</p>
              <div class="field">
                <label for="document_id">Documento</label>
                <select id="document_id" name="document_id" required>
                  {choices.map((c) => <option value={c.id}>{DOC_KINDS[c.kind]} {c.number ?? 'sin nº'} · {c.supplier}</option>)}
                </select>
              </div>
              <div><button class="btn btn-ghost" type="submit" name="intent" value="doc_link"><Icon name="link" size={18} /> Usar este documento</button></div>
            </form>
          </details>
        )}
      </>
    )}
  </section>

  {!locked && !paid && (
    <details class="add mt" open={openEdit}>
      <summary class="btn btn-ghost"><Icon name="pencil" size={18} /> <span class="when-closed">Editar el pago</span><span class="when-open">Cerrar edición</span></summary>
      <form method="post" class="form-section">
        <PaymentForm v={v} errors={errors} suppliers={suppliers} rates={rates} lines={lines} withStatus={false} id="edit" />
        <div class="actions-inline">
          <button class="btn btn-primary" type="submit" name="intent" value="save" data-busy="Guardando…">Guardar cambios</button>
        </div>
      </form>
    </details>
  )}
</App>
