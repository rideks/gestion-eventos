---
// Ficha de un pago a proveedor: de qué era, su factura, el desglose de IVA y cuándo se pagó.
// Debajo, plegado, el formulario para añadirle la factura cuando llega o corregir algo.
import { env } from 'cloudflare:workers';
import App from '../../../../layouts/App.astro';
import Icon from '../../../../components/Icon.astro';
import ExpHeader from '../../../../components/ExpHeader.astro';
import PaymentForm from '../../../../components/PaymentForm.astro';
import Pill from '../../../../components/Pill.astro';
import { parseId, readForm, actor, can, activityStmt } from '../../../../lib/app.js';
import { getExpediente, suggestions } from '../../../../lib/data.js';
import { PaymentSchema, validate, formToObject } from '../../../../lib/validate.js';
import { loadRates, parseVatLines, rawVatLines, linesOf } from '../../../../lib/vat.js';
import { storeFile, getFile, deleteFiles, fileUrl, UploadError } from '../../../../lib/files.js';
import { paymentState, PAYMENT_METHODS } from '../../../../lib/finance.js';
import { eur } from '../../../../lib/money.js';
import { today, nowIso, formatDate, formatStamp, dueText } from '../../../../lib/dates.js';
import { isLocked, LOCKED_MSG, markPaid } from '../../../../lib/actions.js';

const db = env.DB;
const id = parseId(Astro.params.id);
const pid = parseId(Astro.params.pid);
const exp = id ? await getExpediente(db, id) : null;
const p = exp && pid ? await db.prepare(
  `SELECT p.*, f.name AS file_name, u.name AS created_by_name FROM payments p
     LEFT JOIN files f ON f.id = p.file_id LEFT JOIN users u ON u.id = p.created_by
    WHERE p.id = ? AND p.expediente_id = ?`,
).bind(pid, id).first() : null;
if (!p) return Astro.rewrite('/404');

const me = Astro.locals.user;
const now = today();
const locked = isLocked(exp);
const canDelete = !locked && (can(me, 'delete') || p.created_by === me.id);
const back = `/expedientes/${id}/pagos`;
const rates = await loadRates(db);
let error = null;
let errors = {};
let v = { ...p };
let lines = linesOf(p);

if (Astro.request.method === 'POST') {
  const who = actor(Astro);
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};

  if (locked) {
    error = LOCKED_MSG;
  } else if (input.intent === 'pay') {
    const r = await markPaid(db, who, input, id);
    if (r.ok) return Astro.redirect(`/expedientes/${id}/pagos/${pid}?ok=pagado`, 303);
    error = r.message;
  } else if (input.intent === 'delete' && canDelete) {
    await db.batch([
      db.prepare('DELETE FROM payments WHERE id = ?').bind(pid),
      activityStmt(db, who, id, 'payment.delete', `borró ${p.invoice_number ? `la factura ${p.invoice_number}` : 'el pago'} de ${p.supplier} (${eur(p.total_cents)})`),
    ]);
    await deleteFiles(db, env.DOCS, [p.file_id]);
    return Astro.redirect(`${back}?ok=borrado`, 303);
  } else if (input.intent === 'save') {
    v = { ...p, ...input };
    lines = rawVatLines(form);
    const parsed = validate(PaymentSchema, input);
    const amounts = parseVatLines(form, rates);
    if (!parsed.ok) {
      error = parsed.message;
      errors = parsed.errors;
    } else if (!amounts.ok) {
      error = amounts.message;
      errors = { amount: amounts.message };
    } else {
      const d = parsed.data;
      try {
        const file = getFile(form, 'file');
        const fileId = file ? await storeFile({ db, bucket: env.DOCS, file, expedienteId: id, userId: me.id }) : p.file_id;
        // Qué ha cambiado, para la actividad
        const what = [];
        if (d.invoice_number && !p.invoice_number) what.push(`añadió la factura ${d.invoice_number}`);
        if (file && p.file_id) what.push('cambió el documento');
        else if (file) what.push('adjuntó el documento');
        if (amounts.total !== p.total_cents) what.push(`importe ${eur(p.total_cents)} → ${eur(amounts.total)}`);
        if (d.status === 'pagado' && p.status !== 'pagado') what.push('lo marcó como pagado');
        if (d.status !== 'pagado' && p.status === 'pagado') what.push('lo volvió a dejar por pagar');
        await db.batch([
          db.prepare(
            `UPDATE payments SET supplier = ?, concept = ?, invoice_number = ?, invoice_date = ?, base_cents = ?, total_cents = ?, vat = ?, vat_lines = ?,
                    due_date = ?, status = ?, paid_on = ?, method = ?, file_id = ?, notes = ?, updated_at = ? WHERE id = ?`,
          ).bind(d.supplier, d.concept, d.invoice_number, d.invoice_date, amounts.base, amounts.total, amounts.vat, JSON.stringify(amounts.lines),
            d.due_date, d.status, d.status === 'pagado' ? d.paid_on : null, d.status === 'pagado' ? d.method : null, fileId, d.notes, nowIso(), pid),
          activityStmt(db, who, id, 'payment.update', `${what.length ? what.join(', ') : 'editó'} · ${d.supplier}`),
        ]);
        if (file && p.file_id) await deleteFiles(db, env.DOCS, [p.file_id]);
        return Astro.redirect(`/expedientes/${id}/pagos/${pid}?ok=guardado`, 303);
      } catch (err) {
        if (!(err instanceof UploadError)) throw err;
        error = err.message;
      }
    }
  }
  Astro.response.status = 400;
}

const { suppliers } = await suggestions(db);
const state = paymentState(p, now);
const saved = linesOf(p);
const doc = fileUrl(p);
const missingInvoice = !p.invoice_number && p.total_cents !== 0;
// El formulario sale abierto si hay un error, si aún falta la factura o si se pide (?editar)
const openEdit = !!error || (missingInvoice && !locked) || Astro.url.searchParams.has('editar');
const sameSupplier = `/expedientes/${id}/pagos?nuevo&proveedor=${encodeURIComponent(p.supplier)}`;
---
<App title={`${p.supplier} · ${exp.number ? `EXP ${exp.number}` : exp.name}`} section="expedientes" error={error}>
  <ExpHeader exp={exp} tab="pagos" />
  <a class="back" href={back}><Icon name="arrow-left" size={18} /> Pagos del expediente</a>

  <section class="card">
    <div class="sec-head">
      <h2><Icon name="receipt" /> {p.supplier} <Pill state={state} /></h2>
      <span class:list={['big-money money', { neg: p.total_cents < 0 }]}>{eur(p.total_cents)}</span>
    </div>
    <dl class="kv">
      {p.concept && <><dt>Concepto</dt><dd>{p.concept}</dd></>}
      <dt>Factura</dt>
      <dd>{p.invoice_number ? <>{p.invoice_number}{p.invoice_date && ` · ${formatDate(p.invoice_date)}`}</> : <span class="pill pill-warn">Aún sin factura del proveedor</span>}</dd>
      <dt>Documento</dt>
      <dd>{doc ? <a href={doc} target="_blank" rel="noopener"><Icon name="paperclip" size={15} /> {p.file_name}</a> : '—'}</dd>
      <dt>Importe</dt>
      <dd>
        {saved.map((l) => (
          <span class="vat-line money">{l.label}: {eur(l.base)} sin IVA → <strong>{eur(l.total)}</strong></span>
        ))}
        {saved.length > 1 && <span class="vat-line money">Total: {eur(p.base_cents)} sin IVA → <strong>{eur(p.total_cents)}</strong></span>}
      </dd>
      {p.status === 'pagado'
        ? <><dt>Pagado</dt><dd>{formatDate(p.paid_on)}{p.method && ` · ${PAYMENT_METHODS[p.method]}`}</dd></>
        : <><dt>Fecha límite</dt><dd>{p.due_date ? `${formatDate(p.due_date)} · ${dueText(p.due_date, now)}` : 'Sin fecha límite'}</dd></>}
      <dt>Origen</dt>
      <dd>{p.planned ? 'Previsión de pagos de la solicitud' : 'Añadido después'}{p.created_by_name && ` · ${p.created_by_name}`} · {formatStamp(p.created_at)}</dd>
      {p.notes && <><dt>Notas</dt><dd class="msg-body">{p.notes}</dd></>}
    </dl>

    {!locked && (
      <div class="actions-inline mt no-print">
        {p.status !== 'pagado' && (
          <form method="post" class="quick-form">
            <input type="hidden" name="intent" value="pay" />
            <input type="hidden" name="payment_id" value={p.id} />
            <label class="visually-hidden" for="paid_on_quick">Fecha de pago</label>
            <input id="paid_on_quick" type="date" name="paid_on" value={now} required />
            <label class="visually-hidden" for="method_quick">Forma de pago</label>
            <select id="method_quick" name="method">
              {Object.entries(PAYMENT_METHODS).map(([k, l]) => <option value={k}>{l}</option>)}
            </select>
            <button class="btn btn-sm" type="submit" data-busy="Guardando…"><Icon name="check" size={16} /> Pagado</button>
          </form>
        )}
        <a class="btn btn-ghost btn-sm" href={sameSupplier}><Icon name="plus" size={16} /> Otro pago a {p.supplier}</a>
      </div>
    )}
  </section>

  {!locked && (
    <details class="add mt" open={openEdit}>
      <summary class="btn btn-ghost"><Icon name={missingInvoice ? 'paperclip' : 'pencil'} size={18} />
        <span class="when-closed">{missingInvoice ? 'Añadir la factura' : 'Editar'}</span><span class="when-open">Cerrar edición</span></summary>
      <form method="post" enctype="multipart/form-data" class="form-section">
        <PaymentForm v={v} errors={errors} suppliers={suppliers} current={p.file_id ? p : null} rates={rates} lines={lines} id="edit" />
        <div class="actions-inline">
          <button class="btn btn-primary" type="submit" name="intent" value="save" data-busy="Guardando…">Guardar cambios</button>
          {canDelete && <button class="btn btn-danger btn-sm" type="submit" name="intent" value="delete" formnovalidate data-confirm="¿Borrar esta línea? También se borra su documento.">
            <Icon name="trash-2" size={16} /> Borrar</button>}
        </div>
      </form>
    </details>
  )}
</App>
