---
// Una factura al cliente: borrador / pedida («Por emitir») → emitida (número automático) → enviada al
// cliente (envío simulado) → cobrada. Una factura emitida ya no se modifica: si tiene un error se anula
// y se hace otra. «Ver la factura» enseña el documento listo para imprimir o guardar en PDF.
import { env } from 'cloudflare:workers';
import App from '../../../../layouts/App.astro';
import Icon from '../../../../components/Icon.astro';
import ExpHeader from '../../../../components/ExpHeader.astro';
import InvoiceForm from '../../../../components/InvoiceForm.astro';
import FileField from '../../../../components/FileField.astro';
import Pill from '../../../../components/Pill.astro';
import { parseId, readForm, actor, can, activityStmt, deny } from '../../../../lib/app.js';
import { getExpediente, loadFinance, suggestions, knownClients } from '../../../../lib/data.js';
import { SendSchema, validate, formToObject } from '../../../../lib/validate.js';
import { getFile, fileUrl, UploadError } from '../../../../lib/files.js';
import { storeFile, deleteFiles } from '../../../../services/files.js';
import { invoiceState, sentState } from '../../../../lib/finance.js';
import { eur } from '../../../../lib/money.js';
import { loadRates, rawVatLines, linesOf } from '../../../../lib/vat.js';
import {
  readInvoiceForm, invoiceValues, INVOICE_FIELDS, issueInvoice, markSent, peekInvoiceNumber, invoiceSettings, invoiceEmail, DUE_DAYS,
} from '../../../../lib/invoicing.js';
import { today, nowIso, addDays, formatDate, formatStamp } from '../../../../lib/dates.js';
import { isLocked, LOCKED_MSG, markCollected } from '../../../../lib/actions.js';

// Sólo Administración ve los cobros
const denied = deny(Astro, 'cobros');
if (denied) return denied;
const db = env.DB;
const id = parseId(Astro.params.id);
const fid = parseId(Astro.params.fid);
const now = today();
// Todo a la vez (una sola espera a la base de datos)
const [exp, inv, fin, rates, settings] = id && fid ? await Promise.all([
  getExpediente(db, id),
  db.prepare(
    `SELECT i.*, f.name AS file_name, u.name AS created_by_name, s.name AS sent_by_name FROM invoices i
       LEFT JOIN files f ON f.id = i.file_id LEFT JOIN users u ON u.id = i.created_by LEFT JOIN users s ON s.id = i.sent_by
      WHERE i.id = ? AND i.expediente_id = ?`,
  ).bind(fid, id).first(),
  loadFinance(db, id, now),
  loadRates(db),
  invoiceSettings(db),
]) : [];
if (!exp || !inv) return Astro.rewrite('/404');

const me = Astro.locals.user;
const admin = can(me, 'invoice.issue');
const locked = isLocked(exp);
const draft = inv.status === 'por_emitir';
const issued = inv.status === 'emitida' || inv.status === 'cobrada';
const allocated = new Map(fin.allocations.filter((a) => a.invoice_id === fid).map((a) => [a.po_id, a.amount_cents]));
// El borrador / la pedida la puede corregir cualquiera; emitida ya no se toca (se anula y se hace otra)
const editable = !locked && draft;
const canDelete = !locked && ((draft && (admin || inv.created_by === me.id)) || (admin && inv.status === 'anulada'));
const back = `/expedientes/${id}/cobros`;
const self = `/expedientes/${id}/facturas/${fid}`;
const poNumbers = fin.allocations.filter((a) => a.invoice_id === fid).map((a) => a.po_number).join(', ');
let error = null;
let errors = {};
let v = { ...inv, issued_on: inv.issued_on ?? now, due_date: inv.due_date ?? addDays(now, DUE_DAYS) };
let checked = null;
let lines = linesOf(inv);
let sendTo = inv.sent_to ?? inv.billed_email ?? exp.contact_email ?? '';

if (Astro.request.method === 'POST') {
  const who = actor(Astro);
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};
  const label = inv.number ? `la factura ${inv.number}` : `la factura pedida a ${inv.billed_to}`;

  try {
    if (locked) {
      error = LOCKED_MSG;
    } else if (input.intent === 'collect') {
      const r = await markCollected(db, who, input, id);
      if (r.ok) return Astro.redirect(`${back}?ok=cobrada`, 303);
      error = r.message;
    } else if (input.intent === 'uncollect' && admin && inv.status === 'cobrada') {
      await db.batch([
        db.prepare("UPDATE invoices SET status = 'emitida', collected_on = NULL, updated_at = ? WHERE id = ?").bind(nowIso(), fid),
        activityStmt(db, who, id, 'invoice.uncollect', `deshizo el cobro de ${label}`),
      ]);
      return Astro.redirect(`${self}?ok=guardado`, 303);
    } else if (input.intent === 'void' && admin && issued) {
      await db.batch([
        db.prepare("UPDATE invoices SET status = 'anulada', updated_at = ? WHERE id = ?").bind(nowIso(), fid),
        activityStmt(db, who, id, 'invoice.void', `anuló ${label} (${eur(inv.total_cents)}). Sus PO vuelven a quedar sin facturar.`),
      ]);
      return Astro.redirect(`${back}?ok=guardado`, 303);
    } else if (input.intent === 'send' && admin && issued) {
      const parsed = validate(SendSchema, input);
      sendTo = String(input.sent_to ?? '');
      if (!parsed.ok) {
        error = parsed.message;
        errors = parsed.errors;
      } else {
        await markSent({ db, who, inv, to: parsed.data.sent_to });
        return Astro.redirect(`${self}?ok=envio`, 303);
      }
    } else if (input.intent === 'upload_file' && admin && issued) {
      const file = getFile(form, 'file');
      if (!file) {
        error = 'Elige el PDF de la factura.';
      } else {
        const fileId = await storeFile({ db, bucket: env.DOCS, file, expedienteId: id, userId: me.id });
        await db.batch([
          db.prepare('UPDATE invoices SET file_id = ?, updated_at = ? WHERE id = ?').bind(fileId, nowIso(), fid),
          activityStmt(db, who, id, 'invoice.file', `${inv.file_id ? 'cambió' : 'subió'} el PDF de ${label}`),
        ]);
        if (inv.file_id) await deleteFiles(db, env.DOCS, [inv.file_id]);
        return Astro.redirect(`${self}?ok=guardado`, 303);
      }
    } else if (input.intent === 'remove_file' && admin && inv.file_id) {
      await db.batch([
        db.prepare('UPDATE invoices SET file_id = NULL, updated_at = ? WHERE id = ?').bind(nowIso(), fid),
        activityStmt(db, who, id, 'invoice.file', `quitó el PDF de ${label}`),
      ]);
      await deleteFiles(db, env.DOCS, [inv.file_id]);
      return Astro.redirect(`${self}?ok=guardado`, 303);
    } else if (input.intent === 'delete' && canDelete) {
      await db.batch([
        db.prepare('DELETE FROM invoices WHERE id = ?').bind(fid),
        activityStmt(db, who, id, 'invoice.delete', `borró ${label} (${eur(inv.total_cents)})`),
      ]);
      await deleteFiles(db, env.DOCS, [inv.file_id]);
      return Astro.redirect(`${back}?ok=borrado`, 303);
    } else if (['save', 'emit', 'emit_send'].includes(input.intent) && editable) {
      // Guardar el borrador y, si es Administración, emitirla (y enviarla)
      const intent = admin ? input.intent : 'save';
      v = { ...inv, ...input };
      checked = form.getAll('po_ids').map(Number);
      lines = rawVatLines(form);
      const r = readInvoiceForm({
        form, input, poRows: fin.summary.poRows, rates, allocated, today: now,
        mode: intent === 'emit_send' ? 'send' : intent === 'emit' ? 'emit' : 'draft',
      });
      if (!r.ok) {
        error = r.message;
        errors = r.errors ?? {};
      } else {
        const d = r.data;
        await db.batch([
          db.prepare(`UPDATE invoices SET (${INVOICE_FIELDS}) = (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?), updated_at = ? WHERE id = ?`)
            .bind(...invoiceValues(d, r.amounts), nowIso(), fid),
          db.prepare('DELETE FROM invoice_pos WHERE invoice_id = ?').bind(fid),
          ...r.alloc.rows.map((a) => db.prepare('INSERT INTO invoice_pos (invoice_id, po_id, amount_cents) VALUES (?, ?, ?)').bind(fid, a.po_id, a.amount)),
          ...(intent === 'save' ? [activityStmt(db, who, id, 'invoice.update', `editó la factura por emitir a ${d.billed_to} (${eur(d.total)})`)] : []),
        ]);
        if (intent === 'save') return Astro.redirect(`${self}?ok=guardado`, 303);
        const number = await issueInvoice({
          db, invoiceId: fid, issuedOn: d.issued_on, dueDate: d.due_date,
          extra: (n) => [activityStmt(db, who, id, 'invoice.issue', `emitió la factura ${n} a ${d.billed_to} (${eur(d.total)})`)],
        });
        if (intent === 'emit_send') {
          await markSent({ db, who, inv: { ...inv, number, total_cents: d.total }, to: d.billed_email });
          return Astro.redirect(`${self}?ok=enviada`, 303);
        }
        return Astro.redirect(`${self}?ok=emitida`, 303);
      }
    } else {
      error = draft ? 'Esa acción no está permitida.' : 'Una factura emitida no se modifica: si tiene un error, anúlala y haz otra.';
    }
  } catch (err) {
    if (!(err instanceof UploadError)) throw err;
    error = err.message;
  }
  Astro.response.status = 400;
}

const [{ billed: companies }, clients, next] = await Promise.all([
  suggestions(db),
  editable ? knownClients(db) : [],
  editable && admin ? peekInvoiceNumber(db, Number(now.slice(0, 4))) : null,
]);
// La pedida suele llegar sin datos fiscales: los del cliente si ya se le ha facturado (y su email)
if (editable && Astro.request.method !== 'POST') {
  const known = clients.find((c) => c.billed_to.toLowerCase() === String(inv.billed_to).toLowerCase()) ?? {};
  v = {
    ...v,
    billed_tax_id: v.billed_tax_id || known.billed_tax_id || '',
    billed_address: v.billed_address || known.billed_address || '',
    billed_email: v.billed_email || known.billed_email || exp.contact_email || '',
  };
}
const state = invoiceState(inv, now);
const sent = sentState(inv);
const poList = fin.allocations.filter((a) => a.invoice_id === fid);
const title = inv.number ? `Factura ${inv.number}` : 'Factura por emitir';
const email = issued ? invoiceEmail(inv, settings.company, poNumbers) : null;
const justSent = ['enviada', 'envio'].includes(Astro.url.searchParams.get('ok'));
---
<App title={title} section="expedientes" error={error} fieldErrors={errors}>
  <ExpHeader exp={exp} tab="cobros" current={title} />

  <section class="card">
    <div class="sec-head">
      <h2><Icon name="receipt" /> {title} <Pill state={state} /> {sent && <Pill state={sent} />}</h2>
      <span class="big-money money">{eur(inv.total_cents)}</span>
    </div>
    <dl class="kv">
      <dt>Cliente</dt>
      <dd>{inv.billed_to}{inv.billed_tax_id && ` · ${inv.billed_tax_id}`}{inv.billed_address && <span class="vat-line muted">{inv.billed_address}</span>}</dd>
      {inv.billed_email && <><dt>Email</dt><dd>{inv.billed_email}</dd></>}
      {inv.concept && <><dt>Concepto</dt><dd class="msg-body">{inv.concept}</dd></>}
      <dt>Importe</dt>
      <dd>
        {linesOf(inv).map((l) => <span class="vat-line money">{l.label}: {eur(l.base)} sin IVA → <strong>{eur(l.total)}</strong></span>)}
        {linesOf(inv).length > 1 && <span class="vat-line money">Total: {eur(inv.base_cents)} sin IVA → <strong>{eur(inv.total_cents)}</strong></span>}
      </dd>
      {poList.length > 0 && <><dt>PO</dt><dd>{poList.map((a) => `${a.po_number} (${eur(a.amount_cents)})`).join(' · ')}</dd></>}
      <dt>{draft ? 'Pedida' : 'Creada'}</dt><dd>{inv.created_by_name ?? '—'} · {formatStamp(inv.created_at)}</dd>
      {inv.issued_on && <><dt>Emitida</dt><dd>{formatDate(inv.issued_on)}{inv.due_date && ` · vence ${formatDate(inv.due_date)}`}</dd></>}
      {inv.sent_at && <><dt>Enviada</dt><dd>{formatStamp(inv.sent_at)}{inv.sent_to ? ` · a ${inv.sent_to}` : ' · fuera de la aplicación'}{inv.sent_by_name && ` · ${inv.sent_by_name}`}</dd></>}
      {inv.collected_on && <><dt>Cobrada</dt><dd>{formatDate(inv.collected_on)}</dd></>}
      {inv.file_id && <><dt>PDF</dt><dd><a href={fileUrl(inv)} target="_blank" rel="noopener">{inv.file_name}</a></dd></>}
      {inv.notes && <><dt>Notas</dt><dd class="msg-body">{inv.notes}</dd></>}
    </dl>

    <div class="actions-inline mt no-print">
      <a class="btn btn-ghost btn-sm" href={`${self}/documento`} target="_blank" rel="noopener"><Icon name="file-text" size={16} /> {draft ? 'Ver el borrador' : 'Ver la factura'}</a>
      {admin && !locked && inv.status === 'emitida' && (
        <form method="post" class="quick-form">
          <input type="hidden" name="invoice_id" value={inv.id} />
          <label class="visually-hidden" for="collected_on">Fecha de cobro</label>
          <input id="collected_on" type="date" name="collected_on" value={now} required />
          <button class="btn btn-sm" type="submit" name="intent" value="collect"><Icon name="check" size={16} /> Marcar cobrada</button>
        </form>
      )}
      {admin && !locked && inv.status === 'cobrada' && (
        <form method="post"><button class="btn btn-ghost btn-sm" type="submit" name="intent" value="uncollect"><Icon name="rotate-ccw" size={16} /> Deshacer cobro</button></form>
      )}
      {admin && !locked && issued && (
        <form method="post"><button class="btn btn-danger btn-sm" type="submit" name="intent" value="void" data-confirm="¿Anular esta factura? Deja de contar y sus PO vuelven a quedar sin facturar (luego haz la rectificativa o la nueva)." data-confirm-ok="Anular">Anular</button></form>
      )}
    </div>
    {issued && <p class="muted small mt"><Icon name="lock" size={14} /> Emitida: no se modifica. Si tiene un error, anúlala y haz otra.</p>}
  </section>

  {issued && email && (
    <section class="card mt" id="envio">
      <div class="sec-head">
        <h2><Icon name="send" /> Envío al cliente</h2>
        <p>Simulado: todavía no sale ningún correo. Queda apuntado a quién y cuándo se envió.</p>
      </div>
      <div class:list={['mail-preview', { 'is-sent': justSent }]}>
        {justSent && <p class="mail-sent"><Icon name="circle-check" size={18} /> Enviada a {inv.sent_to} (simulación)</p>}
        <p><span class="muted">Para:</span> {inv.sent_to ?? inv.billed_email ?? '—'}</p>
        <p><span class="muted">Asunto:</span> {email.subject}</p>
        <p class="mail-body">{email.body}</p>
        <p class="muted small"><Icon name="paperclip" size={14} /> Factura {inv.number}.pdf</p>
      </div>
      {admin && !locked && (
        <form method="post" class="quick-form send-form mt">
          <label class="visually-hidden" for="sent_to">Email de facturación</label>
          <input id="sent_to" name="sent_to" type="email" required value={sendTo} placeholder="facturas@cliente.com" />
          <button class:list={['btn btn-sm', inv.sent_at ? 'btn-ghost' : 'btn-primary']} type="submit" name="intent" value="send" data-busy="Enviando…">
            <Icon name="send" size={16} /> {inv.sent_at ? 'Reenviar' : 'Enviar al cliente'}</button>
        </form>
      )}
    </section>
  )}

  {issued && admin && !locked && (
    <details class="add mt">
      <summary class="btn btn-ghost btn-sm"><Icon name="upload" size={16} /> {inv.file_id ? 'Cambiar el PDF' : 'Adjuntar el PDF (opcional)'}</summary>
      <form method="post" enctype="multipart/form-data" class="form-section">
        <FileField id="inv-file" label="PDF de la factura" current={inv.file_id ? inv : null} removable required
          hint="Si la factura también se hace en el programa de contabilidad, su PDF. Si no, sirve el de «Ver la factura»." />
        <div><button class="btn btn-primary btn-sm" type="submit" name="intent" value="upload_file" data-busy="Subiendo…">Subir PDF</button></div>
      </form>
    </details>
  )}

  {editable && (
    <form method="post" class="form-section mt">
      <div class="sec-head">
        <h2><Icon name="pencil" /> {admin ? 'Revisar y emitir' : 'Editar la factura pedida'}</h2>
        {admin && next && <span class="pill pill-gold" title="Se asigna al emitirla">Nº {next.number}</span>}
        {admin && <p>Al emitirla recibe el número siguiente ({next?.number}) y la fecha. Luego se envía al cliente (envío simulado).</p>}
      </div>
      <InvoiceForm v={v} errors={errors} companies={companies} poRows={fin.summary.poRows} admin={admin} rates={rates} lines={lines}
        allocated={allocated} checked={checked} clients={clients} id="edit" />
      <div class="actions-inline">
        {admin && (
          <>
            <button class="btn btn-primary" type="submit" name="intent" value="emit_send" data-busy="Emitiendo…"
              data-requires="#edit-billed_tax_id, #edit-billed_address, #edit-concept, #edit-billed_email" data-requires-msg="Hace falta para emitir y enviar la factura."><Icon name="send" size={18} /> Emitir y enviar al cliente</button>
            <button class="btn btn-ghost" type="submit" name="intent" value="emit" data-busy="Emitiendo…"
              data-requires="#edit-billed_tax_id, #edit-billed_address, #edit-concept" data-requires-msg="Hace falta para emitir la factura.">Emitir sin enviar</button>
          </>
        )}
        <button class:list={['btn', admin ? 'btn-ghost' : 'btn-primary']} type="submit" name="intent" value="save" formnovalidate data-busy="Guardando…">{admin ? 'Guardar borrador' : 'Guardar'}</button>
        {canDelete && <button class="btn btn-danger btn-sm" type="submit" name="intent" value="delete" formnovalidate data-confirm="¿Borrar esta factura? No se puede deshacer." data-confirm-ok="Borrar factura"><Icon name="trash-2" size={16} /> Borrar</button>}
      </div>
    </form>
  )}
  {!editable && canDelete && (
    <form method="post" class="mt"><button class="btn btn-danger btn-sm" type="submit" name="intent" value="delete" data-confirm="¿Borrar esta factura anulada?" data-confirm-ok="Borrar factura"><Icon name="trash-2" size={16} /> Borrar</button></form>
  )}
</App>
