---
// Cobros al cliente (lado derecho del cierre): sus órdenes de compra (PO) y nuestras facturas.
// El recorrido: PO → «Guardar PO y crear la factura» → la factura (página propia, con los datos del
// cliente) → emitida con número automático → enviada al cliente (simulado) → cobrada.
// Eventos sube las PO y pide la factura; Administración la emite, la envía y registra el cobro.
import { env } from 'cloudflare:workers';
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import ExpHeader from '../../../components/ExpHeader.astro';
import PoForm from '../../../components/PoForm.astro';
import PoItem from '../../../components/PoItem.astro';
import InvoiceItem from '../../../components/InvoiceItem.astro';
import { parseId, readForm, actor, can, activityStmt, deny } from '../../../lib/app.js';
import { getExpediente, loadFinance, suggestions } from '../../../lib/data.js';
import { PoSchema, validate, formToObject } from '../../../lib/validate.js';
import { getFile, UploadError } from '../../../lib/files.js';
import { storeFile, keepUploads } from '../../../services/files.js';
import { serviceContext } from '../../../services/context.js';
import * as invoices from '../../../services/invoices.js';
import { eur } from '../../../lib/money.js';
import { today } from '../../../lib/dates.js';
import { billingStatus } from '../../../lib/finance.js';
import { amountInput } from '../../../lib/money.js';
import { isLocked, LOCKED_MSG } from '../../../lib/actions.js';

// Sólo Administración ve los cobros
const denied = deny(Astro, 'cobros');
if (denied) return denied;
const db = env.DB;
const id = parseId(Astro.params.id);
const now = today();
const [exp, fin] = id ? await Promise.all([getExpediente(db, id), loadFinance(db, id, now)]) : [];
if (!exp) return Astro.rewrite('/404');

const me = Astro.locals.user;
const admin = can(me, 'invoice.issue');
const locked = isLocked(exp);
// Las PO sólo las sube y gestiona Administración; Eventos las ve
const managePo = can(me, 'po.manage') && !locked;
let error = null;
let errors = {};
// «Subir PO por la diferencia»: la PO nueva sale con ese importe
const poAmount = Number(Astro.url.searchParams.get('importe'));
let poValues = { billed_to: exp.company, ...(Number.isInteger(poAmount) && poAmount > 0 ? { amount: amountInput(poAmount) } : {}) };
let open = Astro.url.searchParams.get('nuevo');

if (Astro.request.method === 'POST') {
  const who = actor(Astro);
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};

  if (locked) {
    error = LOCKED_MSG;
  } else if (input.intent === 'collect') {
    const r = await invoices.collect(serviceContext(Astro), input, { expedienteId: id });
    if (r.ok) return Astro.redirect(`/expedientes/${id}/cobros?ok=cobrada`, 303);
    error = r.message;
  } else if (input.intent === 'add_po' && !managePo) {
    error = 'Las PO del cliente sólo las sube Administración.';
  } else if (input.intent === 'add_po') {
    open = 'po';
    // La PO elegida en un intento anterior con error vuelve al formulario (src/services/files.js)
    const up = await keepUploads(serviceContext(Astro), form, ['file']);
    poValues = input;
    const parsed = validate(PoSchema, input);
    if (!parsed.ok) {
      error = parsed.message;
      errors = parsed.errors;
    } else {
      const d = parsed.data;
      try {
        const file = getFile(form, 'file');
        const fileId = file ? await storeFile({ db, bucket: env.DOCS, file, expedienteId: id, userId: me.id }) : null;
        const po = await db.prepare(
          'INSERT INTO purchase_orders (expediente_id, number, billed_to, amount_cents, issued_on, file_id, notes, created_by) VALUES (?, ?, ?, ?, ?, ?, ?, ?) RETURNING id',
        ).bind(id, d.number, d.billed_to, d.amount, d.issued_on, fileId, d.notes, me.id).first();
        await activityStmt(db, who, id, 'po.add', `subió la PO ${d.number} de ${d.billed_to} (${eur(d.amount)} sin IVA)`).run();
        await up.done();
        // «Guardar PO y crear la factura»: directamente a la factura, con esta PO y su importe
        if (input.then === 'invoice') return Astro.redirect(`/expedientes/${id}/facturas/nueva?po=${po.id}`, 303);
        return Astro.redirect(`/expedientes/${id}/cobros?ok=creado`, 303);
      } catch (err) {
        if (!(err instanceof UploadError)) throw err;
        error = err.message;
      }
    }
    poValues = { ...input, kept: await up.keep() };
  }
  Astro.response.status = 400;
}

const { billed: companies } = await suggestions(db);
const s = fin.summary;
const poByInvoice = new Map();
for (const a of fin.allocations) poByInvoice.set(a.invoice_id, [...(poByInvoice.get(a.invoice_id) ?? []), a.po_number]);
const coverage = s.sale.base > 0 ? Math.round(Math.min(1, s.poTotal / s.sale.base) * 100) : 0;
// Con el presupuesto VIGENTE (si sube una versión nueva, se recalcula; las PO y las facturas se mantienen)
const poEffective = s.poRows.reduce((a, po) => a + (po.closed ? Math.max(0, po.used_cents) : po.amount_cents), 0);
const billing = billingStatus({ budget_base: s.sale.base, invoiced_base: s.sales.base, po_total: poEffective }, s.poLeft);
const prevBudget = fin.budgets[1] ?? null;
const budgetChange = prevBudget ? s.sale.base - prevBudget.base_cents : 0;
---
<App title={`Cobros · ${exp.number ? `EXP ${exp.number}` : exp.name}`} section="expedientes" error={error} fieldErrors={errors}>
  <ExpHeader exp={exp} tab="cobros" fin={fin} />

  <div class="kpis">
    <div class="kpi"><span>Presupuesto</span><b class="money">{eur(s.sale.base)}</b><small class="money">{eur(s.sale.total)} con IVA</small></div>
    <div class="kpi is-gold">
      <span>PO recibidas</span><b class="money">{eur(s.poTotal)}</b>
      <small>{s.poMissing > 0 ? `Faltan ${eur(s.poMissing)}` : 'Presupuesto cubierto'}</small>
      <progress class="bar is-gold" max="100" value={coverage}></progress>
    </div>
    <div class="kpi"><span>Facturado</span><b class="money">{eur(s.invoiced.total)}</b><small>{s.sale.base > s.sales.base ? `Faltan ${eur(s.sale.base - s.sales.base)} por facturar` : s.toIssue.length ? `${s.toIssue.length} por emitir` : `${eur(s.invoiced.base)} sin IVA`}</small></div>
    <div class:list={['kpi', { 'is-ok': s.collected > 0, 'is-danger': s.overdueInvoices.length > 0 }]}>
      <span>Cobrado</span><b class="money">{eur(s.collected)}</b>
      <small>{s.toCollect ? `Pendiente ${eur(s.toCollect)}` : 'Nada pendiente'}</small>
    </div>
  </div>

  {fin.budget && !locked && (prevBudget || billing.overInvoiced > 0 || billing.poExcess > 0) && (
    <section class:list={['card budget-impact', { 'is-alert': billing.overInvoiced > 0 || billing.poExcess > 0 }]}>
      <h2><Icon name="file-spreadsheet" /> Con el presupuesto vigente (v{fin.budget.version})</h2>
      <p>
        {eur(s.sale.base)} sin IVA{prevBudget && <> · {budgetChange >= 0 ? '+' : ''}{eur(budgetChange)} respecto a la v{prevBudget.version} ({eur(prevBudget.base_cents)})</>}.
        Las PO y las facturas se mantienen; lo que falta se recalcula con este presupuesto.
      </p>
      <ul class="checks mt">
        <li><Icon name={billing.left > 0 ? 'clock' : 'circle-check'} size={18} /> {billing.left > 0 ? `Falta por facturar ${eur(billing.left)}` : 'Todo el presupuesto está facturado o pedido'} <span class="muted">(facturado o pedido {eur(s.sales.base)})</span></li>
        {billing.overInvoiced > 0 && <li class="is-bad"><Icon name="triangle-alert" size={18} /> Facturado de más: {eur(billing.overInvoiced)}. Si el cliente no paga la diferencia, haz una factura rectificativa.</li>}
        {billing.poMissing > 0 && <li><Icon name="info" size={18} /> Las PO cubren {eur(poEffective)}: faltan PO por {eur(billing.poMissing)}</li>}
        {billing.poExcess > 0 && <li class="is-bad"><Icon name="triangle-alert" size={18} /> Las PO superan el presupuesto en {eur(billing.poExcess)}: pide al cliente que la ajuste, o ciérrala por lo que no se vaya a facturar.</li>}
      </ul>
      <div class="actions-inline mt">
        {billing.left > 0 && <a class="btn btn-primary btn-sm" href={`/expedientes/${id}/facturas/nueva?resto`}><Icon name="send" size={16} /> Crear factura por lo que falta</a>}
        {billing.poMissing > 0 && managePo && <a class="btn btn-ghost btn-sm" href={`/expedientes/${id}/cobros?nuevo=po&importe=${billing.poMissing}`}><Icon name="file-text" size={16} /> Subir PO por la diferencia</a>}
      </div>
    </section>
  )}

  <div class="sec-head">
    <h2><Icon name="file-text" /> Órdenes de compra (PO)</h2>
    <p>{managePo
      ? 'Las PO que envía el cliente. Al guardarla puedes crear directamente su factura.'
      : 'Las PO que envía el cliente. Las sube y gestiona Administración: si te llega una, reenvíasela.'}</p>
  </div>
  {managePo && (
    <details class="add" open={open === 'po'}>
      <summary class="btn btn-ghost"><Icon name="plus" size={18} /> <span class="when-closed">Subir PO</span><span class="when-open">Cerrar formulario</span></summary>
      <form method="post" enctype="multipart/form-data" class="form-section">
        <PoForm v={poValues} errors={open === 'po' ? errors : {}} companies={companies} id="newpo" />
        <input type="hidden" name="intent" value="add_po" />
        <div class="actions-inline">
          <button class="btn btn-primary" type="submit" name="then" value="invoice" data-busy="Guardando…"><Icon name="send" size={18} /> Guardar PO y crear la factura</button>
          <button class="btn btn-ghost" type="submit" name="then" value="list" data-busy="Guardando…">Sólo guardar la PO</button>
        </div>
      </form>
    </details>
  )}
  {s.poRows.length ? (
    <>
      <ul class="list">{s.poRows.map((po) => <PoItem po={po} canInvoice={managePo} />)}</ul>
      <p class="list-total"><span>Total PO <b class="money">{eur(s.poTotal)}</b></span><span>Sin facturar <b class="money">{eur(s.poLeft)}</b></span>{s.poClosedLeft > 0 && <span>No se facturan (PO cerradas) <b class="money">{eur(s.poClosedLeft)}</b></span>}</p>
    </>
  ) : <p class="empty">Aún no hay PO del cliente.</p>}

  <div class="sec-head">
    <h2><Icon name="receipt" /> Facturas al cliente</h2>
    <p>{admin
      ? 'Un expediente puede tener una o varias facturas, con o sin PO. El número se asigna solo al emitirla; luego se envía al cliente (envío simulado).'
      : 'Pide aquí la factura (con las PO que cubre, si las hay). Administración la emite, la envía al cliente y te avisa en la actividad.'}</p>
  </div>
  {!locked && (
    <p><a class="btn btn-primary" href={`/expedientes/${id}/facturas/nueva`}><Icon name="send" size={18} /> {admin ? 'Nueva factura' : 'Pedir factura'}</a></p>
  )}
  {fin.invoices.length ? (
    <>
      <ul class="list">{fin.invoices.map((i) => <InvoiceItem i={i} now={now} canIssue={admin && !locked} canEdit={!locked || admin} poNumbers={(poByInvoice.get(i.id) ?? []).join(', ')} />)}</ul>
      <p class="list-total"><span>Facturado <b class="money">{eur(s.invoiced.total)}</b></span><span>Cobrado <b class="money">{eur(s.collected)}</b></span><span>Por cobrar <b class="money">{eur(s.toCollect)}</b></span></p>
    </>
  ) : <p class="empty">Aún no hay facturas al cliente.</p>}
</App>
