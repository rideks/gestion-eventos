---
// Pagos a proveedores del expediente (lado izquierdo del cierre).
// Las previsiones de la solicitud ya están aquí: al llegar la factura se le añade y se marca pagada.
// Se pueden ir añadiendo pagos en cualquier momento: uno con su factura o proforma, o varios de golpe
// (al mismo proveedor o a varios).
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import ExpHeader from '../../../components/ExpHeader.astro';
import PaymentForm from '../../../components/PaymentForm.astro';
import SupplierDocFields from '../../../components/SupplierDocFields.astro';
import PaymentItem from '../../../components/PaymentItem.astro';
import ForecastRows from '../../../components/ForecastRows.astro';
import EntityPickerKit from '../../../components/EntityPickerKit.astro';
import { parseId, readForm, can } from '../../../lib/app.js';
import { formToObject } from '../../../lib/validate.js';
import { rawVatLines } from '../../../lib/vat.js';
import { getFile } from '../../../lib/files.js';
import { eur } from '../../../lib/money.js';
import { plural } from '../../../lib/finance.js';
import { serviceContext, failure } from '../../../services/context.js';
import * as payments from '../../../services/payments.js';
import { keepUploads } from '../../../services/files.js';

const ctx = serviceContext(Astro);
const id = parseId(Astro.params.id);
const me = Astro.locals.user;
const now = ctx.now;
const self = `/expedientes/${id}/pagos`;
// ?nuevo abre el formulario; ?nuevo=varios, el de varios pagos; ?proveedor=<id> lo rellena
const params = Astro.url.searchParams;
let open = params.has('nuevo') ? (params.get('nuevo') === 'varios' ? 'varios' : 'uno') : null;
let error = null;
let errors = {};
let v = null;
let lines = [];
let many = [];

if (id && Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};
  let r;
  if (input.intent === 'pay') {
    r = await payments.markPaid(ctx, input, { expedienteId: id, receipt: getFile(form, 'receipt') });
    if (r.ok) return Astro.redirect(`${self}?ok=pagado`, 303);
  } else if (input.intent === 'add') {
    v = input;
    open = 'uno';
    lines = form ? rawVatLines(form) : [];
    // Los documentos elegidos no se pierden si falta algún dato: vuelven ya puestos (y se recuperan al reenviar)
    const up = await keepUploads(ctx, form, ['file', 'receipt']);
    r = await payments.create(ctx, id, form ?? new FormData());
    if (r.ok) await up.done();
    else v = { ...input, kept: await up.keep() };
    // El pago ya está guardado aunque su documento no se haya podido subir: se lleva a su ficha para reintentarlo
    if (r.ok && r.value.docError) return Astro.redirect(`${self}/${r.value.id}?aviso_doc=${encodeURIComponent(r.value.docError)}`, 303);
    if (r.ok) return Astro.redirect(`${self}?ok=creado`, 303);
  } else if (input.intent === 'add_many') {
    open = 'varios';
    const col = (f) => form.getAll(`fc_${f}`).map(String);
    many = col('supplier').map((supplier, i) => ({ supplier, supplier_id: col('supplier_id')[i], concept: col('concept')[i], due_date: col('due_date')[i], total: col('total')[i], rate: col('rate')[i] }))
      .filter((x) => x.supplier || x.total);
    r = await payments.createPlanned(ctx, id, form ?? new FormData());
    if (r.ok) return Astro.redirect(`${self}?ok=creado`, 303);
  } else {
    r = { ok: false, code: 'invalid', message: 'Esa acción no está permitida.', fields: {} };
  }
  const back = failure(Astro, r, self);
  if (back) return back;
  error = r.message;
  errors = r.fields ?? {};
}

const tab = id ? await payments.tab(ctx, id, { supplierId: parseId(params.get('proveedor')) }) : { ok: false, code: 'not_found' };
if (!tab.ok) return failure(Astro, tab, '/expedientes');
const { exp, fin, rates, editable, options, types, preset } = tab.value;
const locked = !editable;
v ??= { supplier: preset?.name, supplier_id: preset?.id };
const s = fin.summary;
const pending = fin.payments.filter((p) => p.status !== 'pagado');
const paid = fin.payments.filter((p) => p.status === 'pagado');
// Con qué proveedores se trabaja en este expediente (cada uno, una vez)
const suppliersHere = [...new Map(fin.payments.filter((p) => p.supplier_id).map((p) => [p.supplier_id, { id: p.supplier_id, name: p.supplier }])).values()]
  .sort((a, b) => a.name.localeCompare(b.name, 'es'));
---
<App title={`Pagos · ${exp.number ? `EXP ${exp.number}` : exp.name}`} section="expedientes" error={error} fieldErrors={errors}>
  <ExpHeader exp={exp} tab="pagos" fin={fin} />

  <div class="kpis">
    <div class="kpi"><span>Coste sin IVA</span><b class="money">{eur(s.cost.base)}</b><small class="money">{eur(s.cost.total)} con IVA</small></div>
    <div class="kpi is-ok"><span>Pagado</span><b class="money">{eur(s.paid)}</b><small>{plural(paid.length, 'pago', 'pagos')}</small></div>
    <div class:list={['kpi', { 'is-danger': s.overdue.length > 0 }]}><span>Por pagar</span><b class="money">{eur(s.toPay)}</b><small>{s.overdue.length ? plural(s.overdue.length, 'vencido', 'vencidos') : plural(pending.length, 'pendiente', 'pendientes')}</small></div>
    <div class="kpi"><span>Sin factura</span><b>{s.withoutInvoice.length}</b><small>{s.paidWithoutInvoice.length ? plural(s.paidWithoutInvoice.length, 'ya pagado', 'ya pagados') : 'líneas previstas'}</small></div>
  </div>

  {suppliersHere.length > 0 && (
    <p class="supplier-chips">
      <span class="muted small">Proveedores:</span>
      {suppliersHere.map((x) => (can(me, 'proveedores') ? <a class="pill pill-muted" href={`/proveedores/${x.id}`}>{x.name}</a> : <span class="pill pill-muted">{x.name}</span>))}
    </p>
  )}

  {!locked && (
    <div class="add-group">
      <details class="add" open={open === 'uno'} name="nuevo-pago">
        <summary class="btn btn-primary"><Icon name="plus" size={18} /> <span class="when-closed">Añadir factura o pago</span><span class="when-open">Cerrar formulario</span></summary>
        <form method="post" enctype="multipart/form-data" class="form-section">
          <h2><Icon name="receipt" /> Pago a proveedor</h2>
          <p class="muted">Un pago nuevo (aunque no estuviera previsto), un pago con tarjeta o un abono/comisión (en negativo).
            Si es la factura de un pago que ya está en la lista, ábrelo y añádesela allí.</p>
          <PaymentForm v={v} errors={errors} rates={rates} lines={lines} receipt id="new" />
          <h3 class="form-sub"><Icon name="paperclip" size={18} /> Factura o proforma del proveedor <span class="opt muted">(si ya la tienes)</span></h3>
          <SupplierDocFields v={v} errors={errors} id="newinv" comment="none" />
          <div class="actions-inline">
            <button class="btn btn-primary" type="submit" name="intent" value="add" data-busy="Guardando…" data-receipt-check="status">Guardar</button>
          </div>
        </form>
      </details>
      <details class="add" open={open === 'varios'} name="nuevo-pago">
        <summary class="btn btn-ghost"><Icon name="wallet" size={18} /> <span class="when-closed">Añadir varios pagos previstos</span><span class="when-open">Cerrar formulario</span></summary>
        <form method="post" class="form-section">
          <h2><Icon name="wallet" /> Varios pagos previstos</h2>
          <p class="muted">Pagos que habrá que hacer, al mismo proveedor o a varios (p. ej. un 2º pago al hotel y el autocar).
            Las facturas se les añaden cuando lleguen.</p>
          <ForecastRows rows={many} rates={rates} supplier={preset} addLabel="Añadir otra fila" />
          <div class="actions-inline">
            <button class="btn btn-primary" type="submit" name="intent" value="add_many" data-busy="Guardando…">Guardar pagos</button>
          </div>
        </form>
      </details>
    </div>
  )}
  {!locked && <EntityPickerKit kind="supplier" options={options} types={types} />}

  <div class:list={['group-title', { 'is-danger': s.overdue.length > 0 }]}>
    <h3>Por pagar ({pending.length})</h3>
    <span class="money">{eur(s.toPay)}</span>
  </div>
  {pending.length ? (
    <ul class="list">{pending.map((p) => <PaymentItem p={p} now={now} canEdit={!locked} />)}</ul>
  ) : <p class="empty">No hay nada pendiente de pagar.</p>}

  <div class="group-title">
    <h3>Pagados ({paid.length})</h3>
    <span class="money">{eur(s.paid)}</span>
  </div>
  {paid.length ? (
    <ul class="list">{paid.map((p) => <PaymentItem p={p} now={now} canEdit={!locked} />)}</ul>
  ) : <p class="empty">Aún no se ha pagado nada.</p>}
</App>
