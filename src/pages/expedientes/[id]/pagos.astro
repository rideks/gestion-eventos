---
// Pagos a proveedores del expediente (lado izquierdo del cierre).
// Las previsiones de la solicitud ya están aquí: al llegar la factura se le añade y se marca pagada.
// Se pueden ir añadiendo pagos en cualquier momento: uno con su factura o proforma, o varios de golpe
// (al mismo proveedor o a varios).
import { env } from 'cloudflare:workers';
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import ExpHeader from '../../../components/ExpHeader.astro';
import PaymentForm from '../../../components/PaymentForm.astro';
import SupplierDocFields from '../../../components/SupplierDocFields.astro';
import PaymentItem from '../../../components/PaymentItem.astro';
import ForecastRows from '../../../components/ForecastRows.astro';
import { parseId, readForm, actor, activityStmt } from '../../../lib/app.js';
import { getExpediente, loadFinance, suggestions } from '../../../lib/data.js';
import { PaymentSchema, SupplierDocSchema, forecastRowSchema, parseRows, validate, formToObject } from '../../../lib/validate.js';
import { attachDocument } from '../../../lib/supplier.js';
import { loadRates, parseVatLines, rawVatLines } from '../../../lib/vat.js';
import { getFile, storeFile, UploadError } from '../../../lib/files.js';
import { eur } from '../../../lib/money.js';
import { plural } from '../../../lib/finance.js';
import { today } from '../../../lib/dates.js';
import { isLocked, LOCKED_MSG, markPaid, paidProblem } from '../../../lib/actions.js';

const db = env.DB;
const id = parseId(Astro.params.id);
const [exp, rates] = id ? await Promise.all([getExpediente(db, id), loadRates(db)]) : [];
if (!exp) return Astro.rewrite('/404');

const me = Astro.locals.user;
const now = today();
const locked = isLocked(exp);
// ?nuevo abre el formulario; ?nuevo=varios, el de varios pagos; ?proveedor=… lo rellena
const params = Astro.url.searchParams;
let open = params.has('nuevo') ? (params.get('nuevo') === 'varios' ? 'varios' : 'uno') : null;
const presetSupplier = (params.get('proveedor') ?? '').slice(0, 120);
let error = null;
let errors = {};
let v = { supplier: presetSupplier };
let lines = [];
let many = [];

if (Astro.request.method === 'POST') {
  const who = actor(Astro);
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};

  if (locked) {
    error = LOCKED_MSG;
  } else if (input.intent === 'pay') {
    const r = await markPaid(db, who, input, id, { bucket: env.DOCS, file: getFile(form, 'receipt') });
    if (r.ok) return Astro.redirect(`/expedientes/${id}/pagos?ok=pagado`, 303);
    error = r.message;
  } else if (input.intent === 'add') {
    v = input;
    open = 'uno';
    lines = rawVatLines(form);
    const parsed = validate(PaymentSchema, input);
    const doc = validate(SupplierDocSchema, input);
    const amounts = parseVatLines(form, rates);
    const file = form ? getFile(form, 'file') : null;
    const receipt = form ? getFile(form, 'receipt') : null;
    const paidIssue = parsed.ok && parsed.data.status === 'pagado' ? paidProblem({ method: parsed.data.method, hasReceipt: !!receipt }) : null;
    if (!parsed.ok) {
      error = parsed.message;
      errors = parsed.errors;
    } else if (!amounts.ok) {
      error = amounts.message;
      errors = { amount: amounts.message };
    } else if (paidIssue) {
      error = paidIssue;
      errors = parsed.data.method ? { receipt: paidIssue } : { method: paidIssue };
    } else if (!doc.ok) {
      error = doc.message;
      errors = doc.errors;
    } else if ((file || doc.data.number) && !doc.data.kind) {
      error = 'Indica si el documento es una factura o una proforma.';
      errors = { doc_kind: error };
    } else {
      const d = parsed.data;
      const paid = d.status === 'pagado';
      try {
        // El justificante se guarda antes: si no se puede subir, no se crea nada
        const receiptId = paid && receipt ? await storeFile({ db, bucket: env.DOCS, file: receipt, expedienteId: id, userId: me.id }) : null;
        const payment = await db.prepare(
          `INSERT INTO payments (expediente_id, supplier, concept, base_cents, total_cents, vat, vat_lines,
                                 due_date, status, paid_on, method, receipt_file_id, planned, notes, created_by)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?) RETURNING id, expediente_id, supplier, total_cents, status`,
        ).bind(id, d.supplier, d.concept, amounts.base, amounts.total, amounts.vat, JSON.stringify(amounts.lines),
          d.due_date, d.status, paid ? d.paid_on : null, paid ? d.method : null, receiptId, d.notes, me.id).first();
        await activityStmt(db, who, id, 'payment.add', `añadió un pago a ${d.supplier} (${eur(amounts.total)})${paid ? ' ya pagado' : ''}`).run();
        // El documento (si se ha adjuntado o se sabe su número): la factura queda pendiente de revisar
        try {
          if (file || doc.data.number) await attachDocument({ db, bucket: env.DOCS, who, payment, file, data: doc.data });
          return Astro.redirect(`/expedientes/${id}/pagos?ok=creado`, 303);
        } catch (err) {
          if (!(err instanceof UploadError)) throw err;
          // El pago ya está guardado: se lleva a su ficha para volver a intentar subir el documento
          return Astro.redirect(`/expedientes/${id}/pagos/${payment.id}?aviso_doc=${encodeURIComponent(err.message)}`, 303);
        }
      } catch (err) {
        if (!(err instanceof UploadError)) throw err;
        error = `Justificante · ${err.message}`;
        errors = { receipt: error };
      }
    }
  } else if (input.intent === 'add_many') {
    open = 'varios';
    const col = (f) => form.getAll(`fc_${f}`).map(String);
    many = col('supplier').map((supplier, i) => ({ supplier, concept: col('concept')[i], due_date: col('due_date')[i], total: col('total')[i], rate: col('rate')[i] }))
      .filter((r) => r.supplier || r.total);
    const rows = parseRows(form, 'fc', ['supplier', 'concept', 'due_date', 'total', 'rate'], forecastRowSchema(rates), { ignore: ['rate'] });
    if (!rows.ok) {
      error = rows.message;
    } else if (!rows.rows.length) {
      error = 'Escribe al menos un pago (proveedor e importe).';
    } else {
      const sum = rows.rows.reduce((a, r) => a + r.total, 0);
      await db.batch([
        ...rows.rows.map((r) => db.prepare(
          `INSERT INTO payments (expediente_id, supplier, concept, base_cents, total_cents, vat, vat_lines, due_date, planned, created_by)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0, ?)`,
        ).bind(id, r.supplier, r.concept, r.base, r.total, r.vat, JSON.stringify(r.lines), r.due_date, me.id)),
        activityStmt(db, who, id, 'payment.add',
          `añadió ${plural(rows.rows.length, 'pago previsto', 'pagos previstos')} (${eur(sum)}): ${[...new Set(rows.rows.map((r) => r.supplier))].join(', ')}`),
      ]);
      return Astro.redirect(`/expedientes/${id}/pagos?ok=creado`, 303);
    }
  }
  Astro.response.status = 400;
}

const [fin, { suppliers }] = await Promise.all([loadFinance(db, id, now), suggestions(db)]);
const s = fin.summary;
const pending = fin.payments.filter((p) => p.status !== 'pagado');
const paid = fin.payments.filter((p) => p.status === 'pagado');
---
<App title={`Pagos · ${exp.number ? `EXP ${exp.number}` : exp.name}`} section="expedientes" error={error} fieldErrors={errors}>
  <ExpHeader exp={exp} tab="pagos" fin={fin} />

  <div class="kpis">
    <div class="kpi"><span>Coste sin IVA</span><b class="money">{eur(s.cost.base)}</b><small class="money">{eur(s.cost.total)} con IVA</small></div>
    <div class="kpi is-ok"><span>Pagado</span><b class="money">{eur(s.paid)}</b><small>{plural(paid.length, 'pago', 'pagos')}</small></div>
    <div class:list={['kpi', { 'is-danger': s.overdue.length > 0 }]}><span>Por pagar</span><b class="money">{eur(s.toPay)}</b><small>{s.overdue.length ? plural(s.overdue.length, 'vencido', 'vencidos') : plural(pending.length, 'pendiente', 'pendientes')}</small></div>
    <div class="kpi"><span>Sin factura</span><b>{s.withoutInvoice.length}</b><small>{s.paidWithoutInvoice.length ? plural(s.paidWithoutInvoice.length, 'ya pagado', 'ya pagados') : 'líneas previstas'}</small></div>
  </div>

  {!locked && (
    <div class="add-group">
      <details class="add" open={open === 'uno'} name="nuevo-pago">
        <summary class="btn btn-primary"><Icon name="plus" size={18} /> <span class="when-closed">Añadir factura o pago</span><span class="when-open">Cerrar formulario</span></summary>
        <form method="post" enctype="multipart/form-data" class="form-section">
          <h2><Icon name="receipt" /> Pago a proveedor</h2>
          <p class="muted">Un pago nuevo (aunque no estuviera previsto), un pago con tarjeta o un abono/comisión (en negativo).
            Si es la factura de un pago que ya está en la lista, ábrelo y añádesela allí.</p>
          <PaymentForm v={v} errors={errors} suppliers={suppliers} rates={rates} lines={lines} receipt id="new" />
          <h3 class="form-sub"><Icon name="paperclip" size={18} /> Factura o proforma del proveedor <span class="opt muted">(si ya la tienes)</span></h3>
          <SupplierDocFields v={v} errors={errors} id="newinv" comment="none" />
          <div class="actions-inline">
            <button class="btn btn-primary" type="submit" name="intent" value="add" data-busy="Guardando…">Guardar</button>
          </div>
        </form>
      </details>
      <details class="add" open={open === 'varios'} name="nuevo-pago">
        <summary class="btn btn-ghost"><Icon name="wallet" size={18} /> <span class="when-closed">Añadir varios pagos previstos</span><span class="when-open">Cerrar formulario</span></summary>
        <form method="post" class="form-section">
          <h2><Icon name="wallet" /> Varios pagos previstos</h2>
          <p class="muted">Pagos que habrá que hacer, al mismo proveedor o a varios (p. ej. un 2º pago al hotel y el autocar).
            Las facturas se les añaden cuando lleguen.</p>
          <ForecastRows rows={many} suppliers={suppliers} rates={rates} supplier={presetSupplier} addLabel="Añadir otra fila" />
          <div class="actions-inline">
            <button class="btn btn-primary" type="submit" name="intent" value="add_many" data-busy="Guardando…">Guardar pagos</button>
          </div>
        </form>
      </details>
    </div>
  )}

  <div class:list={['group-title', { 'is-danger': s.overdue.length > 0 }]}>
    <h3>Por pagar ({pending.length})</h3>
    <span class="money">{eur(s.toPay)}</span>
  </div>
  {pending.length ? (
    <ul class="list">{pending.map((p) => <PaymentItem p={p} now={now} canEdit={!locked} />)}</ul>
  ) : <p class="empty">No hay nada pendiente de pagar.</p>}

  <div class="group-title">
    <h3>Pagados ({paid.length})</h3>
    <span class="money">{eur(s.paid)}</span>
  </div>
  {paid.length ? (
    <ul class="list">{paid.map((p) => <PaymentItem p={p} now={now} canEdit={!locked} />)}</ul>
  ) : <p class="empty">Aún no se ha pagado nada.</p>}
</App>
