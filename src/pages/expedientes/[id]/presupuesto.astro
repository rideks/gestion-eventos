---
// Presupuesto aprobado y sus versiones: "puede cambiar hasta el último momento".
// Cada cambio se sube como versión nueva (archivo + total) y se ve qué ha cambiado.
// Si a una versión le falta su documento, se le puede subir después desde su fila del historial.
// Al guardar una versión nueva se ve cómo quedan los cobros: las PO y las facturas se mantienen y lo que
// falta por facturar se recalcula con el presupuesto nuevo.
import { env } from 'cloudflare:workers';
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import ExpHeader from '../../../components/ExpHeader.astro';
import VatLines from '../../../components/VatLines.astro';
import FileField from '../../../components/FileField.astro';
import { parseId, readForm, actor, can, activityStmt } from '../../../lib/app.js';
import { getExpediente, loadFinance } from '../../../lib/data.js';
import { BudgetSchema, validate, formToObject } from '../../../lib/validate.js';
import { loadRates, parseVatLines, rawVatLines, linesOf } from '../../../lib/vat.js';
import { billingStatus } from '../../../lib/finance.js';
import { storeFile, getFile, fileUrl, ACCEPT, UploadError } from '../../../lib/files.js';
import { eur } from '../../../lib/money.js';
import { today, formatStamp } from '../../../lib/dates.js';
import { isLocked, LOCKED_MSG } from '../../../lib/actions.js';

const db = env.DB;
const id = parseId(Astro.params.id);
const [exp, rates] = id ? await Promise.all([getExpediente(db, id), loadRates(db)]) : [];
if (!exp) return Astro.rewrite('/404');

const me = Astro.locals.user;
const locked = isLocked(exp);
const now = today();
let error = null;
let errors = {};
let v = {};
let lines = [];
let attachFor = null; // versión a la que se intentaba subir el documento (para enseñar ahí el error)

if (Astro.request.method === 'POST') {
  const who = actor(Astro);
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};

  if (input.intent === 'attach') {
    // El documento que faltaba en una versión ya guardada
    attachFor = Number(input.budget_id);
    const b = await db.prepare('SELECT id, version, file_id FROM budgets WHERE id = ? AND expediente_id = ?').bind(Number(input.budget_id), id).first();
    const file = form ? getFile(form, 'file') : null;
    if (locked) {
      error = LOCKED_MSG;
    } else if (!b) {
      error = 'Esa versión del presupuesto ya no existe.';
    } else if (b.file_id) {
      error = `La versión ${b.version} ya tiene su documento.`;
    } else if (!file) {
      error = `Elige el documento de la versión ${b.version}.`;
    } else {
      try {
        const fileId = await storeFile({ db, bucket: env.DOCS, file, expedienteId: id, userId: me.id });
        await db.batch([
          db.prepare('UPDATE budgets SET file_id = ? WHERE id = ?').bind(fileId, b.id),
          activityStmt(db, who, id, 'budget.file', `subió el documento de la versión ${b.version} del presupuesto`),
        ]);
        return Astro.redirect(`/expedientes/${id}/presupuesto?ok=guardado#v${b.version}`, 303);
      } catch (err) {
        if (!(err instanceof UploadError)) throw err;
        error = err.message;
      }
    }
  } else {
    // Versión nueva del presupuesto
    v = input;
    lines = rawVatLines(form);
    const parsed = validate(BudgetSchema, input);
    const amounts = parseVatLines(form, rates);
    if (locked) {
      error = LOCKED_MSG;
    } else if (!amounts.ok) {
      error = amounts.message;
      errors = { amount: amounts.message };
    } else if (!parsed.ok) {
      error = parsed.message;
      errors = parsed.errors;
    } else {
      const d = { ...parsed.data, base: amounts.base, total: amounts.total };
      try {
        const file = getFile(form, 'file');
        const fileId = file ? await storeFile({ db, bucket: env.DOCS, file, expedienteId: id, userId: me.id }) : null;
        const last = await db.prepare('SELECT version, base_cents FROM budgets WHERE expediente_id = ? ORDER BY version DESC LIMIT 1').bind(id).first();
        const version = (last?.version ?? 0) + 1;
        const diff = last ? d.base - last.base_cents : 0;
        await db.batch([
          db.prepare('INSERT INTO budgets (expediente_id, version, base_cents, total_cents, vat_lines, note, file_id, created_by) VALUES (?, ?, ?, ?, ?, ?, ?, ?)')
            .bind(id, version, d.base, d.total, JSON.stringify(amounts.lines), d.note, fileId, me.id),
          activityStmt(db, who, id, 'budget.add', `subió la versión ${version} del presupuesto: ${eur(d.base)} sin IVA`
            + (last ? ` (${diff >= 0 ? '+' : ''}${eur(diff)})` : '') + (d.note ? `. ${d.note}` : '')),
        ]);
        return Astro.redirect(`/expedientes/${id}/presupuesto?ok=creado&nueva=${version}`, 303);
      } catch (err) {
        if (!(err instanceof UploadError)) throw err;
        error = err.message;
      }
    }
  }
  Astro.response.status = 400;
}

const fin = await loadFinance(db, id, now);
const versions = fin.budgets;
const s = fin.summary;
// Recién guardada una versión: cómo quedan los cobros (las PO y las facturas se mantienen)
const justSaved = versions.length && Number(Astro.url.searchParams.get('nueva')) === fin.budget.version ? fin.budget : null;
const savedPrev = justSaved ? versions[1] ?? null : null;
const billing = billingStatus({ budget_base: s.sale.base, invoiced_base: s.sales.base }, s.poLeft);
const cobros = can(me, 'cobros');
---
<App title={`Presupuesto · ${exp.number ? `EXP ${exp.number}` : exp.name}`} section="expedientes" error={attachFor ? null : error} fieldErrors={errors}>
  <ExpHeader exp={exp} tab="presupuesto" fin={fin} />

  {fin.budget ? (
    <div class="kpis is-3">
      <div class="kpi is-gold"><span>Presupuesto</span><b class="money">{eur(fin.budget.base_cents)}</b>
        <small class="money">{eur(fin.budget.total_cents)} con IVA · v{fin.budget.version}</small></div>
      <div class="kpi"><span>Coste</span><b class="money">{eur(s.cost.base)}</b><small>sin IVA · el beneficio se calcula al cerrar</small></div>
      <div class="kpi"><span>Versiones</span><b>{versions.length}</b><small>{versions.length > 1 ? `la 1ª era de ${eur(versions[versions.length - 1].base_cents)}` : 'sin cambios'}</small></div>
    </div>
  ) : <p class="flash flash-warn"><Icon name="info" /> Este expediente aún no tiene presupuesto.</p>}

  {justSaved && (
    <section class="card budget-impact">
      <h2><Icon name="circle-check" /> Versión {justSaved.version} guardada{savedPrev && <>: {justSaved.base_cents - savedPrev.base_cents >= 0 ? '+' : ''}{eur(justSaved.base_cents - savedPrev.base_cents)} respecto a la v{savedPrev.version}</>}</h2>
      {cobros ? (
        <>
          <p>Los cobros se recalculan con este presupuesto; las PO y las facturas que ya había se mantienen.</p>
          <ul class="checks mt">
            <li><Icon name={billing.left > 0 ? 'clock' : 'circle-check'} size={18} /> {billing.left > 0 ? `Falta por facturar ${eur(billing.left)}` : 'Todo está facturado o pedido'} <span class="muted">(facturado o pedido {eur(s.sales.base)})</span></li>
            {billing.overInvoiced > 0 && <li class="is-bad"><Icon name="triangle-alert" size={18} /> Facturado de más: {eur(billing.overInvoiced)}</li>}
          </ul>
          <div class="actions-inline mt"><a class="btn btn-ghost btn-sm" href={`/expedientes/${id}/cobros`}><Icon name="arrow-down-left" size={16} /> Ver los cobros del expediente</a></div>
        </>
      ) : <p>Administración lo verá en Cobros: lo que falta por facturar se recalcula solo con este presupuesto.</p>}
    </section>
  )}

  {!locked && (
    <details class="add" open={(!!error && !attachFor) || Astro.url.searchParams.has('nuevo')}>
      <summary class="btn btn-primary"><Icon name="upload" size={18} /> <span class="when-closed">Subir nueva versión</span><span class="when-open">Cerrar formulario</span></summary>
      <form method="post" enctype="multipart/form-data" class="form-section">
        <h2><Icon name="file-spreadsheet" /> Nueva versión del presupuesto</h2>
        <p class="muted">Cuando el cliente cambia algo (más habitaciones, otro menú…), sube el presupuesto actualizado: pasa a ser el vigente y se guarda el historial.</p>
        <FileField label="Presupuesto actualizado" />
        <VatLines id="budget" lines={lines} rates={rates} error={errors.amount} labelBase="Total sin IVA" labelTotal="Total con IVA" />
        <div class="field">
          <label for="note">¿Qué ha cambiado? <span class="opt">(opcional)</span></label>
          <input id="note" name="note" type="text" maxlength="300" value={v.note ?? ''} placeholder="+10 habitaciones el 05/05 y cena de gala" />
        </div>
        <div class="actions-inline"><button class="btn btn-primary" type="submit" data-busy="Subiendo…">Guardar versión</button></div>
      </form>
    </details>
  )}

  <h2 class="section-title">Historial</h2>
  {versions.length ? (
    <ul class="list">
      {versions.map((b, i) => {
        const prev = versions[i + 1];
        const diff = prev ? b.base_cents - prev.base_cents : null;
        return (
          <li class="item is-row" id={`v${b.version}`}>
            <div class="item-body">
              <span class="item-title">Versión {b.version}{i === 0 && <span class="pill pill-gold">Vigente</span>}</span>
              <span class="item-meta"><span>{b.created_by_name ?? '—'} · {formatStamp(b.created_at)}</span>{b.note && <span>{b.note}</span>}</span>
              {linesOf(b).length > 1 && (
                <span class="item-meta">{linesOf(b).map((l) => <span>{l.label}: {eur(l.base)} → {eur(l.total)}</span>)}</span>
              )}
              <span class="item-flags">
                {diff !== null && diff !== 0 && <span class:list={['pill', diff > 0 ? 'pill-ok' : 'pill-danger']}>{diff > 0 ? '+' : ''}{eur(diff)}</span>}
                {b.file_id
                  ? <a class="doc-link" href={fileUrl(b)} target="_blank" rel="noopener"><Icon name="paperclip" size={15} />{b.file_name}</a>
                  : <span class="pill pill-warn">Sin documento</span>}
              </span>
            </div>
            <div class="item-amount">
              <span class="big-money money">{eur(b.base_cents)}</span>
              <small class="money">{eur(b.total_cents)} con IVA</small>
            </div>
            {!b.file_id && !locked && (
              <div class="item-foot">
                <form method="post" enctype="multipart/form-data" class="quick-form">
                  <input type="hidden" name="intent" value="attach" />
                  <input type="hidden" name="budget_id" value={b.id} />
                  <label class="btn btn-ghost btn-sm file-btn" title="El documento del presupuesto de esta versión (PDF, Excel…)">
                    <Icon name="paperclip" size={16} /><span data-file-button>Elegir el documento</span>
                    <input type="file" name="file" accept={ACCEPT} class="visually-hidden" title="" />
                  </label>
                  <button class="btn btn-primary btn-sm" type="submit" data-busy="Subiendo…"><Icon name="upload" size={16} /> Subir documento</button>
                </form>
                {attachFor === b.id && error && <p class="field-error small">{error}</p>}
              </div>
            )}
          </li>
        );
      })}
    </ul>
  ) : <p class="empty">Sin versiones todavía.</p>}
</App>
