---
// Inicio: lo que hay que hacer hoy. Cada persona ve primero lo suyo
// (Administración y quien lleva los cobros: todo lo abierto; Eventos: sus expedientes). Administración ve además
// los expedientes nuevos de la semana (ya nacen en curso: nadie tiene que abrirlos).
// Quien no trabaja con expedientes (p. ej. Técnico) va directamente a su sección.
import { env } from 'cloudflare:workers';
import App from '../layouts/App.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PaymentItem from '../components/PaymentItem.astro';
import InvoiceItem from '../components/InvoiceItem.astro';
import ReviewItem from '../components/ReviewItem.astro';
import { actor, readForm, can } from '../lib/app.js';
import { pendingPayments, paidWithoutInvoice, openInvoices, posWithBalance, invoicesToReview, toInvoiceByExpediente, LIST_COLUMNS } from '../lib/data.js';
import { serviceContext, failure } from '../services/context.js';
import * as contracts from '../services/contracts.js';
import * as payments from '../services/payments.js';
import { markCollected } from '../lib/actions.js';
import { getFile } from '../lib/files.js';
import { formToObject } from '../lib/validate.js';
import { expedienteState, expLabel, plural, leftToInvoice, SOON_DAYS } from '../lib/finance.js';
import { eur } from '../lib/money.js';
import { today, addDays, formatDate, formatRange, formatStamp, formatDateLong } from '../lib/dates.js';

const db = env.DB;
const me = Astro.locals.user;
if (!can(me, 'expedientes')) {
  const home = can(me, 'viajes') ? '/viajes' : can(me, 'users') ? '/usuarios' : can(me, 'settings') ? '/ajustes' : '/cuenta';
  return Astro.redirect(`${home}${Astro.url.search}`, 303);
}
const admin = can(me, 'expediente.open');
const now = today();
let error = null;

if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const input = form ? formToObject(form) : {};
  const ctx = serviceContext(Astro);
  const r = input.intent === 'pay' ? await payments.markPaid(ctx, input, { receipt: getFile(form, 'receipt') })
    : input.intent === 'collect' ? await markCollected(db, actor(Astro), input)
      : input.intent === 'conform' ? await payments.conform(ctx, Number(input.supplier_invoice_id), input)
        : { ok: false, message: 'Acción no válida.' };
  const OK = { pay: 'pagado', collect: 'cobrada', conform: 'revisada' };
  if (r.ok) return Astro.redirect(`/?ok=${OK[input.intent]}`, 303);
  const back = r.code ? failure(Astro, r, '/') : null;
  if (back) return back;
  error = r.message;
  Astro.response.status = 400;
}

const soon = addDays(now, SOON_DAYS);
const reviewer = can(me, 'supplier.review');
// Los cobros (facturas al cliente, PO, por facturar) sólo los ve quien tiene ese permiso
const cobros = can(me, 'cobros');
// Oficina (abre expedientes o lleva los cobros): ve todo lo abierto. Eventos: lo suyo y «Te toca».
const office = admin || cobros;
const seesContracts = can(me, 'contratos');
const [review, urgent, invoices, pos, open, fresh, toClose, { n: openCount }, noInvoice, billing, dueContracts] = await Promise.all([
  reviewer ? invoicesToReview(db) : [],
  pendingPayments(db, '', { until: soon }),
  cobros ? openInvoices(db) : [],
  cobros ? posWithBalance(db) : [],
  db.prepare(`SELECT ${LIST_COLUMNS} FROM expedientes e LEFT JOIN users m ON m.id = e.manager_id
               WHERE e.status = 'abierto' ${office ? '' : 'AND e.manager_id = ?'}
               ORDER BY e.start_date LIMIT 8`).bind(...(office ? [] : [me.id])).all().then((r) => r.results),
  // Los creados en los últimos 7 días (no cancelados), los más recientes primero
  db.prepare(`SELECT e.id, e.number, e.name, e.company, e.start_date, e.end_date, e.requested_at, u.name AS requested_by_name,
                     (SELECT b.base_cents FROM budgets b WHERE b.expediente_id = e.id ORDER BY b.version DESC LIMIT 1) AS budget_base
                FROM expedientes e LEFT JOIN users u ON u.id = e.requested_by
               WHERE e.requested_at >= ? AND e.status <> 'cancelado' ORDER BY e.requested_at DESC, e.id DESC LIMIT 10`)
    .bind(addDays(now, -7)).all().then((r) => r.results),
  db.prepare(`SELECT id, number, name, company, start_date, end_date FROM expedientes
               WHERE status = 'abierto' AND COALESCE(end_date, start_date) < ? ORDER BY end_date LIMIT 8`).bind(now).all().then((r) => r.results),
  db.prepare("SELECT COUNT(*) AS n FROM expedientes WHERE status = 'abierto'").first(),
  office ? [] : paidWithoutInvoice(db),
  cobros ? toInvoiceByExpediente(db) : [],
  seesContracts ? contracts.due(serviceContext(Astro)).then((r) => (r.ok ? r.value : [])) : [],
]);
// «Te toca» (Eventos): lo que depende de quien lleva el expediente
const mine = (rows) => rows.filter((r) => r.exp_manager_id === me.id);
const chase = mine(noInvoice);
const overdueCount = urgent.filter((p) => p.due_date < now).length;
// Facturas que ya se pueden conformar (su pago está hecho)
const ready = review.filter((si) => !si.unpaid_count);
const toIssue = invoices.filter((i) => i.status === 'por_emitir');
const toCollect = invoices.filter((i) => i.status === 'emitida');
const overdueInvoices = toCollect.filter((i) => i.due_date && i.due_date < now);
const sum = (rows, f = 'total_cents') => rows.reduce((a, r) => a + r[f], 0);
// Por facturar (lo mismo que «1. Por facturar» en Cobros): presupuesto de cada expediente menos lo facturado o pedido
const poLeftOf = new Map();
for (const po of pos) poLeftOf.set(po.expediente_id, (poLeftOf.get(po.expediente_id) ?? 0) + po.left_cents);
const toBill = billing.map((e) => leftToInvoice(e, poLeftOf.get(e.id) ?? 0)).filter((n) => n > 0);
const firstName = me.name.split(' ')[0];
---
<App title="Inicio" section="inicio" error={error} origin="Inicio">
  <div class="page-top">
    <div>
      <h1>Hola, {firstName}</h1>
      <p>{formatDateLong(now)} · esto es lo que hay que mover hoy</p>
    </div>
  </div>

  <div class:list={['kpis', { 'is-3': !cobros }]}>
    <a class="kpi" href="/expedientes"><span>Expedientes en curso</span><b>{openCount}</b><small>{fresh.length ? `${plural(fresh.length, 'nuevo', 'nuevos')} esta semana` : 'ninguno nuevo esta semana'}</small></a>
    <a class:list={['kpi', { 'is-danger': overdueCount > 0 }]} href="/pagos"><span>Pagos en {SOON_DAYS} días</span><b class="money">{eur(sum(urgent))}</b><small>{overdueCount ? plural(overdueCount, 'vencido', 'vencidos') : plural(urgent.length, 'pago', 'pagos')}</small></a>
    {cobros && <a class:list={['kpi', { 'is-danger': overdueInvoices.length > 0 }]} href="/cobros#cobrar"><span>Pendiente de cobro</span><b class="money">{eur(sum(toCollect))}</b><small>{overdueInvoices.length ? plural(overdueInvoices.length, 'vencida', 'vencidas') : plural(toCollect.length, 'factura', 'facturas')}</small></a>}
    {cobros && <a class="kpi is-gold" href="/cobros#facturar"><span>Por facturar</span><b class="money">{eur(toBill.reduce((a, n) => a + n, 0))}</b><small>{plural(toBill.length, 'expediente', 'expedientes')} · sin IVA</small></a>}
    {!cobros && (
      <a class:list={['kpi', { 'is-danger': chase.length > 0 }]} href="/pagos#sin-factura">
        <span>Facturas que reclamar</span><b>{chase.length}</b><small>pagos hechos sin la factura del proveedor</small>
      </a>
    )}
  </div>

  <div class="two-col">
    <div class="stack">
      {chase.length > 0 && (
        <section class="card card-alert">
          <div class="sec-head">
            <h2><Icon name="list-checks" /> Te toca</h2>
            <p>Lo que depende de ti en tus expedientes.</p>
          </div>
          <h3 class="form-sub"><Icon name="paperclip" size={18} /> Reclamar la factura al proveedor ({chase.length})</h3>
          <p class="muted small">Pagos ya hechos de los que falta la factura: pídela y súbela en el pago.</p>
          <ul class="list">{chase.slice(0, 5).map((p) => <PaymentItem p={p} now={now} showExp />)}</ul>
          {chase.length > 5 && <p class="muted small mt"><a href="/pagos#sin-factura">Ver los {chase.length}</a></p>}
        </section>
      )}
      {dueContracts.length > 0 && (
        <section class="card card-alert">
          <div class="sec-head">
            <h2><Icon name="file-text" /> Contratos que requieren atención ({dueContracts.length})</h2>
            <a class="btn btn-ghost btn-sm" href="/proveedores/contratos?ver=atencion">Ver todos</a>
          </div>
          <p class="muted small">Próximos a caducar (según el aviso de cada uno), pendientes de renovación o caducados sin renovar.</p>
          <ul class="list">
            {dueContracts.slice(0, 5).map((c) => (
              <li><a class="item" href={`/proveedores/${c.supplier_id}/contratos/${c.id}`}>
                <div class="item-body">
                  <span class="item-title">{c.supplier_name} <span class="muted">· {c.title}</span></span>
                  <span class="item-meta"><span>{c.ends_on ? `Fin: ${formatDate(c.ends_on)}` : 'Sin fecha de fin'}</span><span>{c.state.text}</span></span>
                  <span class="item-flags"><Pill state={c.state} /></span>
                </div>
                <Icon name="chevron-right" class="chev" />
              </a></li>
            ))}
          </ul>
        </section>
      )}
      {reviewer && ready.length > 0 && (
        <section class="card card-alert">
          <div class="sec-head">
            <h2><Icon name="bell" /> Facturas por conformar ({ready.length})</h2>
            <a class="btn btn-ghost btn-sm" href="/pagos?ver=revisar">Ver todas</a>
          </div>
          <p class="muted small">De pagos ya hechos: comprueba la factura y dale a «Conforme».</p>
          <ul class="list">{ready.slice(0, 4).map((si) => <ReviewItem si={si} canReview />)}</ul>
        </section>
      )}
      {admin && fresh.length > 0 && (
        <section class="card">
          <div class="sec-head">
            <h2><Icon name="folder-plus" /> Expedientes nuevos esta semana ({fresh.length})</h2>
            <a class="btn btn-ghost btn-sm" href="/expedientes">Ver todos</a>
          </div>
          <p class="muted small">Ya están en curso con su número. Si el número tiene que coincidir con el de contabilidad, cámbialo en «Editar».</p>
          <ul class="list">
            {fresh.map((e) => (
              <li><a class="item" href={`/expedientes/${e.id}`}>
                <div class="item-body">
                  <span class="item-title"><span class="exp-num">{expLabel(e)}</span> {e.name} <span class="muted">· {e.company}</span></span>
                  <span class="item-meta"><span>{formatRange(e.start_date, e.end_date)}</span><span>{e.requested_by_name ?? 'Alguien'} · {formatStamp(e.requested_at)}</span></span>
                </div>
                <div class="item-amount"><span class="money"><strong>{eur(e.budget_base ?? 0)}</strong></span><small>sin IVA</small></div>
                <Icon name="chevron-right" class="chev" />
              </a></li>
            ))}
          </ul>
        </section>
      )}

      <section class="card">
        <div class="sec-head">
          <h2><Icon name="arrow-up-right" /> Pagos urgentes</h2>
          <a class="btn btn-ghost btn-sm" href="/pagos">Ver todos</a>
        </div>
        {urgent.length
          ? <ul class="list">{urgent.slice(0, 6).map((p) => <PaymentItem p={p} now={now} showExp />)}</ul>
          : <p class="muted">Nada vence en los próximos {SOON_DAYS} días.</p>}
        {urgent.length > 6 && <p class="muted small mt">Y {urgent.length - 6} más en la bandeja de pagos.</p>}
      </section>

      {cobros && (toIssue.length > 0 || overdueInvoices.length > 0) && (
        <section class="card">
          <div class="sec-head">
            <h2><Icon name="arrow-down-left" /> Facturas por emitir y cobros vencidos</h2>
            <a class="btn btn-ghost btn-sm" href="/cobros">Ver todos</a>
          </div>
          <ul class="list">{[...toIssue, ...overdueInvoices].slice(0, 6).map((i) => <InvoiceItem i={i} now={now} showExp canIssue={can(me, 'invoice.issue')} />)}</ul>
        </section>
      )}
    </div>

    <div class="stack">
      <section class="card">
        <div class="sec-head">
          <h2><Icon name="folder" /> {office ? 'Expedientes en marcha' : 'Mis expedientes'}</h2>
          <a class="btn btn-ghost btn-sm" href={office ? '/expedientes' : '/expedientes?ver=mios'}>Ver todos</a>
        </div>
        {open.length ? (
          <ul class="list">
            {open.map((e) => (
              <li><a class="item" href={`/expedientes/${e.id}`}>
                <div class="item-body">
                  <span class="item-title"><span class:list={['exp-num', { 'is-draft': !e.number }]}>{expLabel(e)}</span> {e.name}</span>
                  <span class="item-meta"><span>{e.company}</span><span>{formatRange(e.start_date, e.end_date)}</span></span>
                  <span class="item-flags"><Pill state={expedienteState(e, now)} /></span>
                </div>
                <Icon name="chevron-right" class="chev" />
              </a></li>
            ))}
          </ul>
        ) : (
          <div class="empty">
            <p>No hay expedientes en marcha.</p>
            <p class="mt"><a class="btn btn-primary btn-sm" href="/expedientes/nuevo"><Icon name="folder-plus" size={16} /> Nuevo expediente</a></p>
          </div>
        )}
      </section>

      {toClose.length > 0 && (
        <section class="card">
          <h2><Icon name="lock" size={18} /> Celebrados, por cerrar</h2>
          <ul class="steps">
            {toClose.map((e) => (
              <li class="tone-info"><a href={`/expedientes/${e.id}/cierre`}><Icon name="info" /> {expLabel(e)} · {e.name}<Icon name="chevron-right" size={18} class="chev" /></a></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</App>
