---
// Inicio: sólo lo que hay que hacer, en una lista corta. Cada línea dice cuántos hay y lleva a donde se
// resuelve (si es una sola cosa, directamente a su ficha). Las listas completas están en Expedientes,
// Pagos y Cobros: aquí no se repiten. Debajo, lo último que ha pasado.
//  · Administración: todo (solicitudes, pagos, facturas por conformar, emitir, enviar, cobrar, PO, cierres).
//  · Eventos: lo de sus expedientes (facturas que reclamar, pagos que vencen) y lo que espera a Administración.
import { env } from 'cloudflare:workers';
import App from '../layouts/App.astro';
import Icon from '../components/Icon.astro';
import { can } from '../lib/app.js';
import { pendingPayments, paidWithoutInvoice, openInvoices, posWithBalance, invoicesToReview } from '../lib/data.js';
import { plural, SOON_DAYS } from '../lib/finance.js';
import { eur } from '../lib/money.js';
import { today, addDays, formatStamp, formatDateLong } from '../lib/dates.js';

const db = env.DB;
const me = Astro.locals.user;
const admin = can(me, 'expediente.open');
const now = today();
const soon = addDays(now, SOON_DAYS);
const all = (rows) => rows;
const mine = admin ? all : (rows) => rows.filter((r) => r.exp_manager_id === me.id);

const [review, urgent, invoices, pos, requests, toClose, noInvoice, activity] = await Promise.all([
  can(me, 'supplier.review') ? invoicesToReview(db) : [],
  pendingPayments(db, '', { until: soon }),
  openInvoices(db),
  can(me, 'po.manage') ? posWithBalance(db) : [],
  db.prepare(`SELECT id, name, company FROM expedientes WHERE status = 'solicitado' ${admin ? '' : 'AND manager_id = ?'} ORDER BY requested_at`)
    .bind(...(admin ? [] : [me.id])).all().then((r) => r.results),
  admin
    ? db.prepare(`SELECT id, number, name FROM expedientes WHERE status = 'abierto' AND COALESCE(end_date, start_date) < ? ORDER BY end_date`)
      .bind(now).all().then((r) => r.results)
    : [],
  admin ? [] : paidWithoutInvoice(db),
  db.prepare(`SELECT a.user_name, a.text, a.action, a.at, a.expediente_id, e.number, e.name
                FROM activity a JOIN expedientes e ON e.id = a.expediente_id
               ${admin ? '' : 'WHERE e.manager_id = ?'}
               ORDER BY a.at DESC, a.id DESC LIMIT 10`).bind(...(admin ? [] : [me.id])).all().then((r) => r.results),
]);

const sum = (rows, f = 'total_cents') => rows.reduce((a, r) => a + (r[f] ?? 0), 0);
const payments = mine(urgent);
const overdue = payments.filter((p) => p.due_date < now);
const dueSoon = payments.filter((p) => p.due_date >= now);
const myInvoices = mine(invoices);
const toIssue = myInvoices.filter((i) => i.status === 'por_emitir');
const issued = myInvoices.filter((i) => i.status === 'emitida');
const unsent = issued.filter((i) => !i.sent_at);
const overdueInvoices = issued.filter((i) => i.due_date && i.due_date < now);
const ready = review.filter((si) => !si.unpaid_count); // facturas de proveedor con el pago ya hecho
const chase = mine(noInvoice);

// Cada línea: cuántos, de qué (con los primeros nombres) y a dónde lleva
const todo = [];
const names = (rows, name) => `${rows.slice(0, 3).map(name).join(', ')}${rows.length > 3 ? '…' : ''}`;
const add = ({ tone, rows, text, name, href, one, amount = 'total_cents' }) => {
  if (!rows.length) return;
  todo.push({
    tone, text: text(rows.length), detail: name ? names(rows, name) : '',
    amount: amount ? sum(rows, amount) : null,
    href: rows.length === 1 && one ? one(rows[0]) : href,
  });
};
const payHref = (p) => `/expedientes/${p.expediente_id}/pagos/${p.id}`;
const invHref = (i) => `/expedientes/${i.expediente_id}/facturas/${i.id}`;
const expName = (r) => r.exp_number ? `EXP ${r.exp_number}` : r.exp_name;

add({ tone: 'danger', rows: overdue, text: (n) => `${plural(n, 'pago vencido', 'pagos vencidos')} a proveedores`, name: (p) => p.supplier, href: '/pagos', one: payHref });
if (admin) {
  add({ tone: 'danger', rows: overdueInvoices, text: (n) => `${plural(n, 'cobro vencido', 'cobros vencidos')}`, name: (i) => i.billed_to, href: '/cobros#cobrar', one: invHref });
  add({ tone: 'warn', rows: requests, text: (n) => `${plural(n, 'solicitud', 'solicitudes')} por abrir`, name: (e) => `${e.name} (${e.company})`,
    href: '/expedientes?ver=solicitudes', one: (e) => `/expedientes/${e.id}`, amount: null });
  add({ tone: 'warn', rows: ready, text: (n) => `${plural(n, 'factura de proveedor', 'facturas de proveedor')} por conformar`, name: (si) => si.supplier,
    href: '/pagos?ver=revisar', amount: 'payments_total' });
}
if (!admin) {
  add({ tone: 'warn', rows: chase, text: (n) => `Reclamar la factura al proveedor (${plural(n, 'pago hecho', 'pagos hechos')} sin factura)`, name: (p) => p.supplier,
    href: '/pagos#sin-factura', one: (p) => `${payHref(p)}#factura` });
}
add({ tone: 'warn', rows: dueSoon, text: (n) => `${plural(n, 'pago vence', 'pagos vencen')} en los próximos ${SOON_DAYS} días`, name: (p) => p.supplier, href: '/pagos', one: payHref });
if (admin) {
  add({ tone: 'warn', rows: toIssue, text: (n) => `${plural(n, 'factura', 'facturas')} al cliente por emitir`, name: (i) => i.billed_to, href: '/cobros#emitir', one: invHref });
  add({ tone: 'warn', rows: unsent, text: (n) => `${plural(n, 'factura emitida', 'facturas emitidas')} sin enviar al cliente`, name: (i) => i.number,
    href: '/cobros#cobrar', one: (i) => `${invHref(i)}#envio` });
  add({ tone: 'info', rows: pos, text: (n) => `${plural(n, 'PO', 'PO')} con importe sin facturar`, name: (po) => `${po.number} · ${expName(po)}`,
    href: '/cobros#facturar', one: (po) => `/expedientes/${po.expediente_id}/facturas/nueva?po=${po.id}`, amount: 'left_cents' });
  add({ tone: 'info', rows: toClose, text: (n) => `${plural(n, 'expediente celebrado', 'expedientes celebrados')} por cerrar`, name: (e) => (e.number ? `EXP ${e.number}` : e.name),
    href: '/expedientes?ver=cerrar', one: (e) => `/expedientes/${e.id}/cierre`, amount: null });
}
// Eventos: lo suyo que está en manos de Administración (para saber que no se ha quedado parado)
const waiting = [];
if (!admin) {
  if (requests.length) waiting.push({ text: `${plural(requests.length, 'solicitud', 'solicitudes')} esperando a que Administración la${requests.length > 1 ? 's' : ''} abra`,
    detail: names(requests, (e) => e.name), href: requests.length === 1 ? `/expedientes/${requests[0].id}` : '/expedientes?ver=mios' });
  if (toIssue.length) waiting.push({ text: `${plural(toIssue.length, 'factura pedida', 'facturas pedidas')} pendiente${toIssue.length > 1 ? 's' : ''} de emitir`,
    detail: names(toIssue, (i) => i.billed_to), href: toIssue.length === 1 ? invHref(toIssue[0]) : '/cobros#emitir' });
}
const firstName = me.name.split(' ')[0];
const icon = { danger: 'triangle-alert', warn: 'clock', info: 'info' };
---
<App title="Inicio" section="inicio" origin="Inicio">
  <div class="page-top">
    <div>
      <h1>Hola, {firstName}</h1>
      <p>{formatDateLong(now)} · {todo.length ? 'esto es lo que tienes pendiente' : 'todo al día'}</p>
    </div>
  </div>

  <div class="two-col">
    <div class="stack">
      <section class="card" id="pendiente">
        <div class="sec-head">
          <h2><Icon name="list-checks" /> {admin ? 'Pendiente' : 'Te toca'}</h2>
          <p>{admin ? 'Lo que hay que mover, de lo más urgente a lo menos.' : 'Lo que depende de ti en tus expedientes.'}</p>
        </div>
        {todo.length ? (
          <ul class="steps todo">
            {todo.map((t) => (
              <li class={`tone-${t.tone}`}>
                <a href={t.href}>
                  <Icon name={icon[t.tone]} />
                  <span class="todo-text">{t.text}{t.detail && <small>{t.detail}</small>}</span>
                  {t.amount !== null && <span class="todo-amount money">{eur(t.amount)}</span>}
                  <Icon name="chevron-right" size={18} class="chev" />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="steps"><li class="tone-ok"><span><Icon name="circle-check" /> Nada pendiente. ¡Todo al día!</span></li></ul>
        )}
        {waiting.length > 0 && (
          <>
            <h3 class="form-sub mt">Esperando a Administración</h3>
            <ul class="steps todo">
              {waiting.map((w) => (
                <li class="tone-info">
                  <a href={w.href}>
                    <Icon name="info" />
                    <span class="todo-text">{w.text}{w.detail && <small>{w.detail}</small>}</span>
                    <Icon name="chevron-right" size={18} class="chev" />
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    </div>

    <section class="card">
      <h2>Actividad reciente{!admin && <span class="muted small"> · tus expedientes</span>}</h2>
      {activity.length ? (
        <ul class="activity">
          {activity.map((a) => (
            <li>
              <time datetime={a.at}>{formatStamp(a.at)}</time>
              <span><strong>{a.user_name ?? 'Alguien'}</strong> {a.action === 'note' ? 'escribió una nota en' : a.text} · <a href={`/expedientes/${a.expediente_id}`}>{a.number ? `EXP ${a.number}` : a.name}</a></span>
            </li>
          ))}
        </ul>
      ) : <p class="muted">Aún no hay actividad.</p>}
    </section>
  </div>
</App>
