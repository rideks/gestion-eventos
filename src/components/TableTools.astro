---
// Encima de una tabla de listado: el buscador (por las propiedades de esa tabla) y un desplegable por filtro; luego
// las pestañas de la página (slot «tabs»), y una barra con el resumen (lo que se pasa dentro: «143 clientes · …»),
// el cambio de vista (tarjetas o tabla, si la tabla lo tiene) y «Columnas» para añadir o quitar columnas (se guarda
// para cada persona; ver src/services/prefs.js). Los filtros se aplican al cambiarlos (con JavaScript) o con «Buscar».
// El orden y las filas por página se conservan; en la vista de tarjetas, el orden se elige en un desplegable.
//   def: la tabla (src/lib/tables.js) · state: tableState() · filters: [{ key, label, all, options: [[valor, texto]] }]
//   keep: otros parámetros de la página que se conservan al buscar (p. ej. la pestaña: 'ver')
//   cardSort: false si las tarjetas tienen su propio orden (p. ej. agrupadas por plazos o por meses): sin desplegable
import Icon from './Icon.astro';
import { hrefWith, isFiltered, PER_PAGE } from '../lib/table.js';

const { def, state, filters = [], url, label = null, keep: extra = [], cardSort = true } = Astro.props;
const back = `${url.pathname}${url.search}`;
const cards = state.view === 'tarjetas';
// En tarjetas no hay cabeceras: el orden va en un desplegable (y cada columna en su sentido natural)
const sortable = cards && cardSort ? state.columns.filter((c) => c.sort) : [];
const keep = [...(cards ? [] : ['orden', 'dir']), 'por', ...extra].filter((k) => url.searchParams.get(k));
const clear = hrefWith(url, { q: null, ...Object.fromEntries(filters.map((f) => [f.key, null])) });
const optional = state.columns.filter((c) => !c.fixed);
const views = def.views ?? [];
const VIEW_LABELS = { tarjetas: ['layout-list', 'Tarjetas'], tabla: ['table', 'Tabla'] };
---
<form method="get" class="quick-form table-filters" role="search" data-table-filters>
  {keep.map((k) => <input type="hidden" name={k} value={url.searchParams.get(k)} />)}
  <label class="visually-hidden" for={`${def.key}-q`}>{label ?? `Buscar ${def.noun[0]}`}</label>
  <input id={`${def.key}-q`} name="q" type="search" value={state.q} placeholder={def.search} />
  {filters.map((f) => (
    <>
      <label class="visually-hidden" for={`${def.key}-${f.key}`}>{f.label}</label>
      <select id={`${def.key}-${f.key}`} name={f.key} data-auto-submit>
        <option value="">{f.all}</option>
        {f.options.map(([value, text]) => <option value={value} selected={String(state.filters[f.key] ?? '') === String(value)}>{text}</option>)}
      </select>
    </>
  ))}
  {sortable.length > 0 && (
    <>
      <label class="visually-hidden" for={`${def.key}-orden`}>Ordenar por</label>
      <select id={`${def.key}-orden`} name="orden" data-auto-submit>
        {sortable.map((c) => <option value={c.key} selected={state.sort === c.key}>Por {c.label.toLowerCase()}</option>)}
      </select>
    </>
  )}
  <button class="btn btn-ghost btn-sm" type="submit"><Icon name="search" size={16} /> Buscar</button>
  {isFiltered(state) && <a class="btn btn-ghost btn-sm table-clear" href={clear}><Icon name="x" size={16} /> Quitar filtros</a>}
</form>

<slot name="tabs" />

<div class="table-bar">
  <p class="table-summary"><slot /></p>
  <div class="table-bar-actions">
    {views.length > 1 && (
      <form method="post" action="/preferencias/tabla" class="view-switch" aria-label="Ver como">
        <input type="hidden" name="tabla" value={def.key} />
        <input type="hidden" name="volver" value={back} />
        <input type="hidden" name="intent" value="view" />
        {views.map((v) => (
          <button type="submit" name="vista" value={v} aria-pressed={state.view === v ? 'true' : 'false'} title={`Ver como ${VIEW_LABELS[v][1].toLowerCase()}`}>
            <Icon name={VIEW_LABELS[v][0]} size={16} /> {VIEW_LABELS[v][1]}
          </button>
        ))}
      </form>
    )}
    {!cards && optional.length > 0 && (
      <details class="table-columns">
        <summary class="btn btn-ghost btn-sm"><Icon name="list-checks" size={16} /> Columnas</summary>
        <form method="post" action="/preferencias/tabla" class="table-columns-pop">
          <input type="hidden" name="tabla" value={def.key} />
          <input type="hidden" name="volver" value={back} />
          <p class="small muted">Elige las columnas que quieres ver. Se guarda para ti.</p>
          <div class="table-columns-list">
            {optional.map((c) => (
              <label><input type="checkbox" name="columnas" value={c.key} checked={state.chosen.includes(c.key)} /> {c.label}</label>
            ))}
          </div>
          <label class="table-columns-per">Filas por página
            <select name="por">{PER_PAGE.map((n) => <option value={n} selected={state.per === n}>{n}</option>)}</select>
          </label>
          <div class="actions-inline">
            <button class="btn btn-primary btn-sm" type="submit" name="intent" value="save">Guardar</button>
            <button class="btn btn-ghost btn-sm" type="submit" name="intent" value="reset" formnovalidate>Las de siempre</button>
          </div>
        </form>
      </details>
    )}
  </div>
</div>

<script>
  // Los desplegables de filtro se aplican al cambiarlos; los campos vacíos no van a la URL
  document.querySelectorAll('[data-table-filters] [data-auto-submit]').forEach((el) => {
    el.addEventListener('change', () => (el instanceof HTMLSelectElement ? el.form?.requestSubmit() : null));
  });
  document.querySelectorAll('form[data-table-filters]').forEach((form) => {
    form.addEventListener('formdata', (e) => {
      for (const [k, v] of [...e.formData.entries()]) if (v === '') e.formData.delete(k);
    });
  });
  // Toda la fila lleva a su ficha (el enlace de la primera columna sigue siendo el de teclado); no si se pulsa otro
  // enlace o botón de la fila, ni si se está seleccionando texto
  document.querySelectorAll('tr[data-href]').forEach((tr) => {
    tr.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target : null;
      if (!target || target.closest('a, button, input, select, label, summary') || String(window.getSelection() ?? '')) return;
      const href = tr.getAttribute('data-href');
      if (!href) return;
      if (e instanceof MouseEvent && (e.metaKey || e.ctrlKey)) window.open(href, '_blank');
      else window.location.assign(href);
    });
  });
</script>
