---
// Icono SVG en línea. <Icon name="receipt" />
import { UI_ICONS } from '../lib/icons.js';

const { name, size = 20, label, class: className } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg
  viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor"
  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} {...a11y}
  set:html={UI_ICONS[name] ?? ''}
/>
