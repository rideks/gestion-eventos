---
// Campos de una factura al cliente: a quién (con sus datos fiscales), qué PO cubre (y cuánto de cada una),
// el concepto y los importes. El número NO se escribe: se asigna al emitirla (Ajustes → formato).
// Si al cliente ya se le ha facturado antes, su NIF, dirección y email se rellenan solos.
import VatLines from './VatLines.astro';
import { eur, amountInput } from '../lib/money.js';

const {
  v = {}, errors = {}, companies = [], poRows = [], id = 'inv', admin = false,
  allocated = new Map(), // po_id → importe que esta factura ya tiene de esa PO (al editar)
  checked = null,        // po_id marcados tras un error
  rates = [], lines = [], // tipos de IVA y desglose (guardado o lo escrito antes de un error)
  clients = [],          // datos fiscales de los clientes ya facturados (para rellenarlos solos)
} = Astro.props;
// PO que se pueden usar: las abiertas con saldo y las que ya usa esta factura
const usable = poRows.filter((po) => po.billable_cents > 0 || allocated.has(po.id));
const isChecked = (po) => (checked ? checked.includes(po.id) : allocated.has(po.id));
const amountFor = (po) => {
  const typed = v[`po_amount_${po.id}`];
  if (typeof typed === 'string') return typed;
  return amountInput(allocated.get(po.id) ?? po.billable_cents);
};
---
<fieldset class="form-block" data-clients={JSON.stringify(clients)}>
  <legend class="label">Cliente</legend>
  <div class="row row-2">
    <div class:list={['field', { 'has-error': errors.billed_to }]}>
      <label for={`${id}-billed_to`}>Razón social</label>
      <input id={`${id}-billed_to`} name="billed_to" type="text" required maxlength="120" list={`${id}-companies`} value={v.billed_to ?? ''} placeholder="Nombre fiscal del cliente" data-client-name />
      <datalist id={`${id}-companies`}>{companies.map((c) => <option value={c} />)}</datalist>
    </div>
    <div class:list={['field', { 'has-error': errors.billed_tax_id }]}>
      <label for={`${id}-billed_tax_id`}>NIF / CIF</label>
      <input id={`${id}-billed_tax_id`} name="billed_tax_id" type="text" maxlength="20" value={v.billed_tax_id ?? ''} placeholder="B12345678" data-client="billed_tax_id" />
    </div>
  </div>
  <div class="row row-2">
    <div class:list={['field', { 'has-error': errors.billed_address }]}>
      <label for={`${id}-billed_address`}>Dirección fiscal</label>
      <input id={`${id}-billed_address`} name="billed_address" type="text" maxlength="300" value={v.billed_address ?? ''} placeholder="Calle y número, código postal y ciudad" data-client="billed_address" />
    </div>
    <div class:list={['field', { 'has-error': errors.billed_email }]}>
      <label for={`${id}-billed_email`}>Email de facturación</label>
      <input id={`${id}-billed_email`} name="billed_email" type="email" maxlength="200" value={v.billed_email ?? ''} placeholder="facturas@cliente.com" data-client="billed_email" />
      <p class="hint">A dónde se envía la factura.</p>
    </div>
  </div>
  <p class="hint">Para emitirla hacen falta el NIF/CIF y la dirección fiscal. Si ya se le ha facturado antes, se rellenan solos.</p>
</fieldset>

<fieldset class="field" data-po-alloc>
  <legend class="label">PO que cubre esta factura</legend>
  {usable.length ? (
    <div class="rows-scroll">
      <table class="rows-table">
        <thead><tr><th scope="col" class="narrow"></th><th scope="col">PO</th><th scope="col">Sin facturar</th><th scope="col">Se factura</th></tr></thead>
        <tbody>
          {usable.map((po) => (
            <tr>
              <td><input type="checkbox" name="po_ids" value={po.id} checked={isChecked(po)} aria-label={`Usar la PO ${po.number}`} data-po-check /></td>
              <td><strong>{po.number}</strong>{po.closed && <span class="muted small"> · cerrada</span>}<br /><span class="muted small">{po.billed_to}</span></td>
              <td class="money">{eur(po.billable_cents + (allocated.get(po.id) ?? 0))}</td>
              <td class="amount"><input type="text" inputmode="decimal" name={`po_amount_${po.id}`} value={amountFor(po)} aria-label={`Importe de la PO ${po.number}`} data-po-amount autocomplete="off" /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="muted small">No hay PO con saldo. Si el cliente trabaja con PO, Administración las sube en «Órdenes de compra»; si no, deja esto así.</p>
  )}
  {usable.length > 0 && <p class="hint">Al marcar las PO, el importe sin IVA de la factura se rellena con la suma (si tiene una sola línea de IVA).</p>}
</fieldset>

<div class:list={['field', { 'has-error': errors.concept }]}>
  <label for={`${id}-concept`}>Concepto <span class="opt">(sale en la factura)</span></label>
  <textarea id={`${id}-concept`} name="concept" class="short" maxlength="500" placeholder="Workshop BMW · alojamiento, sala y coffee break · 26–27 ago 2026">{v.concept ?? ''}</textarea>
</div>

<VatLines id={id} lines={lines} rates={rates} error={errors.amount}
  hint="Si se queda vacío, se usa la suma de las PO marcadas. Con varios tipos de IVA, añade una línea por tipo." />

{admin && (
  <div class="row row-2">
    <div class:list={['field', { 'has-error': errors.issued_on }]}>
      <label for={`${id}-issued_on`}>Fecha de emisión</label>
      <input id={`${id}-issued_on`} name="issued_on" type="date" value={v.issued_on ?? ''} />
      <p class="hint">Al emitirla. El número se asigna solo.</p>
    </div>
    <div class:list={['field', { 'has-error': errors.due_date }]}>
      <label for={`${id}-due_date`}>Vencimiento</label>
      <input id={`${id}-due_date`} name="due_date" type="date" value={v.due_date ?? ''} />
    </div>
  </div>
)}
<div class:list={['field', { 'has-error': errors.notes }]}>
  <label for={`${id}-notes`}>{admin ? 'Notas internas' : 'Notas para Administración'} <span class="opt">(opcional · no salen en la factura)</span></label>
  <input id={`${id}-notes`} name="notes" type="text" maxlength="1000" value={v.notes ?? ''} placeholder="Ej.: enviar a cuentas a pagar con copia a Ana" />
</div>

<script>
  import { parseAmount, amountInput } from '../lib/money.js';

  // Datos fiscales del cliente: si ya se le ha facturado, se rellenan los que estén vacíos
  document.querySelectorAll('[data-clients]').forEach((box) => {
    let clients = [];
    try {
      clients = JSON.parse(box.getAttribute('data-clients') ?? '[]');
    } catch { /* sin datos */ }
    const name = box.querySelector('[data-client-name]');
    if (!(name instanceof HTMLInputElement) || !clients.length) return;
    name.addEventListener('change', () => {
      const found = clients.find((c) => c.billed_to.toLowerCase() === name.value.trim().toLowerCase());
      if (!found) return;
      box.querySelectorAll('[data-client]').forEach((input) => {
        if (input instanceof HTMLInputElement && !input.value.trim()) input.value = found[input.dataset.client] ?? '';
      });
    });
  });

  document.querySelectorAll('[data-po-alloc]').forEach((box) => {
    const form = box.closest('form');
    let lastAuto = '';
    const update = () => {
      // Sólo con una línea de IVA: con varias, el reparto entre tipos lo decide la persona
      const rows = form?.querySelectorAll('[data-vat-row]') ?? [];
      const base = rows.length === 1 ? rows[0].querySelector('[data-base]') : null;
      if (!(base instanceof HTMLInputElement)) return;
      let cents = 0;
      let any = false;
      box.querySelectorAll('tbody tr').forEach((row) => {
        const check = row.querySelector('[data-po-check]');
        const amount = row.querySelector('[data-po-amount]');
        if (!(check instanceof HTMLInputElement) || !(amount instanceof HTMLInputElement) || !check.checked) return;
        const v = parseAmount(amount.value);
        if (v !== null && !Number.isNaN(v)) {
          cents += v;
          any = true;
        }
      });
      // Sólo se toca el importe si está vacío o lo habíamos puesto nosotros
      if (base.value.trim() !== '' && base.value !== lastAuto) return;
      lastAuto = any ? amountInput(cents) : '';
      base.value = lastAuto;
      base.dispatchEvent(new Event('input', { bubbles: true }));
    };
    box.addEventListener('change', update);
    box.addEventListener('input', (e) => {
      if (e.target instanceof HTMLElement && e.target.matches('[data-po-amount]')) {
        const check = e.target.closest('tr')?.querySelector('[data-po-check]');
        if (check instanceof HTMLInputElement) check.checked = true;
        update();
      }
    });
  });
</script>
