---
// La factura del proveedor: el documento y lo que se anota de él (número, fecha, total).
// Quien la sube basta con que adjunte el documento; Administración la revisa y anota el número.
import FileField from './FileField.astro';
import { amountInput } from '../lib/money.js';

const { v = {}, errors = {}, id = 'si', fileRequired = false, label = 'Factura del proveedor (PDF o foto)' } = Astro.props;
const total = typeof v.invoice_total === 'string' ? v.invoice_total : amountInput(v.invoice_total ?? null);
---
<FileField id={`${id}-file`} label={label} required={fileRequired} />
<div class="row row-3">
  <div class:list={['field', { 'has-error': errors.invoice_number }]}>
    <label for={`${id}-number`}>Nº de factura <span class="opt">(si lo sabes)</span></label>
    <input id={`${id}-number`} name="invoice_number" type="text" maxlength="60" value={v.invoice_number ?? ''} autocomplete="off" />
  </div>
  <div class:list={['field', { 'has-error': errors.invoice_date }]}>
    <label for={`${id}-date`}>Fecha de la factura</label>
    <input id={`${id}-date`} name="invoice_date" type="date" value={v.invoice_date ?? ''} />
  </div>
  <div class:list={['field', { 'has-error': errors.invoice_total }]}>
    <label for={`${id}-total`}>Total de la factura <span class="opt">(opcional)</span></label>
    <input id={`${id}-total`} name="invoice_total" type="text" inputmode="decimal" value={total} placeholder="IVA incluido" autocomplete="off" />
  </div>
</div>
<p class="hint muted small">Si la factura cubre varios pagos (p. ej. dos anticipos), pon su total: así se comprueba que cuadra con la suma de los pagos.
  Queda <strong>pendiente de revisar</strong> hasta que Administración la dé por buena.</p>
