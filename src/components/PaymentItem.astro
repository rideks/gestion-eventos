---
// Una fila de coste / pago a proveedor (en el expediente y en la bandeja de pagos).
import Icon from './Icon.astro';
import Pill from './Pill.astro';
import { paymentState, supplierInvoiceState, PAYMENT_METHODS } from '../lib/finance.js';
import { eur } from '../lib/money.js';
import { formatDate, dueText } from '../lib/dates.js';
import { fileUrl, ACCEPT } from '../lib/files.js';
import { can } from '../lib/app.js';

const { p, now, showExp = false, canEdit = true } = Astro.props;
const state = paymentState(p, now);
const href = fileUrl(p);
const edit = `/expedientes/${p.expediente_id}/pagos/${p.id}`;
const invoice = supplierInvoiceState(p);
const missingInvoice = !p.invoice_count && p.total_cents !== 0;
const canPay = canEdit && p.status !== 'pagado';
// Eventos sólo marca pagados los pagos con tarjeta; las transferencias (con justificante) las marca Administración
const cardOnly = !can(Astro.locals.user, 'payment.any_method');
const receipt = fileUrl({ file_id: p.receipt_file_id, file_name: p.receipt_name });
---
<li class="item is-row">
  <div class="item-body">
    {showExp && <a class="item-meta" href={`/expedientes/${p.expediente_id}/pagos`}><strong>{p.exp_number ? `EXP ${p.exp_number}` : 'Solicitud'}</strong> · {p.exp_name}</a>}
    <a class="item-title" href={edit}>{p.supplier}{p.concept && <span class="muted"> · {p.concept}</span>}</a>
    <span class="item-meta">
      {p.invoice_count
        ? <span>{p.invoice_count > 1 ? 'Facturas' : 'Factura'} {p.invoice_number ?? 'sin número todavía'}</span>
        : <span>{p.proforma_count ? 'Con proforma, sin factura todavía' : 'Sin factura todavía'}</span>}
      {p.status === 'pagado'
        ? <span>Pagado el {formatDate(p.paid_on)}{p.method && ` · ${PAYMENT_METHODS[p.method]}`}</span>
        : p.due_date ? <span>Límite {formatDate(p.due_date)} · {dueText(p.due_date, now)}</span> : <span>Sin fecha límite</span>}
    </span>
    <span class="item-flags">
      <Pill state={state} />
      {invoice && invoice.key !== 'sin' && <Pill state={invoice} />}
      {href && <a class="doc-link" href={href} target="_blank" rel="noopener"><Icon name="paperclip" size={15} />{p.file_name}</a>}
      {receipt && <a class="doc-link" href={receipt} target="_blank" rel="noopener"><Icon name="banknote" size={15} />Justificante</a>}
    </span>
  </div>
  <div class="item-amount">
    <span class:list={['big-money money', { neg: p.total_cents < 0 }]}>{eur(p.total_cents)}</span>
    <small class="money">{eur(p.base_cents)} sin IVA</small>
  </div>
  <div class="item-foot">
      {canPay && cardOnly && (
        <form method="post" class="quick-form">
          <input type="hidden" name="intent" value="pay" />
          <input type="hidden" name="payment_id" value={p.id} />
          <input type="hidden" name="method" value="tarjeta" />
          <label class="visually-hidden" for={`paid-${p.id}`}>Fecha del pago con tarjeta</label>
          <input id={`paid-${p.id}`} type="date" name="paid_on" value={now} required />
          <button class="btn btn-sm" type="submit" data-busy="Guardando…" title="Sólo si se ha pagado con tarjeta: las transferencias las marca Administración"><Icon name="credit-card" size={16} /> Pagado con tarjeta</button>
        </form>
      )}
      {canPay && !cardOnly && (
        <form method="post" enctype="multipart/form-data" class="quick-form" data-has-receipt={p.receipt_file_id ? '1' : '0'} data-receipt-href={`${edit}#justificante`}>
          <input type="hidden" name="intent" value="pay" />
          <input type="hidden" name="payment_id" value={p.id} />
          <label class="visually-hidden" for={`paid-${p.id}`}>Fecha de pago</label>
          <input id={`paid-${p.id}`} type="date" name="paid_on" value={now} required />
          <label class="visually-hidden" for={`method-${p.id}`}>Forma de pago</label>
          <select id={`method-${p.id}`} name="method">
            {Object.entries(PAYMENT_METHODS).map(([k, v]) => <option value={k}>{v}</option>)}
          </select>
          {!p.receipt_file_id && (
            <label class="btn btn-ghost btn-sm file-btn" title="Justificante bancario (obligatorio si es por transferencia)">
              <Icon name="paperclip" size={16} /><span data-file-button>Justificante</span>
              <input type="file" name="receipt" accept={ACCEPT} class="visually-hidden" title="" />
            </label>
          )}
          <button class="btn btn-sm" type="submit" data-receipt-check data-busy="Guardando…"><Icon name="check" size={16} /> Pagado</button>
        </form>
      )}
      {canEdit && missingInvoice
        ? <a class="btn btn-ghost btn-sm" href={edit}><Icon name="paperclip" size={16} /> Añadir factura</a>
        : <a class="btn btn-ghost btn-sm" href={edit}><Icon name="eye" size={16} /> Ver</a>}
  </div>
</li>
