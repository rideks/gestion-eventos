---
// Página de acceso / alta (sin menú)
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '../styles/app.css';
import { env } from 'cloudflare:workers';

const { title, heading, intro = null } = Astro.props;
const company = env.COMPANY_NAME || 'Seven Worlds';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · {company}</title>
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>
  <body>
    <main class="auth">
      <img class="auth-logo" src="/brand/logo.png" alt={`${company} · Events & Congresses`} width="260" height="124" />
      <div class="auth-card">
        <h1>{heading}</h1>
        <p>{intro ?? 'Gestión de eventos'}</p>
        <slot />
      </div>
    </main>
  </body>
</html>
