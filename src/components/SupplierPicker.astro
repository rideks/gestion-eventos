---
// Campo «Proveedor» de un pago: se elige de la lista de proveedores dados de alta (no se escribe uno
// cualquiera). Manda el nombre y su id (supplier_id). Lo hace funcionar SupplierPickerKit, que va una
// vez en la página. Sin JavaScript queda un campo de texto con sugerencias y el servidor sólo acepta
// el nombre exacto de un proveedor.
// name: 'supplier' (un pago) o 'fc_supplier' (filas de pagos previstos; el id va en fc_supplier_id).
// keepId: el proveedor que ya tiene el pago (se puede mantener aunque esté en «No contratar»).
const { id = undefined, name = 'supplier', value = '', valueId = null, keepId = null, required = false, label = undefined, placeholder = '' } = Astro.props;
---
<div class="picker" data-supplier-picker data-keep-id={keepId ?? undefined}>
  <input id={id} name={name} type="text" maxlength="120" value={value ?? ''} required={required} aria-label={label}
    placeholder={placeholder} autocomplete="off" spellcheck="false" list="supplier-names" data-picker-input />
  <input type="hidden" name={`${name}_id`} value={valueId ?? ''} data-picker-id />
</div>
