---
// Lo que necesitan los campos «Proveedor» (SupplierPicker) de la página: la lista de proveedores, el
// desplegable y la ventana «Dar de alta». Va UNA vez por página y fuera de cualquier formulario.
// Al escribir se buscan por nombre, nombre anterior, tipo o ciudad (sin acentos ni mayúsculas).
// Si no está y se puede dar de alta (permiso proveedores.create), la ventana avisa de los que tienen
// un nombre parecido antes de crearlo (lo comprueba el servidor: /proveedores/alta).
import Icon from './Icon.astro';
import { can } from '../lib/app.js';

const { options = [], types = [] } = Astro.props;
const canCreate = can(Astro.locals.user, 'proveedores.create');
---
<div data-picker-kit data-options={JSON.stringify(options)} data-can-create={canCreate ? '1' : '0'} hidden>
  <datalist id="supplier-names">{options.filter((o) => o.status !== 'bloqueado').map((o) => <option value={o.name} />)}</datalist>
</div>
<ul class="picker-pop" role="listbox" id="supplier-listbox" aria-label="Proveedores" data-picker-pop hidden></ul>
<p class="visually-hidden" aria-live="polite" data-picker-status></p>

{canCreate && (
  <dialog class="confirm-dialog picker-dialog" aria-labelledby="sp-new-title" data-picker-dialog>
    <form data-picker-new novalidate>
      <h2 id="sp-new-title"><Icon name="briefcase" /> Dar de alta un proveedor</h2>
      <p class="muted small">Sólo si no está en la lista. El resto de datos (contacto, condiciones…) se completan en su ficha.</p>
      <div class="field">
        <label for="sp-new-name">Nombre del proveedor</label>
        <input id="sp-new-name" name="name" type="text" maxlength="120" required autocomplete="off" />
      </div>
      <div class="row row-2">
        <div class="field">
          <label for="sp-new-type">Tipo</label>
          <select id="sp-new-type" name="type_id">
            <option value="">Sin tipo</option>
            {types.map((t) => <option value={t.id}>{t.name}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="sp-new-city">Ciudad <span class="opt">(opcional)</span></label>
          <input id="sp-new-city" name="city" type="text" maxlength="80" autocomplete="off" />
        </div>
      </div>
      <div class="picker-similar" data-picker-similar hidden>
        <p><Icon name="triangle-alert" size={18} /> Ya hay proveedores con un nombre parecido. ¿Es alguno de estos?</p>
        <ul data-picker-similar-list></ul>
      </div>
      <p class="field-error" role="alert" data-picker-error hidden></p>
      <div class="confirm-actions">
        <button class="btn btn-ghost" type="button" data-picker-cancel>Cancelar</button>
        <button class="btn btn-primary" type="submit" data-picker-save>Dar de alta</button>
      </div>
    </form>
  </dialog>
)}

<script>
  import { fold, matchesQuery } from '../lib/supplier-match.js';

  const kit = document.querySelector('[data-picker-kit]');
  const pop = document.querySelector('[data-picker-pop]');
  if (kit instanceof HTMLElement && pop instanceof HTMLUListElement) {
    /** @type {{ id: number, name: string, status: string, type: string|null, city: string|null, aliases: string[] }[]} */
    const options = JSON.parse(kit.dataset.options || '[]');
    const canCreate = kit.dataset.canCreate === '1';
    const byId = new Map(options.map((o) => [String(o.id), o]));
    const status = document.querySelector('[data-picker-status]');
    const dialog = document.querySelector('[data-picker-dialog]');
    document.body.append(pop);
    if (dialog) document.body.append(dialog);

    const clean = (s) => String(s ?? '').trim().replace(/\s+/g, ' ');
    const hiddenOf = (input) => input.closest('[data-supplier-picker]')?.querySelector('[data-picker-id]');
    const meta = (o) => [o.type, o.city].filter(Boolean).join(' · ');
    // El mismo nombre (o uno anterior) escrito con otros acentos o mayúsculas
    const exact = (text) => {
      const f = fold(text);
      const hits = options.filter((o) => fold(o.name) === f || o.aliases.some((a) => fold(a) === f));
      return hits.length === 1 ? hits[0] : null;
    };

    // Sin JavaScript sirve el datalist; con él, el desplegable propio
    document.querySelectorAll('[data-picker-input]').forEach((i) => i.removeAttribute('list'));

    /** Comprueba el campo: un proveedor de la lista, que se pueda contratar (o ninguno, si está vacío) */
    const check = (input) => {
      const hidden = hiddenOf(input);
      if (!(hidden instanceof HTMLInputElement)) return null;
      const text = clean(input.value);
      let o = byId.get(hidden.value) ?? null;
      if (o && o.name !== text) o = null;
      if (!o && text) o = exact(text);
      hidden.value = o ? String(o.id) : '';
      let message = '';
      if (text && !o) {
        message = `«${text}» no está en la lista de proveedores: elígelo de la lista${canCreate ? ' o dalo de alta' : ''}.`;
      } else if (o && o.status === 'bloqueado' && input.closest('[data-supplier-picker]')?.dataset.keepId !== String(o.id)) {
        message = `${o.name} está marcado como «No contratar»: elige otro.`;
      }
      input.setCustomValidity(message);
      return o;
    };
    const choose = (input, o) => {
      input.value = o.name;
      check(input);
      input.dispatchEvent(new Event('change', { bubbles: true }));
    };

    let active = null;
    let cursor = -1;
    const items = () => [...pop.querySelectorAll('li[role="option"]:not([aria-disabled="true"])')];
    const close = () => {
      pop.hidden = true;
      cursor = -1;
      if (active) {
        active.setAttribute('aria-expanded', 'false');
        active.removeAttribute('aria-activedescendant');
      }
    };
    // Hasta dónde puede bajar la lista (en el móvil, sin meterse debajo de la barra inferior)
    const bottomLimit = () => {
      const bar = document.querySelector('.a-tabbar');
      const top = bar instanceof HTMLElement && getComputedStyle(bar).display !== 'none' ? bar.getBoundingClientRect().top : window.innerHeight;
      return Math.min(top, window.innerHeight) - 8;
    };
    const place = () => {
      if (!active || pop.hidden) return;
      const r = active.getBoundingClientRect();
      const width = Math.min(Math.max(r.width, 300), window.innerWidth - 16);
      pop.style.width = `${width}px`;
      pop.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - width - 8)) + window.scrollX}px`;
      pop.style.top = `${r.bottom + window.scrollY + 4}px`;
      pop.style.maxHeight = `${Math.max(120, Math.min(320, bottomLimit() - r.bottom - 4))}px`;
    };
    const li = (cls, children) => {
      const el = document.createElement('li');
      el.className = cls;
      el.append(...children);
      return el;
    };
    const span = (cls, text) => {
      const el = document.createElement('span');
      el.className = cls;
      el.textContent = text;
      return el;
    };
    const render = (input) => {
      const q = clean(input.value);
      const f = fold(q);
      const hits = options.filter((o) => matchesQuery(o, q))
        .sort((a, b) => Number(fold(b.name).startsWith(f)) - Number(fold(a.name).startsWith(f)))
        .slice(0, 50);
      pop.replaceChildren();
      hits.forEach((o, i) => {
        const parts = [span('picker-name', o.name)];
        const alias = f && !fold(o.name).includes(f) ? o.aliases.find((a) => fold(a).includes(f)) : null;
        const extra = [meta(o), alias && `antes «${alias}»`].filter(Boolean).join(' · ');
        if (extra) parts.push(span('picker-meta', extra));
        if (o.status !== 'activo') parts.push(span(`pill ${o.status === 'bloqueado' ? 'pill-danger' : 'pill-muted'}`, o.status === 'bloqueado' ? 'No contratar' : 'Inactivo'));
        const el = li('', parts);
        el.id = `sp-opt-${i}`;
        el.setAttribute('role', 'option');
        el.dataset.id = String(o.id);
        if (o.status === 'bloqueado' && input.closest('[data-supplier-picker]')?.dataset.keepId !== String(o.id)) el.setAttribute('aria-disabled', 'true');
        pop.append(el);
      });
      if (q && !exact(q)) {
        if (canCreate) {
          const el = li('picker-create', [span('', `+ Dar de alta «${q}»`), span('picker-meta', hits.length ? 'Sólo si no es ninguno de los de arriba' : 'No está en la lista')]);
          el.setAttribute('role', 'option');
          el.id = 'sp-opt-new';
          el.dataset.create = '1';
          pop.append(el);
        } else {
          pop.append(li('picker-empty', [span('', hits.length ? 'Si no es ninguno de estos, pide que lo den de alta en Proveedores.' : `«${q}» no está en la lista. Pide que lo den de alta en Proveedores.`)]));
        }
      } else if (!hits.length) {
        pop.append(li('picker-empty', [span('', 'Todavía no hay proveedores dados de alta.')]));
      }
      cursor = -1;
      const opening = pop.hidden;
      pop.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      // Si el campo está muy abajo, se sube para que se vea la lista
      if (opening && bottomLimit() - input.getBoundingClientRect().bottom < 200) input.scrollIntoView({ block: 'center' });
      place();
    };
    const move = (step) => {
      const list = items();
      if (!list.length || !active) return;
      list[cursor]?.removeAttribute('aria-selected');
      cursor = (cursor + step + list.length) % list.length;
      list[cursor].setAttribute('aria-selected', 'true');
      list[cursor].scrollIntoView({ block: 'nearest' });
      active.setAttribute('aria-activedescendant', list[cursor].id);
    };
    const pick = (el) => {
      const input = active;
      if (!input) return;
      close();
      if (el.dataset.create) openNew(input, clean(input.value));
      else if (byId.has(el.dataset.id)) choose(input, byId.get(el.dataset.id));
    };

    document.querySelectorAll('[data-picker-input]').forEach((i) => {
      i.setAttribute('role', 'combobox');
      i.setAttribute('aria-autocomplete', 'list');
      i.setAttribute('aria-controls', 'supplier-listbox');
      i.setAttribute('aria-expanded', 'false');
      check(i);
    });
    // Delegado en el documento: también vale para las filas que se añaden después (pagos previstos)
    const isPicker = (t) => t instanceof HTMLInputElement && t.hasAttribute('data-picker-input');
    document.addEventListener('focusin', (e) => {
      if (!isPicker(e.target)) return;
      const input = e.target;
      input.setAttribute('role', 'combobox');
      input.setAttribute('aria-autocomplete', 'list');
      input.setAttribute('aria-controls', 'supplier-listbox');
      input.removeAttribute('list');
      if (active !== input) close();
      active = input;
    });
    document.addEventListener('input', (e) => {
      if (!isPicker(e.target)) return;
      active = e.target;
      check(e.target);
      if (clean(e.target.value)) render(e.target);
      else close();
    });
    document.addEventListener('keydown', (e) => {
      if (!isPicker(e.target)) return;
      active = e.target;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (pop.hidden) render(e.target);
        move(e.key === 'ArrowDown' ? 1 : -1);
      } else if (e.key === 'Enter' && !pop.hidden && cursor >= 0) {
        e.preventDefault();
        pick(items()[cursor]);
      } else if (e.key === 'Escape' && !pop.hidden) {
        e.preventDefault();
        close();
      }
    });
    document.addEventListener('focusout', (e) => {
      if (!isPicker(e.target)) return;
      const o = check(e.target);
      // Escrito igual que uno de la lista (otros acentos o mayúsculas, o un nombre anterior): su nombre
      if (o && e.target.value !== o.name) choose(e.target, o);
      close();
    });
    // Que el clic en la lista no quite el foco del campo antes de elegir
    pop.addEventListener('pointerdown', (e) => e.preventDefault());
    pop.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target.closest('li[role="option"]') : null;
      if (el instanceof HTMLElement && el.getAttribute('aria-disabled') !== 'true') pick(el);
    });
    window.addEventListener('scroll', place, true);
    window.addEventListener('resize', close);

    // ── Dar de alta ──────────────────────────────────────────────────────────────
    let target = null;
    let resetSimilar = () => {};
    function openNew(input, name) {
      target = input;
      if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== 'function') {
        window.open('/proveedores?nuevo', '_blank');
        return;
      }
      const form = dialog.querySelector('[data-picker-new]');
      form.reset();
      form.elements.namedItem('name').value = name;
      resetSimilar();
      dialog.showModal();
      form.elements.namedItem('type_id').focus();
    }
    if (dialog instanceof HTMLDialogElement) {
      const form = dialog.querySelector('[data-picker-new]');
      const similar = dialog.querySelector('[data-picker-similar]');
      const similarList = dialog.querySelector('[data-picker-similar-list]');
      const error = dialog.querySelector('[data-picker-error]');
      const save = dialog.querySelector('[data-picker-save]');
      let confirmed = false;
      resetSimilar = () => {
        confirmed = false;
        similar.hidden = true;
        error.hidden = true;
        save.textContent = 'Dar de alta';
      };
      const done = (o) => {
        if (!byId.has(String(o.id))) {
          options.push(o);
          byId.set(String(o.id), o);
        }
        dialog.close();
        if (target) {
          choose(target, o);
          target.focus();
        }
        if (status) status.textContent = `Proveedor elegido: ${o.name}`;
      };
      const fail = (text) => {
        error.textContent = text;
        error.hidden = false;
      };
      // Al cambiar el nombre se vuelve a comprobar si se parece a alguno
      form.elements.namedItem('name').addEventListener('input', resetSimilar);
      dialog.querySelector('[data-picker-cancel]').addEventListener('click', () => dialog.close());
      similarList.addEventListener('click', (e) => {
        const btn = e.target instanceof Element ? e.target.closest('[data-use]') : null;
        const o = btn ? byId.get(btn.getAttribute('data-use')) : null;
        if (o) done(o);
      });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = clean(form.elements.namedItem('name').value);
        if (name.length < 2) {
          fail('Nombre del proveedor: mínimo 2 caracteres');
          return;
        }
        const same = exact(name);
        if (same) {
          done(same);
          return;
        }
        const body = new FormData(form);
        if (confirmed) body.set('confirm', '1');
        save.disabled = true;
        error.hidden = true;
        try {
          const res = await fetch('/proveedores/alta', { method: 'POST', body, headers: { accept: 'application/json' } });
          const data = res.headers.get('content-type')?.includes('json') ? await res.json() : null;
          if (data?.ok) {
            done(data.supplier);
          } else if (data?.similar) {
            similarList.replaceChildren(...data.similar.map((o) => {
              const item = document.createElement('li');
              const text = document.createElement('span');
              const strong = document.createElement('strong');
              strong.textContent = o.name;
              text.append(strong);
              const extra = [o.type, o.city, o.via && `antes «${o.via}»`].filter(Boolean).join(' · ');
              if (extra) text.append(span('picker-meta', ` ${extra}`));
              item.append(text);
              if (o.status === 'bloqueado') {
                item.append(span('pill pill-danger', 'No contratar'));
              } else {
                if (!byId.has(String(o.id))) {
                  const full = { ...o, aliases: o.via ? [o.via] : [] };
                  options.push(full);
                  byId.set(String(o.id), full);
                }
                const use = document.createElement('button');
                use.type = 'button';
                use.className = 'btn btn-ghost btn-sm';
                use.dataset.use = String(o.id);
                use.textContent = 'Es este';
                item.append(use);
              }
              return item;
            }));
            similar.hidden = false;
            confirmed = true;
            save.textContent = 'No, es otro: darlo de alta';
          } else {
            fail(data?.error ?? 'No se ha podido dar de alta. Vuelve a intentarlo.');
          }
        } catch {
          fail('Sin conexión. Vuelve a intentarlo.');
        } finally {
          save.disabled = false;
        }
      });
    }
  }
</script>
