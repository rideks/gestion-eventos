---
// Importe sin IVA · tipo de IVA · importe con IVA.
// Se escribe uno de los dos importes y el otro se calcula solo; si se escriben los dos
// (copiados de la factura, con sus redondeos) se respetan tal cual.
import { VAT_OPTIONS, amountInput } from '../lib/money.js';

const {
  id = 'imp', base = null, total = null, vat = '21', errors = {}, required = true,
  labelBase = 'Importe sin IVA', labelTotal = 'Importe con IVA', hint = null,
} = Astro.props;
const value = (v) => (typeof v === 'string' ? v : amountInput(v));
---
<div class="row row-3" data-amounts>
  <div class:list={['field', { 'has-error': errors.base }]}>
    <label for={`${id}-base`}>{labelBase}</label>
    <input id={`${id}-base`} name="base" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" value={value(base)} data-base />
  </div>
  <div class="field">
    <label for={`${id}-vat`}>IVA</label>
    <select id={`${id}-vat`} name="vat" data-vat>
      {VAT_OPTIONS.map(([k, label]) => <option value={k} selected={String(vat) === k}>{label}</option>)}
    </select>
  </div>
  <div class:list={['field', { 'has-error': errors.total }]}>
    <label for={`${id}-total`}>{labelTotal}</label>
    <input id={`${id}-total`} name="total" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" value={value(total)} data-total />
  </div>
</div>
<p class="hint muted small">
  {hint ?? (required
    ? 'Escribe uno de los dos importes y el otro se calcula solo. En negativo para abonos o comisiones.'
    : 'Opcional. Escribe uno de los dos importes y el otro se calcula solo.')}
  {errors.base && <strong class="error"> {errors.base}</strong>}
</p>

<script>
  import { parseAmount, amountInput, totalFromBase, baseFromTotal } from '../lib/money.js';

  document.querySelectorAll('[data-amounts]').forEach((box) => {
    const base = box.querySelector('[data-base]');
    const total = box.querySelector('[data-total]');
    const vat = box.querySelector('[data-vat]');
    if (!(base instanceof HTMLInputElement) || !(total instanceof HTMLInputElement) || !(vat instanceof HTMLSelectElement)) return;

    // Un campo es "manual" si la persona lo ha escrito; los automáticos se pueden recalcular
    const manual = new Set();
    const fill = (from) => {
      if (vat.value === 'mixto') return;
      const target = from === base ? total : base;
      if (manual.has(target)) return;
      const v = parseAmount(from.value);
      if (v === null || Number.isNaN(v)) {
        target.value = '';
        return;
      }
      target.value = amountInput(from === base ? totalFromBase(v, vat.value) : baseFromTotal(v, vat.value));
    };
    for (const input of [base, total]) {
      input.addEventListener('input', () => {
        if (input.value.trim()) manual.add(input);
        else manual.delete(input);
        fill(input);
      });
    }
    vat.addEventListener('change', () => {
      // Se recalcula el que no se ha escrito a mano (si sólo hay uno escrito)
      if (manual.size !== 1) manual.clear();
      const source = manual.has(total) ? total : base;
      manual.clear();
      manual.add(source);
      fill(source);
    });
  });
</script>
